---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Critter from '../components/Critter.astro';
import Intro from '../components/Intro.astro';
import Story from '../components/Story.astro';
import { experience, education } from '../data/site';
---

<Base>
  <Intro />
  <div class="glow" aria-hidden="true"></div>
  <Nav />

  <!-- One set of sections, two ways to see them: Roam (a board you drag around, roam.ts)
       or Skim (the plain single scroll). Without JS it's always the scroll. -->
  <main data-stage>
    <div class="world" data-world>
      <Hero />
      <Story />
      <Timeline
        id="experience"
        n="02"
        label="Experience"
        title="Where I've <em>worked.</em>"
        entries={experience}
      />
      <Timeline
        id="education"
        n="03"
        label="Education"
        title="Where I've <em>studied.</em>"
        entries={education}
      />
      <Projects />
      <About />
      <Contact />

      <footer class="footer">
        <div class="foot-left">
          <span class="mono">© {new Date().getFullYear()}</span>
          <span class="sign">Kalash Jain</span>
          <span class="mono">Built in LA between coffee chats · <time data-clock>--:--</time></span>
        </div>
        <a class="mono top-link" href="#top">Back to top ↑</a>
      </footer>
    </div>
  </main>

  <!-- board controls (Roam mode only) -->
  <div class="roam-ui" aria-hidden="true">
    <p class="roam-hint mono" data-roam-hint>Drag to explore · scroll · pinch to zoom</p>
    <div class="minimap">
      <svg data-minimap></svg>
    </div>
  </div>
  <div class="roam-ui zoom" role="group" aria-label="Zoom">
    <button type="button" data-zoom="-1" aria-label="Zoom out">−</button>
    <span class="mono" data-zoom-label>100%</span>
    <button type="button" data-zoom="1" aria-label="Zoom in">+</button>
  </div>

  <Critter />
</Base>

<style>
  .glow {
    position: fixed;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    left: 50%;
    top: 45%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
    will-change: translate, scale;
    pointer-events: none;
    z-index: -1;
    animation: drift 28s ease-in-out infinite;
  }
  @keyframes drift {
    25% {
      translate: -42% -54%;
      scale: 1.08;
    }
    50% {
      translate: -50% -58%;
      scale: 1.14;
    }
    75% {
      translate: -58% -54%;
      scale: 1.08;
    }
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px var(--gutter) 36px;
    border-top: 1px solid var(--line);
  }
  .foot-left {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 22px;
  }
  .sign {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .top-link {
    text-decoration: none;
  }
  .top-link:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/motion';
  import '../scripts/roam';

  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    hour: 'numeric',
    minute: '2-digit',
  });
  const tick = () => clock && (clock.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 15_000);
</script>
