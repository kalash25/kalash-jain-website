---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';

// Placeholder sections so the jump links work; each gets built in its own step
const upcoming = [
  { id: 'work', n: '01', title: 'Work' },
  { id: 'experience', n: '02', title: 'Experience' },
  { id: 'about', n: '03', title: 'About' },
  { id: 'contact', n: '04', title: 'Contact' },
];
---

<Base>
  <div class="glow" aria-hidden="true"></div>
  <Nav />

  <main>
    <Hero />

    {
      upcoming.map((s) => (
        <section id={s.id} class="stub" aria-labelledby={`${s.id}-h`}>
          <p class="mono">
            Track {s.n} / {s.title}
          </p>
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          <p class="soon">Coming in the next step.</p>
        </section>
      ))
    }
  </main>

  <footer class="footer">
    <span class="mono">© {new Date().getFullYear()} Kalash Jain</span>
    <span class="mono">Los Angeles · <time data-clock>--:--</time></span>
    <a class="mono top-link" href="#top">Back to top ↑</a>
  </footer>
</Base>

<style>
  .glow {
    position: fixed;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    left: 62%;
    top: 40%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
    animation: drift 18s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      translate: -70% -45%;
      scale: 1.15;
    }
  }

  .stub {
    max-width: 1320px;
    margin: 0 auto;
    padding: 96px var(--gutter);
    min-height: 60vh;
    border-top: 1px solid var(--line);
  }
  .stub h2 {
    margin: 12px 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .soon {
    color: var(--muted);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px var(--gutter) 36px;
    border-top: 1px solid var(--line);
  }
  .top-link {
    text-decoration: none;
  }
  .top-link:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    hour: 'numeric',
    minute: '2-digit',
  });
  const tick = () => clock && (clock.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 15_000);
</script>
