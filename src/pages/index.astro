---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Hits from '../components/Hits.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <div class="glow" aria-hidden="true"></div>
  <Nav />

  <main>
    <Hero />
    <Hits />
    <Experience />
    <Projects />
    <About />
    <Contact />
  </main>

  <footer class="footer">
    <span class="sign">Kalash Jain</span>
    <span class="mono">Designed & built in Los Angeles · <time data-clock>--:--</time></span>
    <span class="mono">© {new Date().getFullYear()}</span>
    <a class="mono top-link" href="#top">Back to top ↑</a>
  </footer>
</Base>

<style>
  .glow {
    position: fixed;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    left: 62%;
    top: 40%;
    translate: -50% -50%;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
    animation: drift 18s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      translate: -70% -45%;
      scale: 1.15;
    }
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 28px var(--gutter) 36px;
    border-top: 1px solid var(--line);
  }
  .sign {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .top-link {
    text-decoration: none;
  }
  .top-link:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/motion';

  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    hour: 'numeric',
    minute: '2-digit',
  });
  const tick = () => clock && (clock.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 15_000);
</script>
