</style>

<script>
  import { links } from '../../data/site';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const say = (detail: string) => dispatchEvent(new CustomEvent('toast', { detail }));

  /* 1. Name "decrypts" into place */
  const nameEl = document.querySelector<HTMLElement>('[data-scramble]')!;
  const finalName = nameEl.textContent ?? '';
  if (!reduce) {
    const glyphs = '!<>-_\\/[]{}=+*^?#01';
    let frame = 0;
    const end = 8 + finalName.length * 3;
    // timer-based (not rAF) so it can never get stuck half-scrambled in a background tab
    const iv = setInterval(() => {
      frame++;
      nameEl.textContent = [...finalName]
        .map((ch, i) => (ch === ' ' || frame > 8 + i * 3 ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (frame >= end) {
        clearInterval(iv);
        nameEl.textContent = finalName;
      }
    }, 40);
    setTimeout(() => {
      clearInterval(iv);
      nameEl.textContent = finalName;
    }, 3000);
  }

  /* 2. The waveform, drawn in block characters */
  const waveEl = document.querySelector<HTMLElement>('[data-wave]')!;
  const blocks = '▁▂▃▄▅▆▇█';
  const W = 48;
  let t = 0;
  const drawWave = () => {
    let s = '';
    for (let i = 0; i < W; i++) {
      const x = i / W;
      const env = Math.pow(Math.sin(Math.PI * x), 1.2);
      const v = Math.abs(Math.sin(x * 18 + t) * 0.6 + Math.sin(x * 41 - t * 1.4) * 0.4) * env;
      s += blocks[Math.max(0, Math.min(7, Math.round(v * 7)))];
    }
    waveEl.textContent = s;
  };
  drawWave();
  if (!reduce) setInterval(() => ((t += 0.18), drawWave()), 90);

  /* 3. Photo starts as ASCII and resolves into the real thing */
  const wrap = document.querySelector<HTMLElement>('[data-ascii-wrap]')!;
  const img = wrap.querySelector('img')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii]')!;
  function renderAscii() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(2, devicePixelRatio || 1);
    canvas.width = r.width * dpr;
    canvas.height = r.height * dpr;
    const ctx = canvas.getContext('2d')!;
    const cols = 52;
    const cw = canvas.width / cols;
    const ch = cw * 1.65;
    const rows = Math.floor(canvas.height / ch);
    const off = document.createElement('canvas');
    off.width = cols;
    off.height = rows;
    const o = off.getContext('2d')!;
    // cover-fit the photo into the grid, like the <img> does
    const ar = img.naturalWidth / img.naturalHeight;
    const gar = (cols * cw) / (rows * ch);
    let sw = img.naturalWidth, sh = img.naturalHeight, sx = 0, sy = 0;
    if (ar > gar) { sw = sh * gar; sx = (img.naturalWidth - sw) / 2; } else { sh = sw / gar; sy = (img.naturalHeight - sh) * 0.3; }
    o.drawImage(img, sx, sy, sw, sh, 0, 0, cols, rows);
    const data = o.getImageData(0, 0, cols, rows).data;
    const ramp = ' .:-=+*#%@';
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.font = `${ch * 0.92}px "Martian Mono Variable", monospace`;
    ctx.textBaseline = 'top';
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const i = (y * cols + x) * 4;
        const lum = (0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]) / 255;
        const c = ramp[Math.min(ramp.length - 1, Math.floor(Math.pow(lum, 0.8) * ramp.length))];
        if (c === ' ') continue;
        ctx.fillStyle = `oklch(${0.45 + lum * 0.5} 0.14 285)`;
        ctx.fillText(c, x * cw, y * ch);
      }
    }
  }
  const startAscii = () => {
    renderAscii();
    setTimeout(() => wrap.classList.add('resolved'), reduce ? 0 : 1800);
  };
  Promise.all([img.decode().catch(() => {}), document.fonts.ready]).then(startAscii);
  addEventListener('resize', () => img.complete && renderAscii());

  /* 4. A real (tiny) terminal */
  const out = document.querySelector<HTMLElement>('[data-out]')!;
  const form = document.querySelector<HTMLFormElement>('[data-prompt]')!;
  const cli = document.querySelector<HTMLInputElement>('[data-cli]')!;
  const print = (cmd: string, text: string) => {
    const p = document.createElement('div');
    p.innerHTML = `<span class="echo"><b>%</b> ${cmd.replace(/</g, '&lt;')}</span>\n${text}\n`;
    out.appendChild(p);
    while (out.children.length > 4) out.firstElementChild?.remove();
  };
  const commands: Record<string, () => string> = {
    help: () => 'whoami · resume · hire · ls · poem · coffee · sudo hire kalash · clear · exit',
    whoami: () => "Kalash Jain. Product thinker, ex-JPMorgan engineer, UCLA Anderson MBA '28.",
    ls: () => 'experience.log  pull-requests/  contact.sh  resume.pdf  secrets.txt',
    'cat secrets.txt': () => 'cat: secrets.txt: nice try.',
    resume: () => {
      setTimeout(() => window.open(links.resume, '_blank'), 400);
      return 'opening resume.pdf … one page, ruthlessly prioritized.';
    },
    hire: () => {
      setTimeout(() => (location.href = `mailto:${links.email}?subject=Let's%20talk`), 700);
      return 'Excellent judgment. Drafting an email …';
    },
    'sudo hire kalash': () => 'Permission granted. ✓  (now type: hire)',
    poem: () => "I don't pipe poetry through stdout. Ask me in person.",
    coffee: () => "418: I'm a teapot.",
    exit: () => "You can't exit a portfolio. Scroll down instead ↓",
    'rm -rf /': () => 'absolutely not.',
    music: () => '♪ now playing: the sound of a build passing',
  };
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw = cli.value.trim();
    const cmd = raw.toLowerCase();
    cli.value = '';
    if (!cmd) return;
    if (cmd === 'clear') {
      out.innerHTML = '';
      return;
    }
    const fn = commands[cmd] ?? (cmd.startsWith('sudo') ? () => 'Nice try. This incident will be reported to… actually, no. Hi.' : null);
    print(raw, fn ? fn() : `zsh: command not found: ${raw}. try 'help'`);
  });

  /* 5. copy email */
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    try {
      await navigator.clipboard.writeText((e.currentTarget as HTMLElement).dataset.copy!);
      say('copied to clipboard. pbpaste whenever you are ready.');
    } catch {
      say('could not copy. the address is right there ↑');
    }
  });
</script>
