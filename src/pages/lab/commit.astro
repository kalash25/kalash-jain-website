  }
  .node {
    position: absolute;
    left: -31px;
    top: 13px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--violet);
  }
  .commit.branch .node {
    left: -53px;
    background: var(--violet);
  }
  details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding: 4px 8px;
    margin-left: -8px;
    border-radius: 6px;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  .commit.expandable summary:hover {
    background: var(--panel);
  }
  .hash {
    color: var(--violet);
    font-size: 0.82rem;
  }
  .ref {
    color: #f4d58d;
    font-size: 0.78rem;
  }
  .type {
    color: var(--muted);
  }
  .msg {
    font-weight: 600;
  }
  .date {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .commit.expandable .msg::after {
    content: ' +';
    color: var(--violet);
  }
  details[open] .msg::after {
    content: ' −';
  }
  .body {
    margin: 6px 0 10px;
    padding: 12px 16px;
    border-left: 2px solid var(--line);
    color: #c4c1d4;
    font-size: 0.95rem;
  }
  .body-h {
    margin: 0 0 6px;
    color: var(--violet);
    font-size: 0.75rem;
  }
  .body ul {
    margin: 0;
    padding-left: 18px;
  }
  .body li {
    padding: 3px 0;
  }
  .blame {
    position: absolute;
    right: 0;
    top: -16px;
    font-size: 0.68rem;
    color: var(--violet);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 5px;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity 0.2s,
      translate 0.2s;
