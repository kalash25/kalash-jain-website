    text-decoration: underline;
  }
  .out {
    margin-top: 18px;
    font-size: 0.8rem;
    color: #c4c1d4;
    white-space: pre-wrap;
  }
  .out :global(.echo) {
    color: var(--muted);
  }
  .out :global(.echo b) {
    color: var(--violet);
    font-weight: 400;
  }
  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    font-size: 0.82rem;
  }
  .prompt:focus-within {
    border-color: var(--violet);
  }
  .prompt input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--ink);
