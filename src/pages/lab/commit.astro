    padding: 14px 18px 16px;
    color: #c4c1d4;
  }
  .pr-body b {
    color: var(--ink);
  }
  .diff {
    display: grid;
    margin: 12px 0;
    padding: 10px 14px;
    background: #000;
    border-radius: 6px;
    font-size: 0.8rem;
    white-space: pre-wrap;
    line-height: 1.7;
  }
  .minus {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: #ff8b8b88;
  }
  .plus {
    color: var(--violet);
  }
