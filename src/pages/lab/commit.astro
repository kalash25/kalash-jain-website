---
import '@fontsource-variable/martian-mono/standard.css';
import '@fontsource-variable/recursive/full.css';
import { Picture } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import Roamer from '../../components/lab/Roamer.astro';
import portrait from '../../assets/portrait-dark.webp';
import { links, experience, education, projects } from '../../data/site';

const jp = experience[0];
const [g1, g2, g3] = jp.groups!;
const ucla = education[0];
const pec = education[1];

type Commit = {
  hash: string;
  ref?: string;
  type: string;
  msg: string;
  date: string;
  blame: string;
  body?: { heading: string; points: string[] };
  branch?: boolean;
};
const commits: Commit[] = [
  { hash: 'a91f2c4', ref: 'HEAD -> mba', type: 'chore', msg: "relocate to Los Angeles · UCLA Anderson MBA '28", date: '2026', blame: 'blame: wanting to decide what gets built', branch: true },
  { hash: '7c0d118', ref: 'tag: sde-2', type: 'feat', msg: 'promoted to Software Development Engineer II', date: 'Jan 2026', blame: 'blame: shipping the boring stuff reliably', body: g1 },
  { hash: '5be9120', type: 'feat(adoption)', msg: 'onboarded 10+ business lines onto the test platform', date: '2024–25', blame: 'blame: a lot of patient demos', body: g2 },
  { hash: '41aa3d9', type: 'feat(infra)', msg: 'owned migration of ~800 data feeds to AWS', date: '2024–25', blame: 'blame: spreadsheets. so many spreadsheets.', body: g3 },
  { hash: '3e8b40f', ref: 'tag: sde-1', type: 'feat', msg: 'joined full-time · Software Development Engineer I', date: 'Aug 2023', blame: 'blame: the internship went well' },
  { hash: '2d01c7a', type: 'merge', msg: `B.Tech Computer Science · ${pec.org}`, date: 'May 2023', blame: 'blame: four years of caffeine' },
  { hash: '19aa07e', type: 'init', msg: 'software engineer intern @ JPMorgan Chase', date: 'Jan 2022', blame: 'blame: an email I almost didn’t send' },
];

const prs = [
  {
    n: 14,
    p: projects[0],
    labels: ['ai-agents', 'recruiting', 'claude-code'],
    minus: '~1 hr of research per company, scattered spreadsheets',
    plus: '~90 s per brief, one kanban pipeline',
    checks: 'reviewed by: me · approved by: also me',
  },
  {
    n: 9,
    p: projects[1],
    labels: ['ai', 'journaling', 'telegram'],
    minus: 'nightly notes that went nowhere',
    plus: 'tracked decisions + weekly reviews scored against goals',
    checks: '✓ 63 unit tests · ✓ 2 evals',
  },
];
---

<Lab title="Commit · Kalash Jain (lab)">
  <header class="bar">
    <a href="/lab" class="repo">← lab · <b>~/kalash-jain</b> <span class="branch">(main ✓)</span></a>
    <nav>
      <a href="#log">experience.log</a>
      <a href="#prs">pull-requests</a>
      <a href="#contact">contact.sh</a>
    </nav>
  </header>

  <main>
    <!-- HERO: a terminal that renders the page -->
    <section class="hero">
      <div class="term" data-term>
        <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd" data-type="whoami">whoami</span></p>
        <h1 class="name" data-scramble aria-label="Kalash Jain">KALASH JAIN</h1>
        <p class="wave" aria-hidden="true" data-wave>▁▂▃▄▅▆▇▆▅▄▃▂▁▂▃▄▅▆▅▄▃▂▁</p>

        <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">cat role.txt</span></p>
        <p class="role">Product thinker with an engineer's toolkit.</p>

        <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">cat about.txt</span></p>
        <p class="about">
          3 yrs software engineer @ JPMorgan Chase: testing + automation for trading desks, and getting
          the humans to actually adopt it. Now UCLA Anderson MBA '28, recruiting for Summer '27 PM
          internships in tech, media &amp; creative tools. Also: published poet, musician.
        </p>

        <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">ls links/</span></p>
        <p class="ls">
          <a href={links.resume} download>resume.pdf</a>
          <a href={links.linkedin} target="_blank" rel="noopener">linkedin@</a>
          <a href={links.github} target="_blank" rel="noopener">github@</a>
          <a href={`mailto:${links.email}`}>email*</a>
        </p>

        <div class="out" data-out aria-live="polite"></div>
        <form class="prompt" data-prompt>
          <label class="ps" for="cli">kalash@la ~ %</label>
          <input id="cli" autocomplete="off" spellcheck="false" placeholder="type 'help' and press enter" data-cli />
        </form>
      </div>

      <figure class="ascii" data-ascii-wrap>
        <Picture src={portrait} formats={['webp']} widths={[480]} sizes="380px" alt="Kalash Jain" loading="eager" data-ascii-img />
        <canvas data-ascii aria-hidden="true"></canvas>
        <figcaption>hover to view source</figcaption>
      </figure>
    </section>

    <!-- EXPERIENCE: git log -->
    <section id="log" class="log">
      <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">git log --graph --oneline career</span></p>
      <ol class="commits">
        {
          commits.map((c, i) => (
            <li class:list={['commit', { branch: c.branch, expandable: !!c.body }]} data-blame={c.blame}>
              <span class="node" aria-hidden="true" />
              <details open={i === 1}>
                <summary>
                  <span class="hash">{c.hash}</span>
                  {c.ref && <span class="ref">({c.ref})</span>}
                  <span class="type">{c.type}:</span> <span class="msg">{c.msg}</span>
                  <span class="date">{c.date}</span>
                </summary>
                {c.body && (
                  <div class="body">
                    <p class="body-h">## {c.body.heading}</p>
                    <ul>
                      {c.body.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </details>
              <span class="blame" aria-hidden="true">{c.blame}</span>
            </li>
          ))
        }
      </ol>
      <p class="hint">↑ click a commit to read its body · hover for git blame</p>
      <p class="also">also on <b>mba</b>: {ucla.summary} {ucla.points[0]}.</p>
    </section>

    <!-- PROJECTS: pull requests -->
    <section id="prs" class="prs">
      <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">gh pr list --author kalash --state merged</span></p>
      {
        prs.map(({ n, p, labels, minus, plus, checks }) => (
          <article class="pr">
            <header>
              <span class="merged">⇋ Merged</span>
              <h3>
                {p.name}: {p.kind.toLowerCase()} <span class="num">#{n}</span>
              </h3>
              <p class="labels">
                {labels.map((l) => (
                  <span>{l}</span>
                ))}
              </p>
            </header>
            <div class="pr-body">
              <p>
                <b>Problem.</b> {p.problem}
              </p>
              <p>
                <b>What I built.</b> {p.built}
              </p>
              <div class="diff" role="group" aria-label="Before and after">
                <span class="minus">- {minus}</span>
                <span class="plus">+ {plus}</span>
              </div>
              <p class="checks">{checks}</p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact">
      <p class="line"><span class="ps">kalash@la ~ %</span> <span class="cmd">./contact.sh</span></p>
      <h2 class="talk">Let's talk.</h2>
      <p class="about">&gt; Open to Summer '27 PM internships. Replies faster than CI.</p>
      <p class="email"><a href={`mailto:${links.email}`}>{links.email}</a></p>
      <p class="ls">
        <button type="button" data-copy={links.email}>[ copy email ]</button>
        <a href={links.linkedin} target="_blank" rel="noopener">[ linkedin ]</a>
        <a href={links.github} target="_blank" rel="noopener">[ github ]</a>
        <a href={links.resume} download>[ resume.pdf ]</a>
      </p>
    </section>

    <footer class="foot">
      <span>exit code 0</span>
      <span>© 2026 Kalash Jain · built in LA between coffee chats</span>
    </footer>
  </main>

  <Roamer />
</Lab>

<style>
  :global(body) {
    --bg: #0a0a0e;
    --panel: #111118;
    --ink: #e9e7f2;
    --muted: #8d89a0;
    --line: #23222d;
    --violet: oklch(0.72 0.16 285);
    background: var(--bg);
    color: var(--ink);
    font-family: 'Recursive Variable', ui-sans-serif, system-ui;
    font-variation-settings: 'MONO' 0, 'CASL' 0;
    line-height: 1.6;
  }
  a {
    color: inherit;
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    font-family: 'Martian Mono Variable', monospace;
    font-size: 0.72rem;
  }
  .repo {
    text-decoration: none;
    color: var(--muted);
  }
  .repo b {
    color: var(--ink);
    font-weight: 500;
  }
  .branch {
    color: var(--violet);
  }
  nav {
    display: flex;
    gap: 20px;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--violet);
  }
  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .line,
  .ps,
  .cmd,
  .ls,
  .wave,
  .out,
  .prompt input,
  .hash,
  .ref,
  .date,
  .hint,
  .blame,
  .checks,
  .labels,
  .diff,
  .foot,
  .body-h {
    font-family: 'Martian Mono Variable', monospace;
  }
  .line {
    margin: 26px 0 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .ps {
    color: var(--violet);
  }
  .cmd {
    color: var(--ink);
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 48px;
    align-items: start;
    padding: 48px 0 80px;
  }
  .term {
    min-width: 0;
  }
  .name {
    margin: 4px 0 0;
    font-family: 'Martian Mono Variable', monospace;
    font-variation-settings: 'wdth' 112.5;
    font-weight: 800;
    font-size: clamp(1.8rem, 6.4vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .wave {
    margin: 10px 0 0;
    color: var(--violet);
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
  }
  .role {
    margin: 0;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 700;
    color: var(--violet);
    line-height: 1.2;
  }
  .about {
    margin: 0;
    max-width: 60ch;
    color: #c4c1d4;
  }
  .ls {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    font-size: 0.85rem;
  }
  .ls a,
  .ls button {
    color: var(--ink);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
