  .ascii {
    position: relative;
    margin: 30px 0 0;
    aspect-ratio: 4 / 5;
    background: #000;
    overflow: hidden;
  }
  .ascii :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .ascii canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.9s ease;
  }
  .ascii.resolved :global(img) {
    opacity: 1;
  }
  .ascii.resolved canvas {
    opacity: 0;
  }
  .ascii.resolved:hover canvas {
    opacity: 0.92;
  }
  .ascii figcaption {
    position: absolute;
    right: 10px;
    bottom: 8px;
    font-family: 'Martian Mono Variable', monospace;
    font-size: 0.62rem;
    color: var(--muted);
    background: #000a;
    padding: 2px 6px;
  }

  /* EXPERIENCE: commit graph */
  .log {
    padding: 40px 0 72px;
    border-top: 1px solid var(--line);
  }
  .commits {
    list-style: none;
    margin: 18px 0 0;
    padding: 0 0 0 34px;
    position: relative;
  }
  .commits::before {
