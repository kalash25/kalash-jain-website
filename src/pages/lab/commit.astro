    position: absolute;
    left: 9px;
    top: 14px;
    bottom: 14px;
    width: 2px;
    background: var(--violet);
    opacity: 0.6;
  }
  .commit {
    position: relative;
    padding: 6px 0;
  }
  .commit.branch {
    margin-left: 22px;
  }
  .commit.branch::before {
    content: '';
    position: absolute;
    left: -47px;
    top: 16px;
    width: 26px;
    height: 34px;
    border: 2px solid color-mix(in oklch, var(--violet) 60%, transparent);
    border-right: 0;
    border-bottom: 0;
    border-radius: 14px 0 0 0;
    rotate: 180deg;
