---
import '@fontsource-variable/recursive/full.css';
import { Picture } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import portrait from '../../assets/portrait-dark.webp';
import { links, experience, education } from '../../data/site';

const jp = experience[0];
const group = jp.groups![0];
// circle the first big number in the first bullet
const firstBullet = group.points[0].replace('10,000+', '<span class="circled" data-circle>10,000+</span>');

// Wave shape for the ink line's opening flourish (same maths as the live hero)
let wave = '';
for (let i = 0; i <= 120; i++) {
  const x = i / 120;
  const env = Math.pow(Math.sin(Math.PI * x), 1.4);
  const s = Math.sin(x * 38 + 1.2) * 0.5 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17 + 2) * 0.2;
  wave += `${i ? 'L' : 'M'}${(x * 600).toFixed(1)} ${(24 - s * env * 18).toFixed(1)}`;
}
---

<Lab title="Manuscript · Kalash Jain (lab)">
  <header class="top">
    <a class="file" href="/lab">← lab / <b>draft_v12.md</b></a>
    <nav>
      <a href="#work">work</a>
      <a href={links.resume} download>resume.pdf</a>
      <a href="#talk">say hi</a>
      <button class="track" type="button" aria-pressed="true" data-track>
        <span class="dot"></span> track changes
      </button>
    </nav>
  </header>

  <main class="sheet" data-sheet>
    <svg class="ink" data-ink aria-hidden="true"><path></path></svg>

    <!-- HERO -->
    <section class="hero" data-ink-hero>
      <div class="col" data-ink-col>
        <p class="meta">UCLA Anderson MBA '28 · ex-JPMorgan Chase · Los Angeles</p>
        <h1 class="name" aria-label="Kalash Jain"><span data-name aria-hidden="true">Kalash Jain</span><span class="caret" aria-hidden="true"></span></h1>
        <svg class="wave" viewBox="0 0 600 48" aria-hidden="true" data-ink-start>
          <path d={wave}></path>
        </svg>

        <p class="headline" data-headline>
          <del>Software engineer.</del>
          <ins>Product thinker with an engineer's toolkit.</ins>
        </p>

        <p class="lede">
          Three years building testing and automation tools at JPMorgan Chase, and getting the teams who
          used them on board. Now at UCLA Anderson, focused on product management in tech, media and
          creative tools. Off the clock: published poet, musician, builder of small apps with AI.
        </p>
        <p class="ctas">
          <a href="#work">Read the work ↓</a>
          <a href={`mailto:${links.email}`}>Email me →</a>
        </p>
      </div>

      <figure class="photo">
        <div class="pic">
          <Picture src={portrait} formats={['avif', 'webp']} widths={[360, 620]} sizes="340px" alt="Kalash Jain" loading="eager" />
          <svg class="frame" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 4 C30 1, 70 3, 97 2 C99 40, 98 85, 97 122 C65 124, 30 123, 2 121 C1 85, 3 40, 4 6"></path>
          </svg>
        </div>
        <figcaption class="note">↖ that's me. the glasses are load-bearing.</figcaption>
      </figure>

      <aside class="note margin-note hl-note">
        Still an engineer. I just moved from "how do we build it?" to "should we?"
      </aside>
    </section>

    <!-- WORK -->
    <section id="work" class="work">
      <h2 class="hand" data-ink-anchor>Where I've worked</h2>
      <div class="entry">
        <h3>{jp.org} <span class="place">· {jp.place}</span></h3>
        <ol class="roles">
          {
            jp.roles!.map((r, i) => (
              <li>
                <span class="date">{r.dates}</span>
                <span class:list={['role', { now: i === 0 }]}>{r.title}</span>
              </li>
            ))
          }
        </ol>

        <h4>{group.heading}</h4>
        <ul class="points">
          <li>
            <span set:html={firstBullet} />
            <aside class="note margin-note">the number I'm proudest of. also the hardest meeting.</aside>
          </li>
          <li>
            {group.points[1]}
            <aside class="note margin-note">PM brain switched on here. Five tools → one.</aside>
          </li>
          {group.points.slice(2).map((p) => <li>{p}</li>)}
        </ul>
        <p class="more"><a href={links.resume} download>Two more sections on the resume →</a></p>
      </div>

      <h2 class="hand small" data-ink-anchor>Where I've studied</h2>
      <ul class="edu">
        {
          education.map((e) => (
            <li>
              <b>{e.org}</b> · {e.summary} <span class="date">{e.when}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- CONTACT -->
    <section id="talk" class="talk">
      <h2 class="big-hand" data-ink-end>Let's talk.</h2>
      <p class="lede">Open to Summer '27 PM internships, and always up for a chat about products, writing or the pivot.</p>
      <p class="email"><a href={`mailto:${links.email}`}>{links.email}</a></p>
      <p class="ctas">
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={links.resume} download>Resume ↓</a>
      </p>
      <aside class="note margin-note">yes, I reply. usually faster than my code reviews.</aside>
    </section>

    <footer class="foot">
      <span>Set in Recursive. Edited more times than I'd like to admit.</span>
      <span>© 2026 Kalash Jain</span>
    </footer>
  </main>
</Lab>

<style>
  :global(body) {
    --paper: #f3efe6;
    --ink: #17141d;
    --muted: #6b6573;
    --pen: #5b3fd9;
    --rule: #ddd6c8;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Recursive Variable', ui-sans-serif, system-ui;
    font-variation-settings: 'MONO' 0, 'CASL' 0;
    line-height: 1.6;
  }
  a {
    color: inherit;
  }

  /* top bar */
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px clamp(16px, 4vw, 48px);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
    font-variation-settings: 'MONO' 1;
    font-size: 0.78rem;
  }
  .file {
    text-decoration: none;
    color: var(--muted);
  }
  .file b {
    color: var(--ink);
    font-weight: 600;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    color: var(--pen);
  }
  .track {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--pen);
    cursor: pointer;
  }
  .track .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--pen);
    background: var(--pen);
  }
  .track[aria-pressed='false'] {
    color: var(--muted);
  }
  .track[aria-pressed='false'] .dot {
    background: transparent;
    border-color: var(--muted);
  }

  /* the sheet: one writing column + a margin for notes, with a ruled margin line */
  .sheet {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px) 40px clamp(48px, 7vw, 96px);
  }
  .sheet::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(28px, 4.5vw, 64px);
    width: 1px;
    background: color-mix(in srgb, var(--pen) 35%, transparent);
  }
  .ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .ink path {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  section {
    position: relative;
    z-index: 1;
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px 56px;
    padding: clamp(48px, 8vw, 96px) 0 64px;
    align-items: start;
  }
  .meta {
    margin: 0;
    font-variation-settings: 'MONO' 1;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .name {
    margin: 14px 0 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.95;
    white-space: nowrap;
    letter-spacing: -0.02em;
    font-weight: 500;
    font-variation-settings: 'MONO' 1, 'CASL' 0, 'slnt' 0;
    transition:
      font-variation-settings 1.3s cubic-bezier(0.65, 0, 0.35, 1),
      font-weight 1.3s cubic-bezier(0.65, 0, 0.35, 1),
      letter-spacing 1.3s;
  }
  .name.morph {
    font-weight: 800;
    letter-spacing: -0.035em;
    font-variation-settings: 'MONO' 0, 'CASL' 1, 'slnt' -9;
  }
  .caret {
    display: inline-block;
    width: 0.08em;
    height: 0.85em;
    margin-left: 0.06em;
    background: var(--pen);
    vertical-align: -0.05em;
    animation: blink 0.9s steps(1) infinite;
  }
  .name.morph .caret {
    opacity: 0;
    transition: opacity 0.4s 0.6s;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .wave {
    display: block;
    width: min(100%, 560px);
    height: 44px;
    margin: 6px 0 28px;
    overflow: visible;
  }
  .wave path {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s;
  }
  :global(.drawn) .wave path {
    stroke-dashoffset: 0;
  }

  /* self-editing headline */
  .headline {
    margin: 0 0 22px;
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    line-height: 1.2;
    font-weight: 600;
  }
  .headline del {
    text-decoration: none;
    color: var(--muted);
    background: linear-gradient(var(--pen), var(--pen)) 0 58% / 0% 3px no-repeat;
    transition: background-size 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .headline ins {
    display: block;
    text-decoration: none;
    color: var(--pen);
    font-variation-settings: 'CASL' 1, 'slnt' -10, 'CRSV' 1;
    font-weight: 700;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.45s;
  }
  .headline.edited del {
    background-size: 100% 3px;
  }
  .headline.edited ins {
    clip-path: inset(0 0 0 0);
  }

  .lede {
    max-width: 58ch;
    color: #3b3542;
    font-size: 1.04rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    font-variation-settings: 'MONO' 1;
    font-size: 0.9rem;
  }
  .ctas a {
    text-decoration: none;
    background: linear-gradient(var(--pen), var(--pen)) 0 100% / 100% 2px no-repeat;
    padding-bottom: 3px;
    transition:
      background-size 0.35s,
      color 0.2s;
  }
  .ctas a:hover {
    color: var(--pen);
    background-size: 0% 2px;
  }

  .photo {
    margin: 28px 0 0;
  }
  .pic {
    position: relative;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.02);
  }
  .frame {
    position: absolute;
    inset: -12px;
    width: calc(100% + 24px);
    height: calc(100% + 24px);
    overflow: visible;
  }
  .frame path {
    fill: none;
    stroke: var(--pen);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1) 1.2s;
  }
  :global(.drawn) .frame path {
    stroke-dashoffset: 0;
  }

  /* pen notes */
  .note {
    font-variation-settings: 'CASL' 1, 'slnt' -12, 'CRSV' 1;
    font-weight: 500;
    color: var(--pen);
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .photo .note {
    margin-top: 18px;
  }
  .margin-note {
    position: absolute;
    right: -300px;
    width: 240px;
    top: 0;
    padding-left: 14px;
    border-left: 2px solid color-mix(in srgb, var(--pen) 40%, transparent);
    opacity: 0;
    translate: 8px 0;
    transition:
      opacity 0.5s,
      translate 0.5s;
  }
  .margin-note.in {
    opacity: 1;
    translate: 0 0;
  }
  .hl-note {
    position: static;
    grid-column: 2;
    width: auto;
  }

  /* WORK */
  .work {
    max-width: 760px;
    padding: 40px 0 72px;
  }
  .hand {
    margin: 0 0 24px;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1;
    font-weight: 800;
    font-variation-settings: 'CASL' 1, 'slnt' -9;
  }
  .hand.small {
    margin-top: 64px;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }
  h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    font-weight: 700;
  }
  .place {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .roles {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    font-variation-settings: 'MONO' 1;
    font-size: 0.86rem;
  }
  .roles li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .date {
    color: var(--muted);
  }
  .role.now::after {
    content: '  ← current-ish';
    color: var(--pen);
    font-variation-settings: 'MONO' 0, 'CASL' 1, 'slnt' -12;
  }
  h4 {
    margin: 0 0 8px;
    font-variation-settings: 'MONO' 1;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--pen);
    font-weight: 600;
  }
  .points {
    margin: 0;
    padding-left: 20px;
  }
  .points li {
    position: relative;
    padding: 6px 0;
  }
  .points li::marker {
    color: var(--pen);
  }
  /* the circled number arrives via set:html, so these styles must be global */
  :global(.circled) {
    position: relative;
    white-space: nowrap;
    font-weight: 700;
  }
  :global(.circled svg) {
    position: absolute;
    inset: -10px -12px;
    width: calc(100% + 24px);
    height: calc(100% + 20px);
    overflow: visible;
    pointer-events: none;
  }
  :global(.circled path) {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    transition: stroke-dashoffset 1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  :global(.circled.in path) {
    stroke-dashoffset: 0;
  }
  .more {
    font-variation-settings: 'MONO' 1;
    font-size: 0.85rem;
  }
  .more a {
    color: var(--pen);
  }
  .edu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu li {
    padding: 8px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .edu .date {
    font-variation-settings: 'MONO' 1;
    font-size: 0.8rem;
    margin-left: 8px;
  }

  /* CONTACT */
  .talk {
    max-width: 760px;
    padding: 40px 0 80px;
  }
  .big-hand {
    margin: 0 0 12px;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 1;
    font-weight: 800;
    font-variation-settings: 'CASL' 1, 'slnt' -10;
  }
  .email {
    font-size: clamp(1.3rem, 3.6vw, 2.2rem);
    font-weight: 700;
    margin: 18px 0 22px;
    overflow-wrap: anywhere;
  }
  .email a {
    text-decoration: none;
    background: linear-gradient(var(--pen), var(--pen)) 0 100% / 0% 3px no-repeat;
    transition: background-size 0.4s;
  }
  .email a:hover {
    background-size: 100% 3px;
  }
  .foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-variation-settings: 'MONO' 1;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* track changes off: a clean copy */
  :global(.clean) .headline del,
  :global(.clean) .note,
  :global(.clean .circled svg),
  :global(.clean) .role.now::after {
    display: none;
  }
  :global(.clean) .headline ins {
    color: var(--ink);
    font-variation-settings: 'CASL' 0;
  }

  /* mobile: notes sit inline under their item */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 300px;
      order: -1;
      margin: 8px 0 12px;
    }
    .hl-note {
      grid-column: 1;
    }
    .margin-note {
      position: static;
      display: block;
      width: auto;
      margin-top: 8px;
      opacity: 1;
      translate: 0;
    }
    .roles li {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .top .file b {
      display: none;
    }
    nav {
      gap: 12px;
    }
    nav a:first-child {
      display: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const nameEl = document.querySelector<HTMLElement>('[data-name]')!;
  const h1 = nameEl.parentElement!;
  const headline = document.querySelector<HTMLElement>('[data-headline]')!;
  const full = nameEl.textContent ?? '';

  /* 1. name types itself in mono, then morphs into handwriting; headline edits itself */
  function finishIntro() {
    nameEl.textContent = full;
    h1.classList.add('morph');
    root.classList.add('drawn');
    setTimeout(() => headline.classList.add('edited'), reduce ? 0 : 900);
    // the hero's pen note lands right after the rewrite
    setTimeout(() => document.querySelector('.hl-note')?.classList.add('in'), reduce ? 0 : 2200);
  }
  if (reduce) finishIntro();
  else {
    nameEl.textContent = '';
    let i = 0;
    const type = () => {
      nameEl.textContent = full.slice(0, ++i);
      if (i < full.length) setTimeout(type, 75 + Math.random() * 60);
      else setTimeout(finishIntro, 450);
    };
    setTimeout(type, 400);
  }

  /* 2. one continuous ink line: from the hero wave, down the page, ending under "Let's talk" */
  const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
  const svg = document.querySelector<SVGSVGElement>('[data-ink]')!;
  const path = svg.querySelector('path')!;
  let samples: { y: number; l: number }[] = [];
  let total = 0;

  function buildInk() {
    const s = sheet.getBoundingClientRect();
    const rel = (el: Element, fx: number, fy: number) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - s.left + r.width * fx, y: r.top - s.top + r.height * fy };
    };
    const start = document.querySelector('[data-ink-start]')!;
    const anchors = [...document.querySelectorAll('[data-ink-anchor]')];
    const end = document.querySelector('[data-ink-end]')!;
    const gutter = Math.max(18, parseFloat(getComputedStyle(sheet).paddingLeft) * 0.42);

    const a0 = rel(start, 1, 0.5);
    const col = document.querySelector('[data-ink-col]')!.getBoundingClientRect();
    const hero = document.querySelector('[data-ink-hero]')!.getBoundingClientRect();
    const gapX = col.right - s.left + 22;
    const heroBottom = hero.bottom - s.top;
    const pts = [a0];
    pts.push({ x: Math.max(a0.x + 20, gapX), y: a0.y + 30 });
    pts.push({ x: gapX, y: heroBottom - 60 });
    pts.push({ x: (gapX + gutter) / 2, y: heroBottom - 10 });
    pts.push({ x: gutter, y: heroBottom + 40 });
    for (const a of anchors) {
      const p = rel(a, 0, 0.5);
      pts.push({ x: gutter + 30, y: p.y - 70 });
      pts.push({ x: gutter, y: p.y });
      pts.push({ x: p.x - 14, y: p.y + 4 });
      pts.push({ x: gutter + 6, y: p.y + 90 });
    }
    const e = rel(end, 0, 1);
    const e2 = rel(end, 1, 1);
    pts.push({ x: gutter, y: e.y - 120 });
    pts.push({ x: e.x, y: e.y + 8 });
    pts.push({ x: e2.x + 30, y: e2.y + 2 });
    pts.push({ x: e2.x + 54, y: e2.y - 24 });

    // Catmull-Rom → smooth cubic Béziers, for a hand-drawn feel
    let d = `M${pts[0].x} ${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[Math.max(0, i - 1)];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[Math.min(pts.length - 1, i + 2)];
      const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
      const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
      d += ` C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }
    path.setAttribute('d', d);
    total = path.getTotalLength();
    path.style.strokeDasharray = `${total}`;
    samples = [];
    for (let l = 0; l <= total; l += 8) samples.push({ y: path.getPointAtLength(l).y, l });
    drawInk();
  }

  // The pen keeps pace with your reading: draw up to ~75% down the viewport
  function drawInk() {
    if (reduce) {
      path.style.strokeDashoffset = '0';
      return;
    }
    const target = scrollY + innerHeight * 0.75 - (sheet.getBoundingClientRect().top + scrollY);
    let len = 0;
    for (const s of samples) {
      if (s.y > target) break;
      len = s.l;
    }
    path.style.strokeDashoffset = `${total - len}`;
  }
  let raf = 0;
  addEventListener(
    'scroll',
    () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          drawInk();
        });
    },
    { passive: true },
  );
  addEventListener('resize', () => buildInk());
  document.fonts.ready.then(() => setTimeout(buildInk, reduce ? 0 : 1800));

  /* 3. hand-drawn circle around the big number, margin notes slide in as you read */
  const circ = document.querySelector<HTMLElement>('[data-circle]');
  if (circ) {
    circ.insertAdjacentHTML(
      'beforeend',
      '<svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path d="M8 22 C6 8, 40 3, 70 5 C95 7, 99 22, 88 31 C70 40, 25 39, 10 31 C3 26, 6 14, 22 9" vector-effect="non-scaling-stroke"/></svg>',
    );
  }
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -20% 0px' },
  );
  document.querySelectorAll('.margin-note:not(.hl-note), [data-circle]').forEach((el) => io.observe(el));

  /* 4. track changes toggle */
  const track = document.querySelector<HTMLButtonElement>('[data-track]')!;
  track.addEventListener('click', () => {
    const on = track.getAttribute('aria-pressed') !== 'true';
    track.setAttribute('aria-pressed', String(on));
    root.classList.toggle('clean', !on);
    dispatchEvent(
      new CustomEvent('toast', {
        detail: on ? 'Edits back on. Much more honest.' : 'Clean copy. Very corporate.',
      }),
    );
    requestAnimationFrame(buildInk);
  });
</script>
