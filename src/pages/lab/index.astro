---
import '@fontsource-variable/martian-mono/standard.css';
import Lab from '../../layouts/Lab.astro';

const protos = [
  {
    href: '/lab/manuscript',
    n: '01',
    name: 'Manuscript',
    lean: 'writer ↔ code',
    blurb:
      'Light paper, one violet ink line that draws itself down the page, a headline that edits itself, pen notes in the margin. Type morphs from code-mono to handwriting.',
  },
  {
    href: '/lab/commit',
    n: '02',
    name: 'Commit',
    lean: 'code → product',
    blurb:
      'A working terminal hero (try typing), an ASCII photo that resolves, experience as a commit graph, projects as pull requests. The critter roams the bottom of the screen.',
  },
  {
    href: '/lab/spec',
    n: '03',
    name: 'Spec',
    lean: 'product, code accents',
    blurb:
      'The whole site is a living PRD about you: status, changelog, decision log, roadmap, and witty reviewer comments you can resolve.',
  },
];
---

<Lab title="Redesign lab · Kalash Jain">
  <main>
    <p class="kicker">redesign lab · local only · not deployed</p>
    <h1>Three directions. Pick the bits you like.</h1>
    <p class="sub">
      Each prototype uses your real content but only covers the hero, a slice of experience, and
      contact. They're sketches to compare, not finished pages.
    </p>
    <ol>
      {
        protos.map((p) => (
          <li>
            <a href={p.href}>
              <span class="n">{p.n}</span>
              <span class="name">{p.name}</span>
              <span class="lean">{p.lean}</span>
              <span class="blurb">{p.blurb}</span>
              <span class="go">open →</span>
            </a>
          </li>
        ))
      }
    </ol>
    <a class="back" href="/">← current live design</a>
  </main>
</Lab>

<style>
  :global(body) {
    background: #0b0a10;
    color: #ecebf3;
    font-family: 'Martian Mono Variable', ui-monospace, monospace;
  }
  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 72px 20px;
  }
  .kicker {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #a99cf6;
  }
  h1 {
    font-variation-settings: 'wdth' 112;
    font-weight: 700;
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    line-height: 1.05;
    margin: 12px 0;
  }
  .sub {
    max-width: 60ch;
    color: #a6a3b8;
    font-size: 0.85rem;
    line-height: 1.7;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 40px 0;
    display: grid;
    gap: 14px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  li a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 6px 16px;
    padding: 22px;
    border: 1px solid #2a2836;
    border-radius: 14px;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  li a:hover {
    border-color: #a99cf6;
    background: #13111c;
  }
  .n {
    color: #a99cf6;
    grid-row: span 3;
  }
  .name {
    font-weight: 700;
    font-size: 1.2rem;
  }
  .lean {
    font-size: 0.72rem;
    color: #a99cf6;
    text-align: right;
  }
  .blurb {
    grid-column: 2 / 4;
    color: #a6a3b8;
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .go {
    grid-column: 2;
    font-size: 0.75rem;
  }
  .back {
    font-size: 0.75rem;
    color: #a6a3b8;
  }
</style>
