---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/martian-mono/standard.css';
import { Picture } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import portrait from '../../assets/portrait-dark.webp';
import { links, experience, education, skills } from '../../data/site';

const jp = experience[0];
const [ucla, pec] = education;

const toc = [
  ['tldr', 'TL;DR'],
  ['problem', 'Problem'],
  ['changelog', 'Changelog'],
  ['decisions', 'Decision log'],
  ['roadmap', 'Roadmap'],
  ['scope', 'Out of scope'],
  ['appendix', 'Appendix'],
];

const decisions = [
  ['Move from engineering to product', 'Wanted to decide what gets built, not just how.', 'Shipped'],
  ['UCLA Anderson MBA', 'Technology & AI Leadership, in the city where media gets made.', 'Shipped'],
  ['Focus: tech, media & creative tools', 'Where technical depth and taste both matter.', 'In progress'],
  ['Dark mode by default', 'Non-negotiable.', 'Locked'],
];

// waveform bars for the "audio summary" player
const bars = Array.from({ length: 64 }, (_, i) => {
  const x = i / 63;
  const env = Math.pow(Math.sin(Math.PI * x), 1.1);
  const s = Math.abs(Math.sin(x * 38 + 1.2) * 0.55 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17) * 0.15);
  return Math.max(0.12, s * env);
});
---

<Lab title="Spec · Kalash Jain (lab)">
  <div class="app">
    <aside class="outline" aria-label="Outline">
      <a class="back" href="/lab">← lab</a>
      <p class="ol-h">Outline</p>
      <ol>
        {
          toc.map(([id, label]) => (
            <li>
              <a href={`#${id}`} data-toc={id}>
                {label}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <main class="doc">
      <p class="crumbs">Recruiting / Summer '27 / <b>PRD-001</b></p>
      <h1 id="top" data-anchor="top">Kalash Jain</h1>
      <p class="subtitle">Product thinker with an engineer's toolkit.</p>

      <dl class="meta">
        <div><dt>Owner</dt><dd>Kalash Jain</dd></div>
        <div><dt>Status</dt><dd><span class="status"><span class="pulse"></span>Ready for review</span></dd></div>
        <div><dt>Version</dt><dd>v2.0 (MBA edition)</dd></div>
        <div><dt>Last edited</dt><dd data-edited>just now</dd></div>
        <div><dt>Reviewers</dt><dd>You (yes, you)</dd></div>
      </dl>

      <div class="player" data-player>
        <button type="button" class="play" aria-label="Play audio summary" data-play>▶</button>
        <div class="bars" aria-hidden="true">
          {bars.map((h) => <span style={`--h:${h.toFixed(3)}`} />)}
        </div>
        <span class="dur mono" data-time>0:12</span>
      </div>
      <p class="player-cap mono">Audio summary · auto-generated</p>

      <figure class="fig">
        <Picture src={portrait} formats={['avif', 'webp']} widths={[480, 760]} sizes="(max-width: 900px) 90vw, 620px" alt="Kalash Jain" loading="eager" />
        <figcaption>Fig. 1: The candidate, in a studio. Natural habitat: a whiteboard.</figcaption>
      </figure>

      <section id="tldr" data-anchor="tldr">
        <h2>1. TL;DR</h2>
        <ul>
          <li>Three years as a software engineer at <b>JPMorgan Chase</b>, building testing and automation platforms for trading desks, and getting the teams who used them on board.</li>
          <li>Now pivoting to product at <b>UCLA Anderson</b> (MBA '28).</li>
          <li>Recruiting for <b>Summer '27 PM internships</b> in tech, media and creative tools.</li>
          <li>Also: published poet, musician, builder of small apps with AI.</li>
        </ul>
      </section>

      <section id="problem" data-anchor="problem">
        <h2>2. Problem statement</h2>
        <p>
          Teams need product people who can talk to engineers <em>and</em> to humans, ideally in the same
          meeting. This candidate has spent years doing the first and is now formally trained in the second.
        </p>
      </section>

      <section id="changelog" data-anchor="changelog">
        <h2>3. Changelog</h2>
        <ol class="changelog">
          <li>
            <span class="ver mono">v2.0</span><span class="when mono">2026</span>
            <p><b>{ucla.org}.</b> {ucla.summary} {ucla.points.join(' · ')}.</p>
          </li>
          <li>
            <span class="ver mono">v1.2</span><span class="when mono">{jp.roles![0].dates}</span>
            <p><b>Promoted to {jp.roles![0].title}</b>, JPMorgan Chase.</p>
            <details>
              <summary class="mono">Release notes</summary>
              {
                jp.groups!.map((g) => (
                  <div class="notes">
                    <p class="notes-h mono">{g.heading}</p>
                    <ul>
                      {g.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </details>
          </li>
          <li>
            <span class="ver mono">v1.0</span><span class="when mono">{jp.roles![1].dates}</span>
            <p><b>Full-time GA:</b> {jp.roles![1].title}, JPMorgan Chase.</p>
          </li>
          <li>
            <span class="ver mono">v0.9</span><span class="when mono">{pec.when}</span>
            <p><b>{pec.org}.</b> {pec.summary} {pec.points[0]}.</p>
          </li>
          <li>
            <span class="ver mono">v0.1-beta</span><span class="when mono">{jp.roles![2].dates}</span>
            <p><b>{jp.roles![2].title}</b>, JPMorgan Chase. First production deploy.</p>
          </li>
        </ol>
      </section>

      <section id="decisions" data-anchor="decisions">
        <h2>4. Decision log</h2>
        <table>
          <thead><tr><th>Decision</th><th>Rationale</th><th>Status</th></tr></thead>
          <tbody>
            {
              decisions.map(([d, r, st]) => (
                <tr>
                  <td>{d}</td>
                  <td>{r}</td>
                  <td>
                    <span class:list={['chip', st.toLowerCase().replace(' ', '-')]}>{st}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section id="roadmap" data-anchor="roadmap">
        <h2>5. Roadmap</h2>
        <div class="road">
          <div><p class="lane mono">Now</p><p>MBA year one. Recruiting. Building small AI tools on the side.</p></div>
          <div><p class="lane mono">Next</p><p>Summer '27 PM internship, possibly on your team.</p></div>
          <div><p class="lane mono">Later</p><p>TBD, pending your offer.</p></div>
        </div>
      </section>

      <section id="scope" data-anchor="scope">
        <h2>6. Out of scope</h2>
        <ul class="nope">
          <li>Cold showers.</li>
          <li>Light mode. (It exists. It's just judged.)</li>
          <li>Writing PRDs about myself. (Oops.)</li>
        </ul>
      </section>

      <section id="appendix" data-anchor="appendix">
        <h2>7. Appendix</h2>
        <p class="mono app-h">A. Toolkit</p>
        <p class="chips">{[...skills.product, ...skills.technical].map((s) => <span>{s}</span>)}</p>
        <p class="mono app-h">B. Contact</p>
        <p class="email"><a href={`mailto:${links.email}`}>{links.email}</a></p>
        <p class="links mono">
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={links.resume} download>resume.pdf ↓</a>
        </p>
      </section>

      <footer class="foot mono">End of document · © 2026 Kalash Jain · built in LA between coffee chats</footer>
    </main>

    <aside class="comments" data-comments aria-label="Review comments">
      <div class="thread" data-for="top">
        <p class="who"><b>Recruiter</b> · 2m</p>
        <p>Is this a PRD or a portfolio?</p>
        <p class="who reply"><b>Kalash</b> · 1m</p>
        <p>Yes.</p>
        <button type="button" class="resolve" data-resolve>Resolve</button>
      </div>
      <div class="thread" data-for="tldr">
        <p class="who"><b>Hiring manager</b> · 5m</p>
        <p>Can we see the full resume?</p>
        <p class="who reply"><b>Kalash</b> · 4m</p>
        <p>Attached: <a href={links.resume} download>resume.pdf</a>. One page, ruthlessly prioritized.</p>
        <button type="button" class="resolve" data-resolve>Resolve</button>
      </div>
      <div class="thread" data-for="decisions">
        <p class="who"><b>Legal</b> · 1h</p>
        <p>Approved. No puns were harmed in the making of this document.</p>
        <button type="button" class="resolve" data-resolve>Resolve</button>
      </div>
      <div class="thread" data-for="roadmap">
        <p class="who"><b>You</b> · now</p>
        <p>LGTM 👍 ship it.</p>
        <button type="button" class="resolve" data-resolve>Resolve</button>
      </div>
    </aside>
  </div>
</Lab>

<style>
  :global(body) {
    --bg: #0b0a0f;
    --doc: #121118;
    --ink: #ecebf3;
    --muted: #8f8ba3;
    --line: #26242f;
    --violet: oklch(0.72 0.16 285);
    background: var(--bg);
    color: var(--ink);
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: 1.12rem;
    line-height: 1.6;
  }
  a {
    color: var(--violet);
  }
  .mono,
  .crumbs,
  dt,
  .ol-h,
  .outline a,
  .who,
  .resolve,
  .chip,
  .foot {
    font-family: 'Martian Mono Variable', monospace;
  }
  .app {
    display: grid;
    grid-template-columns: 190px minmax(0, 700px) 280px;
    justify-content: center;
    gap: 40px;
    padding: 0 24px;
  }

  /* outline */
  .outline {
    position: sticky;
    top: 0;
    align-self: start;
    padding-top: 48px;
    font-size: 0.72rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
  }
  .ol-h {
    margin: 28px 0 8px;
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .outline ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .outline a {
    display: block;
    padding: 5px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
  }
  .outline a.active {
    color: var(--ink);
    border-left-color: var(--violet);
  }

  /* document */
  .doc {
    padding: 48px 0 80px;
  }
  .crumbs {
    margin: 0 0 18px;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .crumbs b {
    color: var(--violet);
    font-weight: 400;
  }
  h1 {
    margin: 0;
    font-variation-settings: 'opsz' 72;
    font-weight: 500;
    font-size: clamp(3rem, 8vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .subtitle {
    margin: 10px 0 28px;
    font-style: italic;
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    color: var(--violet);
  }
  .meta {
    display: grid;
    gap: 6px;
    margin: 0 0 26px;
    padding: 16px 0;
    border-block: 1px solid var(--line);
  }
  .meta div {
    display: grid;
    grid-template-columns: 130px 1fr;
    align-items: baseline;
  }
  dt {
    font-size: 0.68rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 1rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 2px 10px;
    border-radius: 6px;
    background: color-mix(in oklch, var(--violet) 18%, transparent);
    color: var(--violet);
    font-family: 'Martian Mono Variable', monospace;
    font-size: 0.72rem;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--violet);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--violet);
    }
    80%,
    100% {
      box-shadow: 0 0 0 8px transparent;
    }
