  /* audio summary player, i.e. the waveform */
  .player {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--doc);
  }
  .play {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 0;
    background: var(--violet);
    color: var(--bg);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .bars {
    --p: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 36px;
  }
  .bars span {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: var(--line);
    transition: background 0.2s;
  }
  .bars span.on {
    background: var(--violet);
  }
  .player-cap {
    margin: 6px 0 30px;
    font-size: 0.64rem;
    color: var(--muted);
  }
  .dur {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .fig {
    margin: 0 0 40px;
  }
  .fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: 6px;
  }
  figcaption {
    margin-top: 8px;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
  }

  section {
    scroll-margin-top: 24px;
    margin-bottom: 44px;
  }
  h2 {
    margin: 0 0 12px;
    font-variation-settings: 'opsz' 48;
    font-weight: 600;
    font-size: 1.7rem;
    letter-spacing: -0.01em;
  }
  section ul {
    padding-left: 22px;
  }
  section li {
    padding: 3px 0;
  }
  section li::marker {
    color: var(--violet);
  }

  .changelog {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .changelog > li {
    position: relative;
    padding: 6px 0 14px 22px;
  }
  .changelog > li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 14px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--violet);
  }
  .ver {
    font-size: 0.75rem;
    color: var(--violet);
    margin-right: 12px;
  }
  .when {
    font-size: 0.68rem;
    color: var(--muted);
  }
  .changelog p {
    margin: 4px 0 0;
  }
  details {
    margin-top: 8px;
  }
  details summary {
    cursor: pointer;
    font-size: 0.72rem;
    color: var(--violet);
  }
  .notes {
    margin-top: 10px;
    font-size: 1rem;
  }
  .notes-h {
    margin: 0;
    font-size: 0.66rem;
    color: var(--muted);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  th {
    text-align: left;
    font-family: 'Martian Mono Variable', monospace;
    font-weight: 400;
    font-size: 0.66rem;
    color: var(--muted);
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 10px 10px 10px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 5px;
    font-size: 0.64rem;
    white-space: nowrap;
    background: color-mix(in oklch, var(--violet) 18%, transparent);
    color: var(--violet);
  }
  .chip.in-progress {
    background: transparent;
    border: 1px dashed var(--violet);
  }
  .chip.locked {
    background: var(--ink);
    color: var(--bg);
  }

  .road {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .road > div {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--doc);
    font-size: 1rem;
  }
  .road > div:first-child {
    border-color: var(--violet);
  }
  .lane {
    margin: 0 0 6px;
    font-size: 0.66rem;
    color: var(--violet);
  }
  .road p {
    margin: 0;
  }
  .nope li {
    text-decoration: line-through;
    text-decoration-color: var(--violet);
    color: var(--muted);
  }
  .app-h {
    margin: 18px 0 8px;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }
  .chips span {
    font-family: 'Martian Mono Variable', monospace;
    font-size: 0.66rem;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--muted);
  }
  .email {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }
  .email a {
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 0.75rem;
  }
  .foot {
    margin-top: 60px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 0.64rem;
    color: var(--muted);
  }

  /* review comments */
  .comments {
    position: relative;
  }
  .thread {
    position: absolute;
    left: 0;
    right: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--violet);
    border-radius: 8px;
    background: var(--doc);
    font-family: 'Newsreader Variable', serif;
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0;
    translate: 12px 0;
    transition:
      opacity 0.5s,
      translate 0.5s,
      top 0.4s;
  }
  .thread.in {
    opacity: 1;
    translate: 0 0;
  }
  .thread.resolved {
    opacity: 0;
    translate: 24px 0;
    pointer-events: none;
  }
  .thread p {
    margin: 0;
  }
  .who {
    margin-top: 2px;
    font-size: 0.62rem;
    color: var(--muted);
  }
  .who b {
    color: var(--ink);
    font-weight: 500;
  }
  .reply {
    margin-top: 10px !important;
  }
  .resolve {
    margin-top: 10px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: none;
    color: var(--muted);
    font-size: 0.62rem;
    cursor: pointer;
  }
  .resolve:hover {
    color: var(--violet);
    border-color: var(--violet);
  }

  @media (max-width: 1180px) {
    .app {
      grid-template-columns: minmax(0, 700px) 260px;
    }
    .outline {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 16px;
    }
    .comments {
      display: grid;
      gap: 10px;
      padding-bottom: 60px;
    }
    .thread {
      position: static;
      opacity: 1;
      translate: 0;
    }
    .road {
      grid-template-columns: 1fr;
    }
    .meta div {
      grid-template-columns: 100px 1fr;
    }
    table {
      font-size: 0.92rem;
    }
  }
</style>

<script>
  const say = (detail: string) => dispatchEvent(new CustomEvent('toast', { detail }));
  const wide = () => matchMedia('(min-width: 901px)').matches;

  /* comment threads sit beside the section they're about (desktop) */
  const threads = [...document.querySelectorAll<HTMLElement>('.thread')];
  const comments = document.querySelector<HTMLElement>('[data-comments]')!;
  function place() {
    if (!wide()) return;
    const base = comments.getBoundingClientRect().top + scrollY;
    let floor = 0;
    for (const t of threads) {
      const target = document.querySelector(`[data-anchor="${t.dataset.for}"]`);
      if (!target) continue;
      const y = Math.max(floor, target.getBoundingClientRect().top + scrollY - base);
      t.style.top = `${y}px`;
      floor = y + t.offsetHeight + 12;
    }
  }
  document.fonts.ready.then(place);
  addEventListener('resize', place);
  addEventListener('load', place);
  document.querySelectorAll('details').forEach((d) => d.addEventListener('toggle', place));

  const io = new IntersectionObserver(
    (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
    { rootMargin: '0px 0px -15% 0px' },
  );
  threads.forEach((t) => io.observe(t));

  const lines = [
    'Resolved. Bold of you.',
    'Resolved. Very decisive. PM energy.',
    'Resolved. The author is thrilled.',
    'Resolved. Ship it.',
  ];
  let li = 0;
  document.querySelectorAll<HTMLButtonElement>('[data-resolve]').forEach((b) =>
    b.addEventListener('click', () => {
      b.closest('.thread')?.classList.add('resolved');
      say(lines[li++ % lines.length]);
    }),
  );

  /* outline highlights the section you're reading */
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const sio = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        tocLinks.forEach((a) => a.classList.toggle('active', a.dataset.toc === e.target.id));
      }),
    { rootMargin: '-30% 0px -60% 0px' },
  );
  tocLinks.forEach((a) => {
    const s = document.getElementById(a.dataset.toc!);
    if (s) sio.observe(s);
  });

  /* "audio summary": the waveform plays, then delivers the summary */
  const player = document.querySelector<HTMLElement>('[data-player]')!;
  const bars = [...player.querySelectorAll<HTMLElement>('.bars span')];
  const time = player.querySelector<HTMLElement>('[data-time]')!;
  const btn = player.querySelector<HTMLButtonElement>('[data-play]')!;
  let playing = 0;
  btn.addEventListener('click', () => {
    clearInterval(playing);
    let i = 0;
    bars.forEach((b) => b.classList.remove('on'));
    btn.textContent = '❚❚';
    playing = window.setInterval(() => {
      bars[i]?.classList.add('on');
      i++;
      time.textContent = `0:${String(Math.round((i / bars.length) * 12)).padStart(2, '0')}`;
      if (i >= bars.length) {
        clearInterval(playing);
        btn.textContent = '▶';
        say('Audio summary: "Hire him." That\'s the whole summary.');
      }
    }, 45);
  });

  /* "last edited" ticks up while you read, like a real doc */
  const edited = document.querySelector<HTMLElement>('[data-edited]')!;
  const t0 = Date.now();
  setInterval(() => {
    const m = Math.floor((Date.now() - t0) / 60000);
    edited.textContent = m < 1 ? 'just now' : `${m} min ago (by you, apparently)`;
  }, 15000);
</script>
