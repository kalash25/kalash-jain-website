---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { Picture } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import portrait from '../../assets/portrait-dark.webp';
import { experience } from '../../data/site';

const palettes = [
  { id: 'studio', name: 'Studio Violet', note: 'black · electric violet blocks · warm white' },
  { id: 'lilac', name: 'Ink & Lilac', note: 'warm paper · ink black · violet blocks' },
  { id: 'plum', name: 'Deep Plum', note: 'aubergine · lavender · white' },
];
const jp = experience[0];

let wave = '';
for (let i = 0; i <= 120; i++) {
  const x = i / 120;
  const env = Math.pow(Math.sin(Math.PI * x), 1.4);
  const s = Math.sin(x * 38 + 1.2) * 0.5 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17 + 2) * 0.2;
  wave += `${i ? 'L' : 'M'}${(x * 1000).toFixed(1)} ${(30 - s * env * 22).toFixed(1)}`;
}
---

<Lab title="Palettes · Kalash Jain (lab)">
  <div class="page" data-palette="studio" data-page>
    <header class="switch" role="radiogroup" aria-label="Palette">
      <a class="back" href="/lab">← lab</a>
      {
        palettes.map((p, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-pick={p.id}>
            <span class={`chip ${p.id}`} aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span class="pname">
              {i + 1}. {p.name}
            </span>
            <span class="pnote">{p.note}</span>
          </button>
        ))
      }
    </header>

    <!-- hero replica -->
    <section class="hero">
      <div class="copy">
        <p class="eyebrow">UCLA Anderson MBA '28 · ex-JPMorgan Chase</p>
        <h1>Kalash Jain</h1>
        <svg class="wave" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true"><path d={wave} /></svg>
        <p class="line">Product thinker<br /><em>with an engineer's toolkit.</em></p>
        <p class="lede">
          Three years as a software engineer at JPMorgan Chase, building testing and automation tools and
          getting the teams who used them on board. Now at UCLA Anderson, focused on product management in
          tech, media and creative tools.
        </p>
        <p class="ctas">
          <a class="btn solid" href="#block">See my experience ↓</a>
          <a class="btn ghost" href="#block">Download resume</a>
        </p>
      </div>
      <div class="duo">
        <Picture src={portrait} formats={['avif', 'webp']} widths={[480, 760]} sizes="380px" alt="Kalash Jain" loading="eager" />
      </div>
    </section>

    <!-- a solid colour-block section, the "studio" move -->
    <section class="block" id="block">
      <p class="label">01 · Experience</p>
      <h2>Where I've worked.</h2>
      <div class="card">
        <p class="org">{jp.org}</p>
        <p class="role">{jp.roles![0].title} · {jp.roles![0].dates}</p>
        <p class="pt">{jp.groups![0].points[1]}</p>
      </div>
    </section>

    <section class="after">
      <p class="label">02 · Back to base</p>
      <p class="big">How text, links and accents read on the base colour after a block.</p>
      <p><a class="link" href="#">An inline link</a> · <span class="hl">a highlighted phrase</span> · <span class="tag">a tag</span></p>
    </section>
  </div>
</Lab>

<style>
  /* three palettes, each just a set of tokens */
  .page[data-palette='studio'] {
    --bg: #0a090d;
    --ink: #f3efe7;
    --muted: #a19cae;
    --line: #26232f;
    --accent: #7b5cff;
    --on-accent: #ffffff;
    --block: #7b5cff;
    --on-block: #0a090d;
    --card: #0a090d;
    --on-card: #f3efe7;
    --duo-dark: #1a0f4d;
    --duo-light: #c9bcff;
  }
  .page[data-palette='lilac'] {
    --bg: #f2eee6;
    --ink: #121016;
    --muted: #6b6676;
    --line: #dcd5c8;
    --accent: #5b3df5;
    --on-accent: #ffffff;
    --block: #5b3df5;
    --on-block: #ffffff;
    --card: #f2eee6;
    --on-card: #121016;
    --duo-dark: #2a1a7a;
    --duo-light: #efeaff;
  }
  .page[data-palette='plum'] {
    --bg: #1b1029;
    --ink: #f6f1ff;
    --muted: #b9abd3;
    --line: #34234d;
    --accent: #c4b2ff;
    --on-accent: #1b1029;
    --block: #c4b2ff;
    --on-block: #1b1029;
    --card: #1b1029;
    --on-card: #f6f1ff;
    --duo-dark: #2b1442;
    --duo-light: #e6dcff;
  }

  .page {
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Geist Variable', system-ui, sans-serif;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  /* palette switcher */
  .switch {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.72rem;
  }
  .back {
    color: var(--muted);
    margin-right: 8px;
    text-decoration: none;
  }
  .switch button {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 10px;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .switch button[aria-checked='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .chip {
    grid-row: span 2;
    display: flex;
  }
  .chip i {
    width: 14px;
    height: 22px;
    border: 1px solid #0003;
  }
  .chip i:first-child {
    border-radius: 6px 0 0 6px;
  }
  .chip i:last-child {
    border-radius: 0 6px 6px 0;
  }
  .chip.studio i:nth-child(1) { background: #0a090d; }
  .chip.studio i:nth-child(2) { background: #7b5cff; }
  .chip.studio i:nth-child(3) { background: #f3efe7; }
  .chip.lilac i:nth-child(1) { background: #f2eee6; }
  .chip.lilac i:nth-child(2) { background: #5b3df5; }
  .chip.lilac i:nth-child(3) { background: #121016; }
  .chip.plum i:nth-child(1) { background: #1b1029; }
  .chip.plum i:nth-child(2) { background: #c4b2ff; }
  .chip.plum i:nth-child(3) { background: #f6f1ff; }
  .pname {
    font-weight: 600;
  }
  .pnote {
    color: var(--muted);
    font-size: 0.64rem;
  }

  /* hero replica */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 20px 80px;
  }
  .eyebrow,
  .label {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  h1 {
    margin: 14px 0 0;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-variation-settings: 'opsz' 96;
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .wave {
    display: block;
    width: min(100%, 520px);
    height: 50px;
    margin: 6px 0 22px;
  }
  .wave path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .line {
    margin: 0 0 16px;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .line em {
    font-style: normal;
    color: var(--accent);
  }
  .lede {
    max-width: 54ch;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .btn {
    padding: 13px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .btn.solid {
    background: var(--accent);
    color: var(--on-accent);
  }
  .btn.ghost {
    border: 1px solid var(--line);
    color: var(--ink);
  }

  /* violet duotone photo: shadows → duo-dark, highlights → duo-light */
  .duo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 18px;
    background: var(--duo-light);
    isolation: isolate;
  }
  .duo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    mix-blend-mode: multiply;
  }
  .duo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--duo-dark);
    mix-blend-mode: lighten;
    pointer-events: none;
  }

  /* solid colour block section */
  .block {
    background: var(--block);
    color: var(--on-block);
    padding: 72px 20px 80px;
    transition:
      background-color 0.5s,
      color 0.5s;
  }
  .block > * {
    max-width: 1160px;
    margin-left: auto;
    margin-right: auto;
  }
  .block .label {
    color: inherit;
    opacity: 0.7;
  }
  .block h2 {
    margin-top: 10px;
    margin-bottom: 28px;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .card {
    max-width: 640px;
    margin-left: 0;
    padding: 22px 24px;
    border-radius: 16px;
    background: var(--card);
    color: var(--on-card);
  }
  .card .org {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .card .role {
    margin: 4px 0 10px;
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.75rem;
    color: var(--accent);
  }
  .card .pt {
    margin: 0;
    color: var(--muted);
  }
  .after {
    max-width: 1160px;
    margin: 0 auto;
    padding: 64px 20px 100px;
  }
  .big {
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 24ch;
  }
  .link {
    color: var(--accent);
  }
  .hl {
    background: linear-gradient(transparent 55%, color-mix(in srgb, var(--accent) 35%, transparent) 55%);
  }
  .tag {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 0.75rem;
    padding: 3px 9px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 32px;
    }
    .duo {
      order: -1;
      max-width: 280px;
    }
    .pnote {
      display: none;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-page]')!;
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const pick = (id: string) => {
    page.dataset.palette = id;
    btns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.pick === id)));
  };
  btns.forEach((b) => b.addEventListener('click', () => pick(b.dataset.pick!)));
  addEventListener('keydown', (e) => {
    const i = ['1', '2', '3'].indexOf(e.key);
    if (i >= 0) pick(btns[i].dataset.pick!);
  });
</script>
