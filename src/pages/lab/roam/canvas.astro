---
// Demo A: the whole site as one explorable board you pan and zoom around.
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import LabBar from '../../../components/lab/LabBar.astro';
import Story from '../../../components/Story.astro';
import Timeline from '../../../components/Timeline.astro';
import Projects from '../../../components/Projects.astro';
import About from '../../../components/About.astro';
import Contact from '../../../components/Contact.astro';
import portrait from '../../../assets/portrait-dark.webp';
import { experience, education } from '../../../data/site';

// Islands are packed into three columns at runtime (by measured height), close enough
// that neighbours peek in around the start card. Widths are fixed here.
const islands = [
  { id: 'story', label: 'Story', col: 0, w: 1200 },
  { id: 'education', label: 'Education', col: 1, w: 1050 },
  { id: 'experience', label: 'Experience', col: 2, w: 1150 },
  { id: 'projects', label: 'Projects', col: 0, w: 1200 },
  { id: 'about', label: 'About', col: 1, w: 1050 },
  { id: 'contact', label: 'Contact', col: 0, w: 1100 },
];
const hub = { col: 1, w: 1050 };
const pos = (i: { col: number; w: number }) => `width:${i.w}px`;
---

<Base title="A · Canvas · Kalash Jain">
  <LabBar current="canvas" />

  <div class="viewport" data-viewport tabindex="0" aria-label="Portfolio board. Drag or use arrow keys to move.">
    <div class="world" data-world>
      {/* faint threads from the hub to each island (painted underneath them) */}
      <svg class="threads" aria-hidden="true" data-threads></svg>
      <!-- the hub: where you land -->
      <div class="island hub" data-island="home" data-label="Start" data-col="1" data-order="1" style={pos(hub)}>
        <div class="hub-photo">
          <Image src={portrait} width={360} alt="Kalash Jain" />
        </div>
        <div class="hub-copy">
          <p class="mono">UCLA Anderson MBA '28 · ex-JPMorgan Chase</p>
          <h1>Kalash Jain</h1>
          <p class="hub-line">Product thinker with an engineer's toolkit. This is my board: wander anywhere.</p>
          <div class="signs">
            {islands.map((i) => <button type="button" data-fly={i.id}>{i.label}</button>)}
          </div>
          <p class="mono hub-hint">drag · scroll · pinch to zoom · or press a sign</p>
        </div>
      </div>

      <div class="island" data-island="story" data-col="0" data-order="0" data-label="Story" style={pos(islands[0])}>
        <Story drive="manual" n="01" />
      </div>
      <div class="island" data-island="education" data-col="1" data-order="0" data-label="Education" style={pos(islands[1])}>
        <Timeline id="education" n="03" label="Education" title="Where I've <em>studied.</em>" entries={education} />
      </div>
      <div class="island" data-island="experience" data-col="2" data-order="0" data-label="Experience" style={pos(islands[2])}>
        <Timeline id="experience" n="02" label="Experience" title="Where I've <em>worked.</em>" entries={experience} />
      </div>
      <div class="island" data-island="projects" data-col="0" data-order="1" data-label="Projects" style={pos(islands[3])}>
        <Projects />
      </div>
      <div class="island" data-island="about" data-col="1" data-order="2" data-label="About" style={pos(islands[4])}>
        <About />
      </div>
      <div class="island" data-island="contact" data-col="0" data-order="2" data-label="Contact" style={pos(islands[5])}>
        <Contact />
      </div>
    </div>
  </div>

  <nav class="chips" aria-label="Jump to">
    <button type="button" data-fly="home">Start</button>
    {islands.map((i) => <button type="button" data-fly={i.id}>{i.label}</button>)}
  </nav>

  <div class="minimap" aria-hidden="true">
    <svg data-minimap></svg>
  </div>
  <div class="zoom">
    <button type="button" data-zoom="-1" aria-label="Zoom out">−</button>
    <span class="mono" data-zoom-label>60%</span>
    <button type="button" data-zoom="1" aria-label="Zoom in">+</button>
  </div>
</Base>

<style>
  :global(body) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  .viewport {
    position: fixed;
    inset: 60px 0 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    outline: none;
    background-image: radial-gradient(color-mix(in oklch, var(--muted) 30%, transparent) 1px, transparent 1.4px);
    background-size: var(--grid, 28px) var(--grid, 28px);
    background-position: var(--gx, 0) var(--gy, 0);
  }
  .viewport.panning {
    cursor: grabbing;
  }
  .world {
    position: absolute;
    top: 0;
    left: 0;
    width: 4600px;
    height: 4400px;
    transform-origin: 0 0;
    will-change: transform;
  }
  .island {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--bg);
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.6);
  }
  /* a big label above each island, readable when zoomed far out */
  .island::before {
    content: attr(data-label);
    position: absolute;
    left: 8px;
    bottom: calc(100% + 18px);
    font: 650 110px/1 var(--font-display);
    letter-spacing: -0.05em;
    color: color-mix(in oklch, var(--accent) 70%, transparent);
    opacity: var(--label-o, 0);
    pointer-events: none;
  }
  .island :global(section) {
    border-top: 0 !important;
  }
  .island :global(#story) {
    padding-top: 60px;
  }

  .hub {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    align-items: center;
    padding: 48px;
    border-color: color-mix(in oklch, var(--accent) 45%, var(--line));
  }
  .hub-photo {
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: radial-gradient(circle at 50% 30%, color-mix(in oklch, var(--accent) 30%, transparent), transparent 70%);
  }
  .hub-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
  .hub h1 {
    margin: 10px 0 12px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 4.6rem;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .hub-line {
    margin: 0 0 22px;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .signs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .signs button,
  .chips button {
    padding: 9px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: 500 0.88rem/1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
  }
  .signs button:hover,
  .chips button:hover {
    border-color: var(--accent);
  }
  .signs button::after {
    content: ' →';
    color: var(--accent);
  }
  .hub-hint {
    margin-top: 22px;
    font-size: 0.64rem;
  }

  .threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .threads :global(path) {
    fill: none;
    stroke: color-mix(in oklch, var(--accent) 40%, transparent);
    stroke-width: 2;
    stroke-dasharray: 2 10;
    stroke-linecap: round;
  }

  .chips {
    position: fixed;
    left: 50%;
    bottom: 18px;
    z-index: 20;
    display: flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    translate: -50% 0;
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips button {
    flex: none;
    border-color: transparent;
    background: transparent;
    color: var(--muted);
  }
  .chips button.on {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .minimap {
    position: fixed;
    right: 18px;
    bottom: 76px;
    z-index: 20;
    width: 180px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in oklch, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
  }
  .minimap svg {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
  }
  .minimap :global(.mm-island) {
    fill: color-mix(in oklch, var(--muted) 25%, transparent);
  }
  .minimap :global(.mm-island.on) {
    fill: color-mix(in oklch, var(--accent) 55%, transparent);
  }
  .minimap :global(.mm-view) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 30;
  }
  .zoom {
    position: fixed;
    right: 18px;
    bottom: 22px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg) 80%, transparent);
  }
  .zoom button {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
    cursor: pointer;
  }
  .zoom button:hover {
    background: var(--surface);
  }
  .zoom span {
    min-width: 3.2em;
    text-align: center;
    font-size: 0.66rem;
  }
  @media (max-width: 760px) {
    .minimap {
      display: none;
    }
    .zoom {
      bottom: 76px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { whoosh, tick } from '../../../scripts/sound';

  const vp = document.querySelector<HTMLElement>('[data-viewport]')!;
  const world = document.querySelector<HTMLElement>('[data-world]')!;
  const islands = [...document.querySelectorAll<HTMLElement>('[data-island]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips [data-fly]')];
  const mm = document.querySelector<SVGSVGElement>('[data-minimap]')!;
  const zoomLabel = document.querySelector<HTMLElement>('[data-zoom-label]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Box = { id: string; x: number; y: number; w: number; h: number; el: HTMLElement };
  let boxes: Box[] = [];
  let bounds = { x: 0, y: 0, w: 4600, h: 4400 };
  // pack islands into columns, top to bottom in data-order
  const pack = () => {
    const colX = [0, 1340, 2530];
    const gap = 150;
    const colY = [0, 0, 0];
    [...islands]
      .sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order))
      .forEach((el) => {
        const c = Number(el.dataset.col);
        el.style.left = `${colX[c]}px`;
        el.style.top = `${colY[c]}px`;
        colY[c] += el.offsetHeight + gap;
      });
    // the right column starts level with the start card, so it peeks in too
    const hubEl = islands.find((el) => el.dataset.island === 'home')!;
    islands
      .filter((el) => el.dataset.col === '2')
      .forEach((el) => (el.style.top = `${parseFloat(el.style.top) + hubEl.offsetTop - 200}px`));
  };
  const measure = () => {
    pack();
    boxes = islands.map((el) => ({
      id: el.dataset.island!,
      x: el.offsetLeft,
      y: el.offsetTop,
      w: el.offsetWidth,
      h: el.offsetHeight,
      el,
    }));
    const pad = 400;
    const x0 = Math.min(...boxes.map((b) => b.x)) - pad;
    const y0 = Math.min(...boxes.map((b) => b.y)) - pad;
    const x1 = Math.max(...boxes.map((b) => b.x + b.w)) + pad;
    const y1 = Math.max(...boxes.map((b) => b.y + b.h)) + pad;
    bounds = { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    drawMinimap();
    drawThreads();
  };

  /* ---- camera: (x, y) is the board point at the centre of the screen ---- */
  const cam = { x: 0, y: 0, z: 0.6 };
  const Z_MIN = 0.12;
  const Z_MAX = 1.4;
  const size = () => ({ w: vp.clientWidth, h: vp.clientHeight });
  const clampCam = () => {
    cam.z = Math.min(Z_MAX, Math.max(Z_MIN, cam.z));
    cam.x = Math.min(bounds.x + bounds.w, Math.max(bounds.x, cam.x));
    cam.y = Math.min(bounds.y + bounds.h, Math.max(bounds.y, cam.y));
  };
  let current = '';
  const apply = () => {
    clampCam();
    const { w, h } = size();
    const tx = w / 2 - cam.x * cam.z;
    const ty = h / 2 - cam.y * cam.z;
    world.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${cam.z})`;
    // the dot grid moves with the board, so panning feels physical
    const g = 28 * Math.max(0.5, Math.min(2, cam.z * 1.6));
    vp.style.setProperty('--grid', `${g}px`);
    vp.style.setProperty('--gx', `${tx % g}px`);
    vp.style.setProperty('--gy', `${ty % g}px`);
    // island names fade in as you zoom out
    world.style.setProperty('--label-o', String(Math.max(0, Math.min(1, (0.45 - cam.z) / 0.2))));
    if (zoomLabel) zoomLabel.textContent = `${Math.round(cam.z * 100)}%`;
    // which island is under the middle of the screen
    let best = 'home';
    let bestD = Infinity;
    for (const b of boxes) {
      const cx = Math.max(b.x, Math.min(b.x + b.w, cam.x));
      const cy = Math.max(b.y, Math.min(b.y + b.h, cam.y));
      const d = Math.hypot(cx - cam.x, cy - cam.y);
      if (d < bestD) {
        bestD = d;
        best = b.id;
      }
    }
    if (best !== current) {
      current = best;
      chips.forEach((c) => c.classList.toggle('on', c.dataset.fly === best));
      mm.querySelectorAll('.mm-island').forEach((r) => r.classList.toggle('on', (r as SVGElement).dataset.id === best));
    }
    const view = mm.querySelector('.mm-view');
    if (view) {
      view.setAttribute('x', String(cam.x - w / 2 / cam.z));
      view.setAttribute('y', String(cam.y - h / 2 / cam.z));
      view.setAttribute('width', String(w / cam.z));
      view.setAttribute('height', String(h / cam.z));
    }
  };

  function drawMinimap() {
    mm.setAttribute('viewBox', `${bounds.x} ${bounds.y} ${bounds.w} ${bounds.h}`);
    mm.innerHTML =
      boxes
        .map((b) => `<rect class="mm-island" data-id="${b.id}" x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}" rx="40"/>`)
        .join('') + '<rect class="mm-view" rx="30"/>';
  }
  function drawThreads() {
    const svg = document.querySelector<SVGSVGElement>('[data-threads]')!;
    const hub = boxes.find((b) => b.id === 'home');
    if (!hub) return;
    const hx = hub.x + hub.w / 2;
    const hy = hub.y + hub.h / 2;
    svg.innerHTML = boxes
      .filter((b) => b.id !== 'home')
      .map((b) => {
        const tx = Math.max(b.x + 60, Math.min(b.x + b.w - 60, hx));
        const ty = Math.max(b.y + 60, Math.min(b.y + b.h - 60, hy));
        const mx = (hx + tx) / 2 + (ty - hy) * 0.12;
        const my = (hy + ty) / 2 - (tx - hx) * 0.12;
        return `<path d="M${hx} ${hy} Q${mx} ${my} ${tx} ${ty}"/>`;
      })
      .join('');
  }

  /* ---- fly to an island: pull back, travel, then settle in ---- */
  let flight: gsap.core.Tween | null = null;
  const flyTo = (id: string) => {
    const b = boxes.find((x) => x.id === id);
    if (!b) return;
    const { w, h } = size();
    const z1 = Math.min(1, (w * 0.9) / b.w, id === 'home' ? (h * 0.8) / b.h : 9);
    const x1 = b.x + b.w / 2;
    // tall islands: land at their top rather than their middle
    const y1 = b.h * z1 > h * 0.9 ? b.y + (h / 2 - 40) / z1 : b.y + b.h / 2;
    const from = { ...cam };
    const dist = Math.hypot(x1 - from.x, y1 - from.y);
    flight?.kill();
    if (reduce) {
      Object.assign(cam, { x: x1, y: y1, z: z1 });
      apply();
      return;
    }
    if (dist > 600) whoosh({ dur: 1.1, from: 220, to: 1800, gain: 0.25 });
    const p = { t: 0 };
    flight = gsap.to(p, {
      t: 1,
      duration: Math.min(1.6, 0.7 + dist / 3000),
      ease: 'power3.inOut',
      onUpdate: () => {
        const t = p.t;
        const dip = 1 - Math.min(0.6, dist / 5000) * Math.sin(Math.PI * t);
        cam.x = from.x + (x1 - from.x) * t;
        cam.y = from.y + (y1 - from.y) * t;
        cam.z = (from.z + (z1 - from.z) * t) * dip;
        apply();
      },
    });
  };
  document.querySelectorAll<HTMLElement>('[data-fly]').forEach((b) =>
    b.addEventListener('click', () => flyTo(b.dataset.fly!)),
  );

  /* ---- drag to pan (with a little momentum), pinch to zoom ---- */
  const pointers = new Map<number, { x: number; y: number }>();
  let dragging = false;
  let start = { x: 0, y: 0 };
  let vel = { x: 0, y: 0 };
  let lastT = 0;
  let pinch0 = 0;
  let glide = 0;
  const interactive = (t: EventTarget | null) =>
    (t as Element)?.closest?.('a, button, input, textarea, select, label, [data-story-map], .metric');

  vp.addEventListener('pointerdown', (e) => {
    if (interactive(e.target) && e.pointerType === 'mouse') return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    start = { x: e.clientX, y: e.clientY };
    lastT = performance.now();
    vel = { x: 0, y: 0 };
    cancelAnimationFrame(glide);
    flight?.kill();
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch0 = Math.hypot(a.x - b.x, a.y - b.y);
    }
  });
  addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    if (pointers.size === 2) {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, d / pinch0);
      pinch0 = d;
      return;
    }
    if (!dragging && Math.hypot(e.clientX - start.x, e.clientY - start.y) < 5) return;
    if (!dragging) {
      dragging = true;
      vp.classList.add('panning');
      vp.setPointerCapture?.(e.pointerId);
    }
    const now = performance.now();
    const dx = e.clientX - prev.x;
    const dy = e.clientY - prev.y;
    cam.x -= dx / cam.z;
    cam.y -= dy / cam.z;
    const dt = Math.max(1, now - lastT);
    vel = { x: dx / dt, y: dy / dt };
    lastT = now;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    apply();
  });
  const end = (e: PointerEvent) => {
    if (!pointers.has(e.pointerId)) return;
    pointers.delete(e.pointerId);
    pinch0 = 0;
    if (!dragging || pointers.size) return;
    dragging = false;
    vp.classList.remove('panning');
    if (reduce) return;
    // momentum: keep sliding and ease to a stop
    const go = () => {
      vel.x *= 0.92;
      vel.y *= 0.92;
      cam.x -= (vel.x * 16) / cam.z;
      cam.y -= (vel.y * 16) / cam.z;
      apply();
      if (Math.abs(vel.x) + Math.abs(vel.y) > 0.02) glide = requestAnimationFrame(go);
    };
    if (performance.now() - lastT < 80) glide = requestAnimationFrame(go);
  };
  addEventListener('pointerup', end);
  addEventListener('pointercancel', end);
  // a drag that ends on a link or button shouldn't also click it
  vp.addEventListener('click', (e) => {
    if (Math.hypot(e.clientX - start.x, e.clientY - start.y) > 5) {
      e.preventDefault();
      e.stopPropagation();
    }
  }, true);

  function zoomAt(sx: number, sy: number, factor: number) {
    const r = vp.getBoundingClientRect();
    const { w, h } = size();
    const px = sx - r.left;
    const py = sy - r.top;
    // the board point under the cursor stays under the cursor
    const wx = cam.x + (px - w / 2) / cam.z;
    const wy = cam.y + (py - h / 2) / cam.z;
    cam.z = Math.min(Z_MAX, Math.max(Z_MIN, cam.z * factor));
    cam.x = wx - (px - w / 2) / cam.z;
    cam.y = wy - (py - h / 2) / cam.z;
    apply();
  }

  vp.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      flight?.kill();
      cancelAnimationFrame(glide);
      if (e.ctrlKey || e.metaKey) zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.01));
      else {
        cam.x += e.deltaX / cam.z;
        cam.y += e.deltaY / cam.z;
        apply();
      }
    },
    { passive: false },
  );

  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((b) =>
    b.addEventListener('click', () => {
      const r = vp.getBoundingClientRect();
      zoomAt(r.left + r.width / 2, r.top + r.height / 2, Number(b.dataset.zoom) > 0 ? 1.25 : 0.8);
      tick(0.5);
    }),
  );

  vp.addEventListener('keydown', (e) => {
    const step = 140 / cam.z;
    const k: Record<string, () => void> = {
      ArrowLeft: () => (cam.x -= step),
      ArrowRight: () => (cam.x += step),
      ArrowUp: () => (cam.y -= step),
      ArrowDown: () => (cam.y += step),
      '+': () => (cam.z *= 1.2),
      '=': () => (cam.z *= 1.2),
      '-': () => (cam.z /= 1.2),
    };
    if (k[e.key] && e.target === vp) {
      e.preventDefault();
      k[e.key]();
      apply();
    }
  });

  mm.addEventListener('click', (e) => {
    const pt = mm.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    const p = pt.matrixTransform(mm.getScreenCTM()!.inverse());
    const hit = boxes.find((b) => p.x >= b.x && p.x <= b.x + b.w && p.y >= b.y && p.y <= b.y + b.h);
    if (hit) flyTo(hit.id);
    else {
      gsap.to(cam, { x: p.x, y: p.y, duration: 0.8, ease: 'power3.inOut', onUpdate: apply });
    }
  });

  addEventListener('resize', apply);
  document.fonts.ready.then(() => {
    measure();
    const hub = boxes.find((b) => b.id === 'home')!;
    const { w } = size();
    // land on the hub, zoomed out enough that neighbouring islands peek in at the edges
    Object.assign(cam, { x: hub.x + hub.w / 2, y: hub.y + hub.h / 2, z: Math.min(0.62, (w * 0.8) / hub.w) });
    apply();
    vp.focus({ preventScroll: true });
  });
  measure();
  apply();
</script>
