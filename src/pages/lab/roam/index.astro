---
import Base from '../../../layouts/Base.astro';
const demos = [
  {
    href: '/lab/roam/canvas',
    tag: 'A',
    name: 'Explorable canvas',
    line: 'One big board. Drag, scroll or pinch to roam; click an island to fly in. Mini-map in the corner.',
  },
  {
    href: '/lab/roam/paths',
    tag: 'B',
    name: 'Choose your path',
    line: 'Pick what you want to know. Each answer opens a scene, and each scene ends with doors to the rest.',
  },
  {
    href: '/lab/roam/desk',
    tag: 'C',
    name: 'Studio desk',
    line: "Look over my desk. Every object is a door: the badge, the laptop, the passport, the phone.",
  },
];
---

<Base title="Free-roam demos · Kalash Jain">
  <main class="wrap">
    <p class="mono">Lab · free roam</p>
    <h1>Three ways to <em>wander</em> the site.</h1>
    <p class="lede">Same content in each. Click around, then pick one (or a mix). Your choice replaces the scroll; the scroll survives as Skim mode.</p>
    <ul class="list">
      {
        demos.map((d) => (
          <li>
            <a href={d.href}>
              <span class="tag">{d.tag}</span>
              <span class="name">{d.name}</span>
              <span class="line">{d.line}</span>
              <span class="go">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .wrap {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(60px, 10vw, 120px) var(--gutter);
  }
  h1 {
    margin: 12px 0 16px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .lede {
    max-width: 58ch;
    color: var(--muted);
  }
  .list {
    display: grid;
    gap: 14px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .list a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 6px 18px;
    align-items: baseline;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    text-decoration: none;
    transition: border-color 0.25s var(--ease-out), translate 0.25s var(--ease-out);
  }
  .list a:hover {
    border-color: var(--accent);
    translate: 0 -2px;
  }
  .tag {
    grid-row: span 2;
    font: 650 2rem/1 var(--font-display);
    color: var(--accent);
  }
  .name {
    font: 650 1.3rem/1.2 var(--font-display);
  }
  .line {
    grid-column: 2;
    color: var(--muted);
  }
  .go {
    grid-row: 1 / span 2;
    grid-column: 3;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>
