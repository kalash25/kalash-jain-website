---
// Demo C: a top-down studio desk. Every object is a door into part of the site.
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import LabBar from '../../../components/lab/LabBar.astro';
import Story from '../../../components/Story.astro';
import Timeline from '../../../components/Timeline.astro';
import Projects from '../../../components/Projects.astro';
import About from '../../../components/About.astro';
import Contact from '../../../components/Contact.astro';
import ucla from '../../../assets/portrait-ucla.jpg';
import { experience, education, links } from '../../../data/site';

const sheets = [
  { id: 'experience', title: 'The badge: three years at JPMorgan Chase' },
  { id: 'projects', title: 'The laptop: things I build for myself' },
  { id: 'story', title: 'The passport: how I got here' },
  { id: 'education', title: 'The paperwork: where I studied' },
  { id: 'about', title: 'The photo: who I am' },
  { id: 'contact', title: 'The phone: say hi' },
];
---

<Base title="C · Desk · Kalash Jain">
  <LabBar current="desk" />

  <main class="room">
    <p class="caption mono">My desk, mid-recruiting season. <span>Pick something up.</span></p>

    <div class="desk" data-desk>
      <!-- laptop → projects -->
      <button type="button" class="obj laptop" data-open="projects" data-depth="1.2" style="--x:31%;--y:7%;--w:34%;--r:-1deg">
        <span class="lid">
          <span class="screen">
            <span class="code">
              <b>~/runway</b> $ brief "Adobe"<br />
              ✓ research 3 agents · 90s<br />
              ✓ pipeline → talking to<br />
              <b>~/lifeos</b> $ review --week<br />
              decisions tracked: 4 ▮
            </span>
          </span>
        </span>
        <span class="base"></span>
        <span class="tag">Projects</span>
      </button>

      <!-- passport → story -->
      <button type="button" class="obj passport" data-open="story" data-depth="0.8" style="--x:6%;--y:12%;--w:13.5%;--r:-9deg">
        <span class="cover">
          <span class="crest" aria-hidden="true">
            <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" /><path d="M6 20h28M20 6c-6 8-6 20 0 28M20 6c6 8 6 20 0 28M9 13h22M9 27h22" /></svg>
          </span>
          <span class="pp mono">Passport</span>
          <span class="stamp s1 mono">LAX<br />2026</span>
          <span class="stamp s2 mono">DEL</span>
        </span>
        <span class="tag">Story</span>
      </button>

      <!-- ID badge → experience -->
      <button type="button" class="obj badge" data-open="experience" data-depth="1" style="--x:71%;--y:4%;--w:12.5%;--r:8deg">
        <span class="lanyard" aria-hidden="true"></span>
        <span class="card">
          <span class="logo" aria-hidden="true"></span>
          <span class="who">Kalash Jain</span>
          <span class="role mono">SDE II · Associate</span>
          <span class="bars" aria-hidden="true"></span>
        </span>
        <span class="tag">Experience</span>
      </button>

      <!-- polaroid → about -->
      <button type="button" class="obj polaroid" data-open="about" data-depth="1.4" style="--x:7%;--y:52%;--w:15%;--r:5deg">
        <span class="pic"><Image src={ucla} width={360} alt="" loading="eager" /></span>
        <span class="hand">building the right things</span>
        <span class="tag">About</span>
      </button>

      <!-- diploma → education -->
      <button type="button" class="obj diploma" data-open="education" data-depth="0.6" style="--x:66%;--y:50%;--w:25%;--r:-4deg">
        <span class="paper">
          <span class="dk mono">Certificate of things learned</span>
          <span class="dt">UCLA Anderson · M.B.A. '28</span>
          <span class="dt sm">Punjab Engineering College · B.Tech '23</span>
          <span class="seal" aria-hidden="true"></span>
        </span>
        <span class="tag">Education</span>
      </button>

      <!-- phone → contact -->
      <button type="button" class="obj phone" data-open="contact" data-depth="1.6" style="--x:47%;--y:58%;--w:10%;--r:11deg">
        <span class="glass">
          <span class="time">9:41</span>
          <span class="notif"><b>Kalash</b> Open to Summer '27 PM internships. Coffee?</span>
        </span>
        <span class="tag">Contact</span>
      </button>

      <!-- notebook: just for fun -->
      <button type="button" class="obj notebook" data-toast="Poems live offline. Ask me for one over coffee." data-depth="0.7" style="--x:25%;--y:61%;--w:18%;--r:-3deg">
        <span class="page">
          <span class="hand">untitled, draft 4</span>
          <span class="hand faint">the quiet part of a launch is…</span>
        </span>
        <span class="tag">Notebook</span>
      </button>

      <!-- mug: just for fun -->
      <button type="button" class="obj mug" data-toast="Coffee number three. Coffee chats are a lifestyle." data-depth="1.8" style="--x:87%;--y:30%;--w:8.5%;--r:0deg">
        <span class="rim"></span>
        <span class="tag">Coffee</span>
      </button>

      <!-- sticky note: the resume -->
      <a class="obj sticky" href={links.resume} download data-depth="2" style="--x:58.5%;--y:68%;--w:8.5%;--r:-6deg">
        <span class="hand">resume ↓<br /><small>one page</small></span>
        <span class="tag">Resume</span>
      </a>
    </div>
  </main>

  <div class="scrim" data-scrim hidden></div>
  {
    sheets.map((s) => (
      <section class="sheet" data-sheet={s.id} aria-label={s.title} hidden>
        <div class="sheet-top">
          <p class="mono">{s.title}</p>
          <button type="button" class="close" data-close>Put it back ✕</button>
        </div>
        <div class="sheet-body">
          {s.id === 'story' && <Story drive="manual" n="01" />}
          {s.id === 'experience' && (
            <Timeline id="experience" n="02" label="Experience" title="Where I've <em>worked.</em>" entries={experience} />
          )}
          {s.id === 'projects' && <Projects />}
          {s.id === 'education' && (
            <Timeline id="education" n="03" label="Education" title="Where I've <em>studied.</em>" entries={education} />
          )}
          {s.id === 'about' && <About />}
          {s.id === 'contact' && <Contact />}
        </div>
      </section>
    ))
  }
</Base>

<style>
  :global(body) {
    overflow: hidden;
  }
  .room {
    position: fixed;
    inset: 60px 0 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    padding: 16px;
  }
  .caption {
    margin: 0;
    font-size: 0.7rem;
  }
  .caption span {
    color: var(--accent);
  }

  /* the desk itself: a cutting mat, scaled as one piece */
  .desk {
    position: relative;
    container-type: inline-size;
    width: min(96vw, calc((100svh - 140px) * 1.6), 1400px);
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 2.2cqw;
    background:
      linear-gradient(color-mix(in oklch, var(--muted) 10%, transparent) 1px, transparent 1px) 0 0 / 4cqw 4cqw,
      linear-gradient(90deg, color-mix(in oklch, var(--muted) 10%, transparent) 1px, transparent 1px) 0 0 / 4cqw 4cqw,
      radial-gradient(ellipse at 40% 30%, color-mix(in oklch, var(--accent) 10%, var(--surface)), var(--surface) 70%);
    box-shadow: 0 40px 100px -50px rgb(0 0 0 / 0.7);
  }

  /* every object: positioned, rotated, lifts on hover */
  .obj {
    --lift: 0px;
    --px: 0px;
    --py: 0px;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    rotate: var(--r);
    translate: var(--px) calc(var(--py) - var(--lift));
    filter: drop-shadow(0 calc(0.4cqw + var(--lift) * 0.6) calc(0.8cqw + var(--lift)) rgb(0 0 0 / 0.45));
    transition:
      rotate 0.45s var(--ease-out),
      translate 0.45s var(--ease-out),
      filter 0.45s var(--ease-out),
      scale 0.45s var(--ease-out);
  }
  .obj:hover,
  .obj:focus-visible {
    --lift: 1.2cqw;
    rotate: calc(var(--r) * 0.4);
    scale: 1.03;
    z-index: 5;
  }
  .tag {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.8cqw);
    padding: 0.35cqw 0.9cqw;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 max(11px, 0.95cqw) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    rotate: calc(var(--r) * -1);
    translate: -50% 4px;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out), translate 0.25s var(--ease-out);
    pointer-events: none;
  }
  .obj:hover .tag,
  .obj:focus-visible .tag {
    opacity: 1;
    translate: -50% 0;
  }
  .hand {
    font-family: 'Bradley Hand', 'Segoe Print', 'Comic Sans MS', cursive;
  }

  /* laptop */
  .laptop .lid {
    display: block;
    padding: 1cqw;
    border-radius: 1.2cqw 1.2cqw 0.3cqw 0.3cqw;
    background: #1b1922;
    border: 1px solid #34303d;
  }
  .laptop .screen {
    display: block;
    aspect-ratio: 16 / 10;
    padding: 1.4cqw;
    border-radius: 0.5cqw;
    background: radial-gradient(circle at 30% 20%, #2a2140, #0d0b12);
    overflow: hidden;
  }
  .laptop .code {
    display: block;
    font-family: var(--font-mono);
    color: #b6a8ff;
    font-size: 1.05cqw;
    line-height: 1.8;
  }
  .laptop .code b {
    color: #f3efe7;
    font-weight: 500;
  }
  .laptop .base {
    display: block;
    height: 1.4cqw;
    margin: 0 -2cqw;
    border-radius: 0 0 1.4cqw 1.4cqw;
    background: linear-gradient(#3a3644, #24212c);
  }

  /* passport */
  .passport .cover {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1cqw;
    aspect-ratio: 5 / 7;
    border-radius: 0.6cqw 1.2cqw 1.2cqw 0.6cqw;
    background: linear-gradient(135deg, #3c2a8f, #24175e);
    color: #e9e2ff;
    box-shadow: inset 0.5cqw 0 0 rgb(0 0 0 / 0.25);
  }
  .passport .crest svg {
    width: 5cqw;
    fill: none;
    stroke: #d6c98f;
    stroke-width: 1.2;
  }
  .passport .pp {
    color: #d6c98f;
    font-size: 1cqw;
    letter-spacing: 0.3em;
  }
  .stamp {
    position: absolute;
    padding: 0.3cqw 0.6cqw;
    border: 2px solid currentColor;
    border-radius: 0.4cqw;
    font-size: 0.8cqw;
    line-height: 1.1;
    opacity: 0.8;
  }
  .stamp.s1 {
    right: -2.4cqw;
    bottom: 2cqw;
    color: #ff8a7a;
    rotate: -14deg;
  }
  .stamp.s2 {
    left: -1.6cqw;
    top: 1.6cqw;
    color: #7ad1ff;
    border-radius: 50%;
    padding: 0.8cqw 0.5cqw;
    rotate: 12deg;
  }

  /* badge */
  .badge .lanyard {
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1.4cqw;
    height: 30cqw;
    translate: -50% 0;
    background: repeating-linear-gradient(0deg, #3a62d6 0 2cqw, #2f51b8 2cqw 4cqw);
    border-radius: 0.3cqw;
  }
  .badge .card {
    position: relative;
    display: grid;
    gap: 0.5cqw;
    padding: 1.4cqw 1.2cqw;
    aspect-ratio: 5 / 7.4;
    align-content: start;
    border-radius: 1cqw;
    background: #f6f4ef;
    color: #121016;
  }
  .badge .card::before {
    content: '';
    justify-self: center;
    width: 2.6cqw;
    height: 0.6cqw;
    margin-bottom: 0.6cqw;
    border-radius: 999px;
    background: #d6d1c6;
  }
  .badge .logo {
    height: 1.6cqw;
    background: #121016;
    -webkit-mask: url(/logos/jpmorganchase.svg) left center / contain no-repeat;
    mask: url(/logos/jpmorganchase.svg) left center / contain no-repeat;
  }
  .badge .who {
    margin-top: 1.2cqw;
    font: 650 1.45cqw/1.1 var(--font-display);
  }
  .badge .role {
    font-size: 0.75cqw;
    color: #5b3df5;
  }
  .badge .bars {
    height: 2cqw;
    margin-top: auto;
    background: repeating-linear-gradient(90deg, #121016 0 2px, transparent 2px 4px, #121016 4px 5px, transparent 5px 8px);
  }

  /* polaroid */
  .polaroid {
    display: grid;
    gap: 0.8cqw;
    padding: 1cqw 1cqw 1.6cqw;
    background: #f6f4ef;
    color: #121016;
    border-radius: 0.3cqw;
  }
  .polaroid .pic {
    display: block;
  }
  .polaroid .pic :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .polaroid .hand {
    font-size: 1.2cqw;
    text-align: center;
  }
  .polaroid .tag {
    color: var(--accent-ink);
  }

  /* diploma */
  .diploma .paper {
    position: relative;
    display: grid;
    gap: 0.7cqw;
    padding: 2.2cqw 2.4cqw;
    aspect-ratio: 11 / 8;
    align-content: center;
    background:
      linear-gradient(#f3eee2, #ebe4d4);
    color: #2a2530;
    border: 0.5cqw double #c9bd9c;
    border-radius: 0.3cqw;
  }
  .diploma .dk {
    font-size: 0.85cqw;
    letter-spacing: 0.2em;
    color: #8a7a52;
  }
  .diploma .dt {
    font: 650 1.6cqw/1.15 var(--font-display);
  }
  .diploma .dt.sm {
    font-size: 1.15cqw;
    font-weight: 500;
  }
  .diploma .seal {
    position: absolute;
    right: 1.6cqw;
    top: 1.4cqw;
    width: 3.4cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #6b4ff7 40%, #4a32c9 41% 60%, #6b4ff7 61%);
    box-shadow: 0 0 0 0.3cqw rgb(107 79 247 / 0.25);
  }

  /* phone */
  .phone .glass {
    display: grid;
    align-content: start;
    gap: 1cqw;
    aspect-ratio: 9 / 18.5;
    padding: 1.6cqw 0.8cqw;
    border: 0.45cqw solid #26232d;
    border-radius: 1.8cqw;
    background: radial-gradient(circle at 50% 0%, #4a37b8, #120e22 70%);
    color: #fff;
  }
  .phone .time {
    text-align: center;
    font: 600 2.2cqw/1 var(--font-display);
  }
  .phone .notif {
    padding: 0.7cqw;
    border-radius: 0.8cqw;
    background: rgb(255 255 255 / 0.16);
    font-size: 0.75cqw;
    line-height: 1.35;
  }
  .phone .notif b {
    display: block;
  }

  /* notebook */
  .notebook .page {
    display: grid;
    align-content: start;
    gap: 1.2cqw;
    aspect-ratio: 4 / 3;
    padding: 2cqw 1.6cqw 1.6cqw 3cqw;
    border-radius: 0.4cqw;
    background:
      linear-gradient(90deg, transparent 2.2cqw, rgb(255 120 120 / 0.5) 2.2cqw 2.3cqw, transparent 2.3cqw),
      repeating-linear-gradient(transparent 0 1.6cqw, rgb(90 110 200 / 0.25) 1.6cqw calc(1.6cqw + 1px)),
      #f4f1ea;
    color: #2b2633;
  }
  .notebook .hand {
    font-size: 1.3cqw;
  }
  .notebook .faint {
    opacity: 0.55;
  }

  /* mug (from above) */
  .mug .rim {
    display: block;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0.9cqw solid #e9e4da;
    background: radial-gradient(circle at 40% 40%, #6b4630, #2e1c12 70%);
    box-shadow: 2.4cqw 0.6cqw 0 -1.6cqw #e9e4da;
  }

  /* sticky note */
  .sticky {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0.8cqw;
    background: #c9bbff;
    color: #1c1240;
    text-align: center;
  }
  .sticky .hand {
    font-size: 1.5cqw;
    line-height: 1.2;
  }
  .sticky small {
    font-size: 1cqw;
    opacity: 0.7;
  }

  /* sheets: the object's story, slid up over the desk */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .scrim.on {
    opacity: 1;
  }
  .sheet {
    position: fixed;
    left: 50%;
    bottom: 0;
    z-index: 80;
    width: min(1200px, 100vw);
    max-height: calc(100svh - 40px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 28px 28px 0 0;
    background: var(--bg);
    translate: -50% 102%;
    transition: translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sheet.on {
    translate: -50% 0;
  }
  .sheet-top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px clamp(16px, 4vw, 40px);
    background: color-mix(in oklch, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .sheet-top .mono {
    margin: 0;
  }
  .close {
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 500 0.85rem/1 var(--font-body);
    cursor: pointer;
  }
  .close:hover {
    border-color: var(--accent);
  }
  .sheet-body :global(section) {
    border-top: 0 !important;
    padding-top: 40px !important;
  }

  /* phones: the whole desk scales down as one picture; tap anything */
  @media (max-width: 700px) {
    .desk {
      width: 100%;
    }
    .tag {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>

<script>
  import { whoosh, tick, soft } from '../../../scripts/sound';

  const desk = document.querySelector<HTMLElement>('[data-desk]')!;
  const scrim = document.querySelector<HTMLElement>('[data-scrim]')!;
  const objs = [...desk.querySelectorAll<HTMLElement>('.obj')];
  let openSheet: HTMLElement | null = null;
  let opener: HTMLElement | null = null;

  objs.forEach((o, i) => o.addEventListener('pointerenter', () => tick(0.3 + (i % 5) * 0.12, 0.04)));

  // a little parallax: things nearer the camera move more
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('pointermove', (e) => {
      if (openSheet) return;
      const dx = e.clientX / innerWidth - 0.5;
      const dy = e.clientY / innerHeight - 0.5;
      objs.forEach((o) => {
        const d = Number(o.dataset.depth || 1);
        o.style.setProperty('--px', `${(-dx * d * 8).toFixed(1)}px`);
        o.style.setProperty('--py', `${(-dy * d * 8).toFixed(1)}px`);
      });
    });
  }

  const close = () => {
    if (!openSheet) return;
    const s = openSheet;
    openSheet = null;
    s.classList.remove('on');
    scrim.classList.remove('on');
    soft({ up: false });
    setTimeout(() => {
      s.hidden = true;
      scrim.hidden = true;
    }, 600);
    opener?.focus({ preventScroll: true });
  };

  const open = (id: string, from: HTMLElement) => {
    const s = document.querySelector<HTMLElement>(`[data-sheet="${id}"]`);
    if (!s) return;
    opener = from;
    openSheet = s;
    scrim.hidden = false;
    s.hidden = false;
    s.scrollTop = 0;
    dispatchEvent(new Event('resize'));
    void s.offsetWidth; // commit the hidden state first, so the slide-up transition runs
    s.classList.add('on');
    scrim.classList.add('on');
    whoosh({ dur: 0.7, from: 400, to: 2200, gain: 0.22, pan: false });
    s.querySelector<HTMLElement>('[data-close]')?.focus({ preventScroll: true });
  };

  objs.forEach((o) =>
    o.addEventListener('click', () => {
      if (o.dataset.open) open(o.dataset.open, o);
      else if (o.dataset.toast) {
        soft();
        dispatchEvent(new CustomEvent('toast', { detail: o.dataset.toast }));
      }
    }),
  );
  scrim.addEventListener('click', close);
  document.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
  addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>
