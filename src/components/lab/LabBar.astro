---
// Shared top bar for the free-roam prototypes (lab only, removed before merge)
import ThemeToggle from '../ThemeToggle.astro';
import SoundToggle from '../SoundToggle.astro';
import { links } from '../../data/site';

interface Props {
  current: 'canvas' | 'paths' | 'desk';
}
const { current } = Astro.props;
const demos = [
  { id: 'canvas', label: 'A · Canvas', href: '/lab/roam/canvas' },
  { id: 'paths', label: 'B · Paths', href: '/lab/roam/paths' },
  { id: 'desk', label: 'C · Desk', href: '/lab/roam/desk' },
];
---

<header class="labbar">
  <a class="brand" href="/lab/roam" aria-label="All demos">
    <svg viewBox="0 0 40 20" aria-hidden="true"><path d="M1 10h5l3-7 5 14 5-16 5 15 4-9 3 3h8"></path></svg>
    <span>Kalash Jain</span>
  </a>
  <nav class="demos" aria-label="Demos">
    {demos.map((d) => <a href={d.href} aria-current={d.id === current ? 'page' : undefined}>{d.label}</a>)}
  </nav>
  <div class="tools">
    <a class="skim" href="/" title="The classic single scroll">Skim mode</a>
    <a class="btn btn-small" href={links.resume} download>Resume ↓</a>
    <SoundToggle />
    <ThemeToggle />
  </div>
</header>

<style>
  .labbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
    padding: 0 clamp(12px, 3vw, 28px);
    background: color-mix(in oklch, var(--bg) 70%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .brand svg {
    width: 28px;
    height: 14px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .demos {
    display: flex;
    gap: 4px;
    margin: 0 auto;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .demos a {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--muted);
    font: 500 0.8rem/1 var(--font-mono);
    text-decoration: none;
  }
  .demos a[aria-current='page'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .skim {
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media (max-width: 760px) {
    .brand span,
    .skim {
      display: none;
    }
    .tools .btn {
      display: none;
    }
    .demos a {
      padding: 6px 8px;
      font-size: 0.7rem;
    }
  }
</style>

<script>
  import { unlock, wanted } from '../../scripts/sound';
  // no enter screen in the lab: the first click or key unlocks sound (if it's switched on)
  const go = () => wanted() && unlock();
  addEventListener('click', go, { once: true, capture: true });
  addEventListener('keydown', go, { once: true, capture: true });
</script>
