<!--
  Lab version of the critter: it lives on the bottom edge of the screen and roams.
  It wanders to random spots, sits a while, glances at the cursor, and if your
  cursor rests near the bottom it ambles over. Click it for a one-liner.
-->
<div class="roamer" data-roamer aria-hidden="true">
  <div class="body">
    <svg viewBox="0 0 100 100">
      <g class="ear ear-l">
        <path class="fill" d="M20 48 L18 23 Q19 19 23 21 L42 37 Z"></path>
        <path class="inner" d="M23 42 L22 28 L34 37 Z"></path>
      </g>
      <g class="ear ear-r">
        <path class="fill" d="M80 48 L82 23 Q81 19 77 21 L58 37 Z"></path>
        <path class="inner" d="M77 42 L78 28 L66 37 Z"></path>
      </g>
      <rect class="fill" x="9" y="33" width="82" height="65" rx="19"></rect>
      <rect class="sheen" x="9" y="33" width="82" height="22" rx="19"></rect>
      <g class="eyes">
        <rect class="eye" x="30" y="55" width="9" height="5.5" rx="2.75"></rect>
        <rect class="eye" x="61" y="55" width="9" height="5.5" rx="2.75"></rect>
      </g>
      <g class="glasses">
        <rect class="lens" x="23" y="49" width="23" height="16" rx="5"></rect>
        <rect class="lens" x="54" y="49" width="23" height="16" rx="5"></rect>
        <path class="frame" d="M46 55 Q50 52 54 55 M23 55 L10 52 M77 55 L90 52"></path>
      </g>
      <g class="paw paw-l">
        <circle class="paw-fill" cx="22" cy="86" r="4.4"></circle>
        <circle class="paw-fill" cx="29.5" cy="84.5" r="4.6"></circle>
        <circle class="paw-fill" cx="37" cy="86" r="4.4"></circle>
      </g>
      <g class="paw paw-r">
        <circle class="paw-fill" cx="63" cy="86" r="4.4"></circle>
        <circle class="paw-fill" cx="70.5" cy="84.5" r="4.6"></circle>
        <circle class="paw-fill" cx="78" cy="86" r="4.4"></circle>
      </g>
    </svg>
  </div>
</div>

<style>
  .roamer {
    --x: 70vw;
    --accent: oklch(0.72 0.16 285);
    --px: 0px;
    --py: 0px;
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 40;
    width: 56px;
    height: 56px;
    translate: var(--x) 12%;
    cursor: pointer;
    transition: translate var(--dur, 0s) linear;
  }
  .body {
    width: 100%;
    height: 100%;
    transition: translate 0.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .roamer:hover .body {
    translate: 0 -10%;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fill {
    fill: var(--accent);
  }
  .sheen {
    fill: oklch(1 0 0 / 0.08);
  }
  .inner {
    fill: color-mix(in oklch, var(--accent) 60%, white);
  }
  .paw-fill {
    fill: color-mix(in oklch, var(--accent) 78%, white);
  }
  .eyes {
    fill: oklch(0.18 0.04 285);
    translate: var(--px) var(--py);
    transition: translate 0.25s ease-out;
  }
  .eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 6s infinite;
  }
  .lens {
    fill: oklch(1 0 0 / 0.1);
    stroke: oklch(0.18 0.04 285);
    stroke-width: 2.4;
  }
  .frame {
    fill: none;
    stroke: oklch(0.18 0.04 285);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .ear {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .ear-l {
    animation: twitch 8s ease-in-out infinite;
  }
  .ear-r {
    animation: twitch 8s ease-in-out 3.7s infinite;
  }
  .paw {
    transform-box: fill-box;
  }
  .walking .paw-l {
    animation: step 0.34s ease-in-out infinite;
  }
  .walking .paw-r {
    animation: step 0.34s ease-in-out 0.17s infinite;
  }
  .walking svg {
    animation: bob 0.34s ease-in-out infinite;
  }
  .walking .eye {
    animation: none;
    scale: 1 0.6;
  }
  .sitting .body {
    translate: 0 6%;
  }
  .boop svg {
    animation: boop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes blink {
    0%,
    93%,
    100% {
      scale: 1 1;
    }
    96% {
      scale: 1 0.12;
    }
  }
  @keyframes twitch {
    0%,
    90%,
    100% {
      rotate: 0deg;
    }
    93% {
      rotate: -6deg;
    }
  }
  @keyframes step {
    50% {
      translate: 0 -3px;
    }
  }
  @keyframes bob {
    50% {
      rotate: 1.2deg;
    }
  }
  @keyframes boop {
    40% {
      scale: 1.1 0.9;
    }
    70% {
      scale: 0.96 1.05;
    }
  }
  @media (max-width: 700px) {
    .roamer {
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .roamer {
      display: none;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-roamer]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const quips = [
      "I'm the intern's intern.",
      'git blame me. I dare you.',
      "Kalash calls me scope creep. I'm staying.",
      'Try typing `sudo hire kalash` up top.',
      'I review PRs by sitting on the keyboard.',
      'Fun fact: there is a 404 page. It is a Jira ticket.',
    ];
    let q = 0;
    let x = innerWidth * 0.7;
    let timer = 0;
    let mouse = { x: -1, y: -1, t: 0 };
    const SPEED = 70; // px per second: an amble, not a sprint

    const setX = (nx: number) => {
      const max = innerWidth - el.offsetWidth - 12;
      nx = Math.max(12, Math.min(max, nx));
      const dist = Math.abs(nx - x);
      const dir = Math.sign(nx - x) || 1;
      el.style.setProperty('--dur', `${dist / SPEED}s`);
      el.style.setProperty('--px', `${dir * 2.2}px`);
      el.classList.remove('sitting');
      el.classList.toggle('walking', dist > 4);
      x = nx;
      el.style.setProperty('--x', `${x}px`);
      return dist / SPEED;
    };

    function next() {
      clearTimeout(timer);
      const restingNearBottom = mouse.y > innerHeight - 220 && performance.now() - mouse.t > 1500;
      const target = restingNearBottom
        ? mouse.x - el.offsetWidth / 2
        : Math.random() * (innerWidth - 120) + 40;
      const secs = setX(target);
      timer = window.setTimeout(() => {
        el.classList.remove('walking');
        el.classList.add('sitting');
        // sit a while (longer most of the time), then wander again
        timer = window.setTimeout(next, 2500 + Math.random() * 5000);
      }, secs * 1000);
    }

    el.style.setProperty('--x', `${x}px`);
    timer = window.setTimeout(next, 2200);

    addEventListener(
      'pointermove',
      (e) => {
        mouse = { x: e.clientX, y: e.clientY, t: performance.now() };
        if (el.classList.contains('walking')) return;
        // glance at the cursor while idle
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const len = Math.hypot(dx, dy) || 1;
        el.style.setProperty('--px', `${(dx / len) * 2.4}px`);
        el.style.setProperty('--py', `${(dy / len) * 1.6}px`);
      },
      { passive: true },
    );

    el.addEventListener('click', () => {
      el.classList.remove('boop');
      void el.offsetWidth;
      el.classList.add('boop');
      dispatchEvent(new CustomEvent('toast', { detail: quips[q++ % quips.length] }));
    });
    addEventListener('resize', () => setX(Math.min(x, innerWidth - 80)));
  }
</script>
