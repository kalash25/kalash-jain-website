<button class="theme-toggle" type="button" aria-label="Switch to light mode" data-theme-toggle>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    transform: rotate(-12deg);
  }
  .icon {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  /* Dark mode shows the sun (the mode you'd switch to), light shows the moon */
  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    btn?.setAttribute('aria-label', `Switch to ${next} mode`);
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    dispatchEvent(
      new CustomEvent('toast', {
        detail: next === 'light' ? 'Light mode. Bold choice ☀︎' : 'Welcome back to the dark side',
      }),
    );
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
</script>
