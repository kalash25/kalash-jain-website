---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-dark.webp';
import { links, stickers } from '../data/site';

const name = 'Kalash Jain';
const letters = [...name];
---

<section class="hero" id="top" data-hero>
  <div class="copy">
    <p class="mono eyebrow reveal" style="--d:0">
      UCLA Anderson MBA '28 <span class="accent">·</span> ex-JPMorgan Chase
    </p>

    <div class="name-block">
      <h1 class="name" aria-label={name} data-name>
        {
          letters.map((ch, i) => (
            <span class="letter-mask" aria-hidden="true">
              <span class="letter" style={`--i:${i}`}>
                {ch === ' ' ? ' ' : ch}
              </span>
            </span>
          ))
        }
      </h1>
      <svg class="wave" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
        <path data-wave d="M0 60 L1000 60"></path>
      </svg>
    </div>

    <p class="line reveal" style="--d:1">
      Product thinker<br />
      <em>with an engineer's toolkit.</em>
    </p>

    <div class="lede reveal" style="--d:2">
      <p>
        I spent three years as a software engineer at JPMorgan Chase, building testing and
        automation tools and getting the teams who used them on board. At UCLA Anderson, I'm focused
        on product management in tech, media and creative tools.
      </p>
      <p>Off the clock: published poet, musician, and builder of small apps with AI.</p>
    </div>

    <div class="ctas reveal" style="--d:3">
      <a class="btn btn-primary" href="#experience" data-magnetic
        >See my experience <span aria-hidden="true">↓</span></a
      >
      <a class="btn" href={links.resume} download data-magnetic>Download resume</a>
    </div>

    <p class="status mono reveal" style="--d:4">
      <span class="dot" aria-hidden="true"></span>
      Recruiting for Summer '27 PM internships
    </p>
  </div>

  <div class="media">
    <div class="frame">
      <div class="tilt" data-tilt>
      <figure class="photo">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[360, 560, 820]}
          sizes="(max-width: 820px) 70vw, 420px"
          alt="Portrait of Kalash Jain"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <svg class="slither" data-slither aria-hidden="true">
        <path></path>
        <path></path>
        <path></path>
      </svg>
      </div>

      <div class="sheet" aria-hidden="true">
        {
          stickers.map((s, i) => (
            <span class={`sticker s${i + 1}`} style={`--i:${i}`} data-sticker>
              {s}
            </span>
          ))
        }
      </div>
    </div>
    <p class="hint mono" aria-hidden="true">(go on, drag them anywhere)</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    min-height: 100svh;
    max-width: 1320px;
    margin: 0 auto;
    padding: 112px var(--gutter) 72px;
    /* stickers can be dragged past the edge; never let that cause sideways scroll */
    overflow-x: clip;
  }

  .accent {
    color: var(--accent);
  }

  /* ---------- name + waveform ---------- */
  .name-block {
    display: inline-flex;
    flex-direction: column;
    max-width: 100%;
    margin: 14px 0 22px;
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(3rem, 8.4vw, 7.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .letter-mask {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.06em;
  }
  .letter {
    --h: 0;
    display: inline-block;
    translate: 0 calc(var(--h) * -0.1em);
    color: color-mix(in oklch, var(--accent) calc(var(--h) * 100%), var(--ink));
  }
  :global(.js.intro-done) .letter {
    transition:
      transform 0.9s var(--ease-out) calc(var(--i) * 38ms),
      translate 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  .wave {
    display: block;
    width: 100%;
    height: clamp(34px, 5vw, 64px);
    margin-top: 4px;
    overflow: visible;
    cursor: crosshair;
  }
  .wave path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* ---------- positioning ---------- */
  .line {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 48;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
  .line em {
    font-style: normal;
    color: var(--accent);
  }
  .lede {
    max-width: 54ch;
    margin: 0 0 28px;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    color: var(--muted);
  }
  .lede p {
    margin: 0 0 10px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 26px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    line-height: 1.4;
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 var(--accent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  /* ---------- photo + stickers ---------- */
  .media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .frame {
    position: relative;
    width: min(100%, 400px);
  }
  /* Purple strokes that snake around the photo during the intro, then vanish */
  .slither {
    position: absolute;
    inset: -14px;
    width: calc(100% + 28px);
    height: calc(100% + 28px);
    overflow: visible;
    pointer-events: none;
    filter: drop-shadow(0 0 6px color-mix(in oklch, var(--accent) 70%, transparent));
  }
  .slither path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0;
  }
  .tilt {
    position: relative;
    --rx: 0deg;
    --ry: 0deg;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s var(--ease-out);
  }
  .photo {
    will-change: opacity, transform;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 22px;
    background: var(--surface);
    box-shadow:
      0 30px 60px -24px oklch(0 0 0 / 0.55),
      0 0 0 1px color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .sticker {
    --x: 0px;
    --y: 0px;
    --lift: 1;
    position: absolute;
    z-index: 2;
    padding: 9px 14px;
    border-radius: 12px;
    font-weight: 550;
    font-size: 0.85rem;
    line-height: 1;
    white-space: nowrap;
    cursor: grab;
    user-select: none;
    touch-action: none;
    translate: var(--x) var(--y);
    rotate: var(--r);
    scale: var(--lift);
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 10px 24px -10px oklch(0 0 0 / 0.5);
    transition:
      scale 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .sheet {
    position: relative;
    height: 108px;
    margin-top: 20px;
  }
  .sticker.s1 {
    --r: -6deg;
    top: 4px;
    left: 0;
  }
  .sticker.s2 {
    --r: 4deg;
    top: 0;
    left: 46%;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .sticker.s3 {
    --r: 3deg;
    top: 56px;
    left: 9%;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .sticker.s4 {
    --r: -5deg;
    top: 52px;
    left: 55%;
  }
  .sticker:hover {
    --lift: 1.05;
  }
  .sticker:global(.dragging) {
    --lift: 1.1;
    z-index: 3;
    cursor: grabbing;
    box-shadow: 0 22px 40px -14px oklch(0 0 0 / 0.6);
  }

  .hint {
    margin: 0;
    font-size: 0.66rem;
  }

  /* ---------- intro choreography ---------- */
  :global(.js) .letter {
    transform: translateY(150%);
    transition: transform 0.9s var(--ease-out);
    transition-delay: calc(var(--i) * 38ms);
  }
  :global(.js) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(0.25s + var(--d) * 0.1s);
  }
  :global(.js) .eyebrow.reveal {
    transition-delay: 0s;
  }
  :global(.js) .photo {
    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: 0.15s;
  }
  /* Stickers pop on one by one, only after the photo has fully landed */
  :global(.js) .sticker {
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s var(--ease-out);
    transition-delay: calc(1.05s + var(--i) * 0.14s);
  }
  :global(.js) .hint {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out) 1.8s;
  }
  :global(.js.intro-done) .letter,
  :global(.js.intro-done) .reveal,
  :global(.js.intro-done) .photo {
    opacity: 1;
    transform: none;
  }
  :global(.js.intro-done) .sticker {
    opacity: 1;
    scale: var(--lift);
  }
  :global(.js.intro-done) .sticker:global(.settled) {
    transition-delay: 0s;
  }
  :global(.js.intro-done) .sticker:global(.homing) {
    transition:
      translate 0.65s cubic-bezier(0.34, 1.4, 0.64, 1),
      scale 0.25s var(--ease-out);
  }
  :global(.js.intro-done) .hint {
    opacity: 1;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 100px;
      min-height: auto;
    }
    .media {
      order: -1;
      align-items: flex-start;
      padding-left: 6%;
    }
    .frame {
      width: min(62vw, 280px);
    }
    .sticker {
      font-size: 0.72rem;
      padding: 7px 11px;
    }
    .sheet {
      width: min(86vw, 340px);
      height: 92px;
    }
    .sticker.s2 {
      left: 50%;
    }
    .sticker.s3 {
      top: 48px;
      left: 4%;
    }
    .sticker.s4 {
      top: 46px;
      left: 52%;
    }
    .name-block {
      margin-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>

<script>
  /* ---------------------------------------------------------------
     Waveform intro
     1. A flat line draws across and swells into an audio-like wave.
     2. The name rises out of its mask as the wave peaks; the rest follows.
     3. The wave settles to a quiet idle and leans toward the cursor.
     Click or any key skips. Reduced motion: static and instant.
  ---------------------------------------------------------------- */
  const root = document.documentElement;
  const path = document.querySelector<SVGPathElement>('[data-wave]');
  const svg = path?.ownerSVGElement;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const W = 1000;
  const MID = 60;
  const N = 180;
  const INTRO_MS = 1900;
  const REVEAL_AT = 560; // name rises as the wave finishes drawing
  const IDLE_AMP = 0.14;

  let start = performance.now();
  let revealed = false;
  let pointerX = -1;
  let pointerAmp = 0;
  let pulse = 0;
  let raf = 0;
  let heroVisible = true;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  function reveal() {
    if (revealed) return;
    revealed = true;
    root.classList.add('intro-done');
    dispatchEvent(new Event('intro:done'));
  }

  function skip(e: Event) {
    if ((e.target as Element)?.closest?.('[data-sticker]')) return;
    if (performance.now() - start >= INTRO_MS) return;
    start = performance.now() - INTRO_MS;
    reveal();
  }

  function shape(t: number, amp: number, drawn: number) {
    let d = '';
    const last = Math.max(1, Math.round(N * drawn));
    for (let i = 0; i <= last; i++) {
      const x = i / N;
      const env = Math.pow(Math.sin(Math.PI * x), 1.4);
      const s =
        Math.sin(x * 38 + t * 0.0062) * 0.5 +
        Math.sin(x * 91 - t * 0.0094) * 0.3 +
        Math.sin(x * 17 + t * 0.0031) * 0.2;
      let a = amp + pulse * env;
      if (pointerX >= 0) a += pointerAmp * Math.exp(-Math.pow((x - pointerX) / 0.09, 2));
      const y = MID - s * env * a * (MID - 6);
      d += `${i === 0 ? 'M' : 'L'}${(x * W).toFixed(1)} ${y.toFixed(1)}`;
    }
    return d;
  }

  function frame(now: number) {
    const e = now - start;
    let amp = IDLE_AMP;
    let drawn = 1;
    if (e < INTRO_MS) {
      drawn = easeOut(clamp(e / 500));
      const swell = easeOut(clamp((e - 250) / 550));
      const settle = clamp((e - 1100) / 800);
      amp = swell * (1 - settle) + IDLE_AMP * settle;
      if (e >= REVEAL_AT) reveal();
    } else reveal();

    pointerAmp += ((pointerX >= 0 ? 0.85 : 0) - pointerAmp) * 0.08;
    pulse *= 0.94;
    path!.setAttribute('d', shape(now, amp, drawn));

    // Stop drawing once the hero is off screen and the intro is over
    if (heroVisible || e < INTRO_MS) raf = requestAnimationFrame(frame);
    else raf = 0;
  }
  const run = () => {
    if (!raf && !document.hidden) raf = requestAnimationFrame(frame);
  };

  // Content must never wait on animation frames
  setTimeout(reveal, INTRO_MS);

  if (path && svg) {
    if (reduce) {
      path.setAttribute('d', shape(0, IDLE_AMP, 1));
      reveal();
    } else {
      // Start once the display font is in (max 0.5s), so the name never swaps mid-animation
      Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 500))]).then(() => {
        start = performance.now();
        run();
      });
      addEventListener('keydown', skip, { once: true });
      addEventListener('pointerdown', skip, { once: true });

      hero.addEventListener('pointermove', (ev) => {
        const r = svg.getBoundingClientRect();
        const x = (ev.clientX - r.left) / r.width;
        const nearY = ev.clientY > r.top - 80 && ev.clientY < r.bottom + 80;
        pointerX = nearY && x >= -0.05 && x <= 1.05 ? clamp(x) : -1;
      });
      hero.addEventListener('pointerleave', () => (pointerX = -1));
      svg.addEventListener('click', () => (pulse = 0.8));

      new IntersectionObserver(([e]) => {
        heroVisible = e.isIntersecting;
        if (heroVisible) run();
      }).observe(hero);

      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(raf);
        raf = 0;
        run();
      });
    }
  } else reveal();

  /* ---------------------------------------------------------------
     Draggable stickers: pick one up and drop it anywhere in the hero.
  ---------------------------------------------------------------- */
  document.querySelectorAll<HTMLElement>('[data-sticker]').forEach((el) => {
    let x = 0;
    let y = 0;
    let sx = 0;
    let sy = 0;
    let bounds = { minX: 0, maxX: 0, minY: 0, maxY: 0 };

    // Once it has popped in, drop the entrance delay so hover/drag feel instant
    el.addEventListener('transitionend', () => el.classList.add('settled'), { once: true });

    el.addEventListener('pointerdown', (e) => {
      el.setPointerCapture(e.pointerId);
      el.classList.add('dragging', 'settled');
      sx = e.clientX - x;
      sy = e.clientY - y;
      // Allowed travel = from where it is now to each edge of the hero
      const h = hero.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      bounds = {
        minX: x - (r.left - h.left),
        maxX: x + (h.right - r.right),
        minY: y - (r.top - h.top),
        maxY: y + (h.bottom - r.bottom),
      };
    });
    el.addEventListener('pointermove', (e) => {
      if (!el.hasPointerCapture(e.pointerId)) return;
      x = Math.max(bounds.minX, Math.min(bounds.maxX, e.clientX - sx));
      y = Math.max(bounds.minY, Math.min(bounds.maxY, e.clientY - sy));
      el.style.setProperty('--x', `${x}px`);
      el.style.setProperty('--y', `${y}px`);
    });
    const drop = () => {
      el.classList.remove('dragging');
      // Dropped under the nav or off-screen? It can't be picked up there, so send it home
      const r = el.getBoundingClientRect();
      const navBottom = document.querySelector('[data-nav]')?.getBoundingClientRect().bottom ?? 64;
      if (r.top < navBottom + 4 || r.bottom > innerHeight || r.left < 0 || r.right > innerWidth) {
        x = 0;
        y = 0;
        el.classList.add('homing');
        el.style.setProperty('--x', '0px');
        el.style.setProperty('--y', '0px');
        setTimeout(() => el.classList.remove('homing'), 700);
        dispatchEvent(new CustomEvent('toast', { detail: 'Returned to sender ↩' }));
      }
    };
    el.addEventListener('pointerup', drop);
    el.addEventListener('pointercancel', drop);
  });

  /* ---------------------------------------------------------------
     Slithers: three strokes travel a gently wavy track around the photo,
     entering as it appears and fading out after the last sticker lands.
  ---------------------------------------------------------------- */
  const slither = document.querySelector<SVGSVGElement>('[data-slither]');
  function runSlithers() {
    if (!slither || reduce) return;
    const { width: w, height: h } = slither.getBoundingClientRect();
    if (!w || !h) return;
    slither.setAttribute('viewBox', `0 0 ${w} ${h}`);

    // Rounded-rectangle track just outside the photo, sampled into points
    const inset = 4;
    const rad = 34;
    const base = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    const x0 = inset, y0 = inset, x1 = w - inset, y1 = h - inset;
    base.setAttribute(
      'd',
      `M${x0 + rad} ${y0} H${x1 - rad} A${rad} ${rad} 0 0 1 ${x1} ${y0 + rad} V${y1 - rad} ` +
        `A${rad} ${rad} 0 0 1 ${x1 - rad} ${y1} H${x0 + rad} A${rad} ${rad} 0 0 1 ${x0} ${y1 - rad} ` +
        `V${y0 + rad} A${rad} ${rad} 0 0 1 ${x0 + rad} ${y0} Z`,
    );
    slither.appendChild(base);
    const L = base.getTotalLength();
    const steps = Math.round(L / 4);
    let d = '';
    for (let i = 0; i <= steps; i++) {
      const s = (i / steps) * L;
      const p = base.getPointAtLength(s);
      const q = base.getPointAtLength(Math.min(L, s + 1));
      const nx = -(q.y - p.y);
      const ny = q.x - p.x;
      const n = Math.hypot(nx, ny) || 1;
      const wob = Math.sin((s / L) * Math.PI * 2 * 14) * 3.2; // the "slither"
      d += `${i ? 'L' : 'M'}${(p.x + (nx / n) * wob).toFixed(1)} ${(p.y + (ny / n) * wob).toFixed(1)}`;
    }
    base.remove();

    const paths = [...slither.querySelectorAll('path')];
    const plan = [
      { start: 0.02, seg: 0.11, travel: 0.42, delay: 250, dur: 2800 },
      { start: 0.52, seg: 0.08, travel: 0.38, delay: 450, dur: 2650 },
      { start: 0.77, seg: 0.13, travel: 0.3, delay: 650, dur: 2450 },
    ];
    paths.forEach((path, i) => {
      const p = plan[i];
      path.setAttribute('d', d);
      const len = path.getTotalLength();
      path.style.strokeDasharray = `${p.seg * len} ${len}`;
      path.animate(
        [
          { strokeDashoffset: -p.start * len, opacity: 0 },
          { opacity: 1, offset: 0.15 },
          { opacity: 1, offset: 0.75 },
          { strokeDashoffset: -(p.start + p.travel) * len, opacity: 0 },
        ],
        { duration: p.dur, delay: p.delay, easing: 'cubic-bezier(0.45, 0, 0.25, 1)', fill: 'both' },
      );
    });
  }
  if (root.classList.contains('intro-done')) runSlithers();
  else addEventListener('intro:done', runSlithers, { once: true });

  /* Mouse-only touches: photo tilt, and name letters that lift near the cursor */
  if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const tilt = document.querySelector<HTMLElement>('[data-tilt]');
    tilt?.addEventListener('pointermove', (e) => {
      const r = tilt.getBoundingClientRect();
      tilt.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 10}deg`);
      tilt.style.setProperty('--rx', `${-((e.clientY - r.top) / r.height - 0.5) * 10}deg`);
    });
    tilt?.addEventListener('pointerleave', () => {
      tilt.style.setProperty('--rx', '0deg');
      tilt.style.setProperty('--ry', '0deg');
    });

    const name = document.querySelector<HTMLElement>('[data-name]');
    const letters = [...(name?.querySelectorAll<HTMLElement>('.letter') ?? [])];
    name?.addEventListener('pointermove', (e) => {
      for (const l of letters) {
        const r = l.getBoundingClientRect();
        const d = Math.abs(e.clientX - (r.left + r.width / 2)) / r.width;
        l.style.setProperty('--h', Math.max(0, 1 - d / 1.6).toFixed(2));
      }
    });
    name?.addEventListener('pointerleave', () =>
      letters.forEach((l) => l.style.setProperty('--h', '0')),
    );
  }
</script>
