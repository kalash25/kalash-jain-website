---
// A titled section with a scroll-drawn timeline. Used for Experience and Education.
import SectionHead from './SectionHead.astro';
import type { Entry } from '../data/site';
import { metricNotes } from '../data/site';

// Wrap the first known metric in a bullet with a peekable note (the Director's cut layer)
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
function annotate(text: string) {
  for (const [phrase, note] of Object.entries(metricNotes)) {
    const i = text.indexOf(phrase);
    if (i < 0) continue;
    return (
      esc(text.slice(0, i)) +
      `<span class="metric" tabindex="0" data-note="${esc(note)}">${esc(phrase)}</span>` +
      esc(text.slice(i + phrase.length)) +
      `<span class="dc-note" aria-hidden="true">✎ ${esc(note)}</span>`
    );
  }
  return esc(text);
}

interface Props {
  id: string;
  n: string;
  label: string;
  title: string;
  entries: Entry[];
}
const { id, n, label, title, entries } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-h`}>
  <SectionHead n={n} label={label} id={`${id}-h`} title={title} />

  <ol class="timeline" data-timeline>
    <span class="rail" aria-hidden="true"><span class="rail-fill" data-timeline-fill></span></span>
    {
      entries.map((e) => (
        <li class="entry">
          <span class:list={['dot', { current: e.current }]} data-timeline-dot aria-hidden="true" />
          <div class="meta">
            <span
              class="logo"
              role="img"
              aria-label={e.logo.alt}
              style={`--logo: url('${e.logo.src}'); aspect-ratio: ${e.logo.ratio};`}
            />
            {e.when && (
              <p class="when mono">
                {e.current && <span class="live">Current</span>}
                {e.when}
              </p>
            )}
            <p class="place mono">{e.place}</p>
          </div>

          <div class="body">
            <div data-reveal>
              <h3>{e.org}</h3>
              {e.roles && (
                <ol class="roles" aria-label="Roles, most recent first">
                  {e.roles.map((r, i) => (
                    <li class:list={{ latest: i === 0 }}>
                      <span class="role">{r.title}</span>
                      <span class="dates mono">{r.dates}</span>
                    </li>
                  ))}
                </ol>
              )}
              {e.summary && <p class="summary">{e.summary}</p>}
              {e.points && (
                <ul class="points">
                  {e.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </div>

            {e.groups?.map((g) => (
              <div class="group" data-reveal>
                <span class="dot sub" data-timeline-dot aria-hidden="true" />
                <h4 class="mono">{g.heading}</h4>
                <ul class="points">
                  {g.points.map((p) => (
                    <li set:html={annotate(p)} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 140px) var(--gutter);
    border-top: 1px solid var(--line);
  }

  .timeline {
    --rail-x: 220px;
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: var(--rail-x);
    width: 1px;
    background: var(--line);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--accent), color-mix(in oklch, var(--accent) 40%, transparent));
    transform-origin: top;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-x) minmax(0, 1fr);
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .entry:last-child {
    padding-bottom: 0;
  }

  .dot {
    position: absolute;
    top: 6px;
    left: calc(var(--rail-x) - 6px);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg);
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  .dot:global(.lit),
  .dot.current {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in oklch, var(--accent) 22%, transparent);
  }

  .meta {
    position: relative;
    z-index: 1;
    padding-right: 48px;
  }
  /* Logos drawn in one colour from the palette; they brighten on hover */
  .logo {
    display: block;
    height: 30px;
    max-width: 150px;
    background: var(--muted);
    -webkit-mask: var(--logo) left center / contain no-repeat;
    mask: var(--logo) left center / contain no-repeat;
    transform-origin: left center;
    transition:
      background-color 0.3s var(--ease-out),
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .meta:hover .logo {
    background: var(--ink);
    transform: scale(1.15);
  }
  .when {
    margin: 16px 0 4px;
    color: var(--ink);
  }
  .live {
    display: block;
    margin-bottom: 4px;
    color: var(--accent);
  }
  .place {
    margin: 0;
    font-size: 0.68rem;
  }

  .body {
    padding-left: 40px;
  }
  h3 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Roles stacked like the resume: title left, exact dates right */
  .roles {
    max-width: 720px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .roles li.latest {
    color: var(--ink);
  }
  .roles li.latest .role::after {
    content: 'Most recent';
    margin-left: 10px;
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--accent) 16%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 2px;
  }
  .dates {
    font-size: 0.7rem;
  }

  /* Resume sub-sections, each with its own dot on the rail */
  .group {
    position: relative;
    margin-top: clamp(28px, 3.5vw, 40px);
  }
  .dot.sub {
    top: 2px;
    left: calc(-40px - 6px);
    width: 11px;
    height: 11px;
  }
  h4 {
    margin: 0 0 8px;
    color: var(--accent);
    font-weight: 500;
  }

  .summary {
    max-width: 62ch;
    margin: 0 0 14px;
    font-size: 1.05rem;
  }
  .points {
    max-width: 66ch;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .points li {
    position: relative;
    padding: 6px 0 6px 22px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.95em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }

  /* Director's cut layer: metrics with the story behind them.
     (Injected via set:html, so these selectors are global.) */
  .points :global(.metric) {
    position: relative;
    color: var(--ink);
    text-decoration: underline dotted color-mix(in oklch, var(--accent) 70%, transparent);
    text-underline-offset: 4px;
    cursor: help;
    outline: none;
  }
  .points :global(.metric::after) {
    content: attr(data-note);
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    z-index: 5;
    width: max-content;
    max-width: min(320px, 70vw);
    padding: 8px 11px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.82rem;
    line-height: 1.35;
    white-space: normal;
    opacity: 0;
    translate: 0 4px;
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease-out),
      translate 0.2s var(--ease-out);
  }
  .points :global(.metric:hover::after),
  .points :global(.metric:focus-visible::after) {
    opacity: 1;
    translate: 0 0;
  }
  .points :global(.dc-note) {
    display: none;
  }
  :global(html.dc) .points :global(.metric) {
    text-decoration: underline wavy var(--accent);
    text-decoration-thickness: 1.5px;
  }
  :global(html.dc) .points :global(.metric::after) {
    display: none;
  }
  :global(html.dc) .points :global(.dc-note) {
    display: block;
    margin-top: 4px;
    color: var(--accent);
    font-style: italic;
    font-size: 0.92em;
  }

  @media (max-width: 760px) {
    .timeline {
      --rail-x: 6px;
    }
    .entry {
      grid-template-columns: 1fr;
      padding-left: 34px;
    }
    .dot {
      left: 0;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 16px;
      padding: 0 0 16px;
    }
    .logo {
      flex-basis: 100%;
      height: 24px;
      max-width: 150px;
    }
    .when {
      margin: 0;
    }
    .live {
      display: inline;
      margin-right: 8px;
    }
    .body {
      padding-left: 0;
    }
    .dot.sub {
      left: calc(-34px + 1px);
    }
  }
</style>
