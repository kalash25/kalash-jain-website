---
// ASCII splash intro, on every load:
// characters burst across the whole screen, crawl inward and assemble into the
// portrait, the photo resolves through them, then the curtain lifts.
// ~4s, click or any key to skip, skipped entirely for reduced motion.
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait-dark.webp';

const img = await getImage({ src: portrait, width: 640, format: 'webp' });

let wave = '';
for (let i = 0; i <= 120; i++) {
  const x = i / 120;
  const env = Math.pow(Math.sin(Math.PI * x), 1.4);
  const s = Math.sin(x * 38 + 1.2) * 0.5 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17 + 2) * 0.2;
  wave += `${i ? 'L' : 'M'}${(x * 1000).toFixed(1)} ${(30 - s * env * 22).toFixed(1)}`;
}
---

<div class="boot" data-boot-overlay aria-hidden="true">
  <canvas class="splash" data-boot-canvas></canvas>
  <div class="stage">
    <div class="frame" data-boot-frame>
      <img src={img.src} alt="" data-boot-img decoding="async" />
    </div>
    <svg class="wave" viewBox="0 0 1000 60" preserveAspectRatio="none"><path d={wave}></path></svg>
    <p class="status" data-boot-status>thinking in products</p>
  </div>
  <p class="skip">click anywhere to skip</p>
</div>

<!-- Runs immediately so the overlay is decided before first paint -->
<script is:inline>
  document.documentElement.dataset.boot = matchMedia('(prefers-reduced-motion: reduce)').matches
    ? 'skipped'
    : 'running';
</script>

<style>
  .boot {
    display: none;
  }
  :global(html.js[data-boot='running']) .boot {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: var(--bg);
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.8s cubic-bezier(0.76, 0, 0.24, 1);
    /* safety net: never block the page for more than 7s */
    animation: boot-away 0.01s 7s forwards;
  }
  :global(html.js[data-boot='running']) .boot.lift {
    clip-path: inset(0 0 100% 0);
  }
  @keyframes boot-away {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  .splash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 16px;
    translate: 0 -2vh;
  }
  .frame {
    position: relative;
    width: min(60vw, 42vh, 340px);
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .boot.resolve .frame img {
    opacity: 1;
  }
  .wave {
    width: min(72vw, 360px);
    height: 40px;
    overflow: visible;
  }
  .wave path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    transition: stroke-dashoffset 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.4s;
  }
  .boot.go .wave path {
    stroke-dashoffset: 0;
  }
  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .status::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: caret 0.8s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .skip {
    position: absolute;
    bottom: 22px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--muted);
    opacity: 0.7;
  }
</style>

<script>
  import { buildGrid, charFor, RAMP } from '../scripts/ascii';

  const root = document.documentElement;
  const boot = document.querySelector<HTMLElement>('[data-boot-overlay]');

  const finish = () => {
    root.dataset.boot = 'done';
    dispatchEvent(new Event('boot:done'));
    boot?.remove();
  };

  if (!boot || root.dataset.boot !== 'running') {
    boot?.remove();
    dispatchEvent(new Event('boot:done'));
  } else {
    const canvas = boot.querySelector<HTMLCanvasElement>('[data-boot-canvas]')!;
    const frame = boot.querySelector<HTMLElement>('[data-boot-frame]')!;
    const img = boot.querySelector<HTMLImageElement>('[data-boot-img]')!;
    const status = boot.querySelector<HTMLElement>('[data-boot-status]')!;
    const css = getComputedStyle(root);
    const accent = css.getPropertyValue('--accent').trim() || '#9f8cff';
    const light = root.dataset.theme === 'light';
    let lifted = false;
    let raf = 0;

    const lift = () => {
      if (lifted) return;
      lifted = true;
      cancelAnimationFrame(raf);
      boot.classList.add('resolve', 'lift');
      setTimeout(finish, 820);
    };
    addEventListener('pointerdown', lift, { once: true });
    addEventListener('keydown', lift, { once: true });
    setTimeout(lift, 6200); // hard cap even if the image is slow

    // Timeline (ms)
    const WORDS = 1050; // lines of product words stream across the screen...
    const BURST = 260; // ...shatter into stray characters that burst outward...
    const CRAWL_END = 2900; // ...and crawl home to build the portrait by here
    const HOLD = 350; // the finished ASCII portrait, a beat
    const RESOLVE = 600; // photo fades in through it, then the curtain lifts

    const WORD_BANK = [
      'roadmap', 'user research', 'PRD', 'north star', 'OKRs', 'A/B test', 'prioritize', 'ship it',
      'stakeholders', 'MVP', 'retention', 'discovery', 'jobs to be done', 'trade-offs', 'sprint',
      'metrics', 'launch', 'iterate', 'customer', 'why?', 'scope', 'backlog', 'insight', 'go-to-market',
    ];

    const run = async () => {
      if (lifted) return;
      const dpr = Math.min(2, devicePixelRatio || 1);
      const W = (canvas.width = innerWidth * dpr);
      const H = (canvas.height = innerHeight * dpr);
      const ctx = canvas.getContext('2d')!;
      const f = frame.getBoundingClientRect();
      const bitmap = await createImageBitmap(img).catch(() => null);
      const cols = innerWidth < 600 ? 36 : 46;
      const grid = buildGrid(bitmap ?? img, f.width, f.height, cols);
      const cw = (f.width / grid.cols) * dpr;
      const ch = (f.height / grid.rows) * dpr;
      const fontPx = Math.min(ch, cw * 1.7) * 0.92;
      const glyphs = RAMP.slice(1) + '/\\<>{}[]01';
      const mono = '"Geist Mono Variable", ui-monospace, monospace';
      const muted = css.getPropertyValue('--muted').trim() || '#999';

      /* Phase 1: rows of product words, alternating direction and speed */
      const rowPx = Math.max(13, Math.min(19, innerWidth / 70)) * dpr;
      const rowGap = rowPx * 2.1;
      const nRows = Math.ceil(H / rowGap) + 1;
      ctx.font = `${rowPx}px ${mono}`;
      const charW = ctx.measureText('M').width;
      const rows = Array.from({ length: nRows }, (_, r) => {
        const words = [...WORD_BANK].sort(() => Math.random() - 0.5);
        const text = (words.join('  ·  ') + '  ·  ').repeat(3);
        return {
          y: r * rowGap + rowGap * 0.3,
          text,
          width: text.length * charW / 3,
          speed: (0.06 + Math.random() * 0.1) * dpr * (r % 2 ? 1 : -1),
          phase: Math.random() * 2000,
          accent: Math.random() < 0.3,
        };
      });
      const rowX = (row: (typeof rows)[number], t: number) => {
        const off = ((row.phase + t) * row.speed) % row.width;
        return off > 0 ? off - row.width : off;
      };

      /* Phase 2 + 3: the portrait's characters, each starting from a letter in the word stream */
      type P = { sx: number; sy: number; vx: number; vy: number; tx: number; ty: number; d: number; dur: number; wob: number; c: string; a: number };
      const parts: P[] = [];
      for (let i = 0; i < grid.lums.length; i++) {
        const c = charFor(grid.lums[i], light, grid.focus[i]);
        if (c === ' ') continue;
        const w = light ? (1 - grid.lums[i]) * grid.focus[i] : grid.lums[i];
        parts.push({
          sx: 0, sy: 0, vx: 0, vy: 0,
          tx: f.left * dpr + (i % grid.cols) * cw,
          ty: f.top * dpr + Math.floor(i / grid.cols) * ch,
          d: WORDS + BURST + Math.random() * 450,
          dur: 750 + Math.random() * 450, // last one lands by ~2.96s
          wob: (Math.random() - 0.5) * 110 * dpr,
          c,
          a: 0.25 + w * 0.75,
        });
      }
      // when the words shatter, hand every particle the position of a real on-screen letter
      let leftovers: { x: number; y: number }[] = [];
      const shatter = () => {
        const letters: { x: number; y: number }[] = [];
        for (const row of rows) {
          const x0 = rowX(row, WORDS);
          for (let k = 0; k < row.text.length; k++) {
            const x = x0 + k * charW;
            if (x < -charW || x > W) continue;
            const chr = row.text[k];
            if (chr === ' ' || chr === '·') continue;
            letters.push({ x, y: row.y });
          }
        }
        letters.sort(() => Math.random() - 0.5);
        parts.forEach((p, i) => {
          const L = letters[i % Math.max(1, letters.length)] ?? { x: Math.random() * W, y: Math.random() * H };
          p.sx = L.x;
          p.sy = L.y;
          const ang = Math.random() * Math.PI * 2;
          const sp = (20 + Math.random() * 60) * dpr;
          p.vx = Math.cos(ang) * sp;
          p.vy = Math.sin(ang) * sp;
        });
        leftovers = letters.slice(parts.length); // extra letters just fizzle out
      };

      boot.classList.add('go');
      const t0 = performance.now();
      const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      let shattered = false;

      const step = (now: number) => {
        if (lifted) return;
        const t = now - t0;
        ctx.clearRect(0, 0, W, H);
        ctx.textBaseline = 'top';

        if (t < WORDS) {
          // the word stream fades in, then holds
          ctx.font = `${rowPx}px ${mono}`;
          const fade = Math.min(1, t / 250);
          for (const row of rows) {
            ctx.globalAlpha = (row.accent ? 0.85 : 0.5) * fade;
            ctx.fillStyle = row.accent ? accent : muted;
            ctx.fillText(row.text, rowX(row, t), row.y);
          }
        } else {
          if (!shattered) {
            shatter();
            shattered = true;
            status.textContent = 'assembling kalash-jain.com';
          }
          const sinceBurst = t - WORDS;
          const burst = Math.min(1, sinceBurst / BURST);
          ctx.font = `${fontPx}px ${mono}`;
          ctx.fillStyle = accent;
          for (const p of parts) {
            // the burst: letters scatter a little from where they were in the words
            const bx = p.sx + p.vx * burst;
            const by = p.sy + p.vy * burst;
            const k = Math.max(0, Math.min(1, (t - p.d) / p.dur));
            const e = ease(k);
            const wob = Math.sin(k * Math.PI * 2) * p.wob * (1 - k);
            const dx = p.tx - bx;
            const dy = p.ty - by;
            const len = Math.hypot(dx, dy) || 1;
            const x = bx + dx * e + (-dy / len) * wob;
            const y = by + dy * e + (dx / len) * wob;
            ctx.globalAlpha = k < 1 ? 0.6 : p.a;
            ctx.fillText(k < 1 ? glyphs[(Math.random() * glyphs.length) | 0] : p.c, x, y);
          }
          // letters that weren't needed fade away where they burst
          if (sinceBurst < 500) {
            ctx.globalAlpha = 0.5 * (1 - sinceBurst / 500);
            ctx.fillStyle = muted;
            for (const L of leftovers) ctx.fillText(glyphs[(Math.random() * glyphs.length) | 0], L.x, L.y);
          }
        }
        ctx.globalAlpha = 1;
        if (t < CRAWL_END + 150) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);

      // the beats after everything has landed
      setTimeout(() => (status.textContent = 'ready'), CRAWL_END - 200);
      setTimeout(() => boot.classList.add('resolve'), CRAWL_END + HOLD);
      setTimeout(lift, CRAWL_END + HOLD + RESOLVE);
    };

    const start = () => document.fonts.ready.then(run);
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }
</script>
