---
// ASCII splash intro, on every load:
// characters burst across the whole screen, crawl inward and assemble into the
// portrait, the photo resolves through them, then the curtain lifts.
// ~4s, click or any key to skip, skipped entirely for reduced motion.
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait-dark.webp';

const img = await getImage({ src: portrait, width: 640, format: 'webp' });

let wave = '';
for (let i = 0; i <= 120; i++) {
  const x = i / 120;
  const env = Math.pow(Math.sin(Math.PI * x), 1.4);
  const s = Math.sin(x * 38 + 1.2) * 0.5 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17 + 2) * 0.2;
  wave += `${i ? 'L' : 'M'}${(x * 1000).toFixed(1)} ${(30 - s * env * 22).toFixed(1)}`;
}
---

<div class="boot" data-boot-overlay aria-hidden="true">
  <canvas class="splash" data-boot-canvas></canvas>
  <div class="stage">
    <div class="frame" data-boot-frame>
      <img src={img.src} alt="" data-boot-img decoding="async" />
    </div>
    <svg class="wave" viewBox="0 0 1000 60" preserveAspectRatio="none"><path d={wave}></path></svg>
    <p class="status" data-boot-status>thinking in products</p>
  </div>
  <p class="skip">click anywhere to skip</p>
</div>

<!-- Runs immediately so the overlay is decided before first paint -->
<script is:inline>
  document.documentElement.dataset.boot = matchMedia('(prefers-reduced-motion: reduce)').matches
    ? 'skipped'
    : 'running';
</script>

<style>
  .boot {
    display: none;
  }
  :global(html.js[data-boot='running']) .boot {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: var(--bg);
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.8s cubic-bezier(0.76, 0, 0.24, 1);
    /* safety net: never block the page for more than 7s */
    animation: boot-away 0.01s 7s forwards;
  }
  :global(html.js[data-boot='running']) .boot.lift {
    clip-path: inset(0 0 100% 0);
  }
  @keyframes boot-away {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  .splash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 16px;
    translate: 0 -2vh;
  }
  .frame {
    position: relative;
    width: min(60vw, 42vh, 340px);
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .boot.resolve .frame img {
    opacity: 1;
  }
  .wave {
    width: min(72vw, 360px);
    height: 40px;
    overflow: visible;
  }
  .wave path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    transition: stroke-dashoffset 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.4s;
  }
  .boot.go .wave path {
    stroke-dashoffset: 0;
  }
  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .status::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: caret 0.8s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .skip {
    position: absolute;
    bottom: 22px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--muted);
    opacity: 0.7;
  }
</style>

<script>
  import { buildGrid, charFor, RAMP } from '../scripts/ascii';

  const root = document.documentElement;
  const boot = document.querySelector<HTMLElement>('[data-boot-overlay]');

  const finish = () => {
    root.dataset.boot = 'done';
    dispatchEvent(new Event('boot:done'));
    boot?.remove();
  };

  if (!boot || root.dataset.boot !== 'running') {
    boot?.remove();
    dispatchEvent(new Event('boot:done'));
  } else {
    const canvas = boot.querySelector<HTMLCanvasElement>('[data-boot-canvas]')!;
    const frame = boot.querySelector<HTMLElement>('[data-boot-frame]')!;
    const img = boot.querySelector<HTMLImageElement>('[data-boot-img]')!;
    const status = boot.querySelector<HTMLElement>('[data-boot-status]')!;
    const css = getComputedStyle(root);
    const accent = css.getPropertyValue('--accent').trim() || '#9f8cff';
    const light = root.dataset.theme === 'light';
    let lifted = false;
    let raf = 0;

    const lift = () => {
      if (lifted) return;
      lifted = true;
      cancelAnimationFrame(raf);
      boot.classList.add('resolve', 'lift');
      setTimeout(finish, 820);
    };
    addEventListener('pointerdown', lift, { once: true });
    addEventListener('keydown', lift, { once: true });
    setTimeout(lift, 6200); // hard cap even if the image is slow

    // Timeline (ms): one continuous take, no holds until the portrait is complete
    const SHATTER_START = 850; // words stream across the screen until here...
    const SHATTER_SPREAD = 520; // ...then break apart as a ripple out from the centre...
    const CRAWL_END = 2950; // ...while every character keeps moving and crawls home by here
    const HOLD = 350; // the finished ASCII portrait, a beat
    const RESOLVE = 600; // photo fades in through it, then the curtain lifts

    const WORD_BANK = [
      'roadmap', 'user research', 'PRD', 'north star', 'OKRs', 'A/B test', 'prioritize', 'ship it',
      'stakeholders', 'MVP', 'retention', 'discovery', 'jobs to be done', 'trade-offs', 'sprint',
      'metrics', 'launch', 'iterate', 'customer', 'why?', 'scope', 'backlog', 'insight', 'go-to-market',
    ];

    const run = async () => {
      if (lifted) return;
      const dpr = Math.min(2, devicePixelRatio || 1);
      const W = (canvas.width = innerWidth * dpr);
      const H = (canvas.height = innerHeight * dpr);
      const ctx = canvas.getContext('2d')!;
      const f = frame.getBoundingClientRect();
      const bitmap = await createImageBitmap(img).catch(() => null);
      const cols = innerWidth < 600 ? 36 : 46;
      const grid = buildGrid(bitmap ?? img, f.width, f.height, cols);
      const cw = (f.width / grid.cols) * dpr;
      const ch = (f.height / grid.rows) * dpr;
      const fontPx = Math.min(ch, cw * 1.7) * 0.92;
      const glyphs = RAMP.slice(1) + '/\\<>{}[]01';
      const mono = '"Geist Mono Variable", ui-monospace, monospace';
      const muted = css.getPropertyValue('--muted').trim() || '#999';
      const rnd = () => glyphs[(Math.random() * glyphs.length) | 0];

      /* The word stream: rows of product words, alternating direction and speed */
      const rowPx = Math.max(13, Math.min(19, innerWidth / 70)) * dpr;
      const rowGap = rowPx * 2.1;
      const nRows = Math.ceil(H / rowGap) + 1;
      ctx.font = `${rowPx}px ${mono}`;
      const charW = ctx.measureText('M').width;
      const rows = Array.from({ length: nRows }, (_, r) => {
        const words = [...WORD_BANK].sort(() => Math.random() - 0.5);
        const text = (words.join('  ·  ') + '  ·  ').repeat(3);
        return {
          y: r * rowGap + rowGap * 0.3,
          text,
          width: (text.length * charW) / 3,
          speed: (0.06 + Math.random() * 0.1) * dpr * (r % 2 ? 1 : -1), // px per ms
          phase: Math.random() * 2000,
          accent: Math.random() < 0.3,
        };
      });
      const rowX = (row: (typeof rows)[number], t: number) => {
        const off = ((row.phase + t) * row.speed) % row.width;
        return off > 0 ? off - row.width : off;
      };

      /* At the start of the shatter, every visible letter becomes its own particle.
         Each keeps its line's velocity, breaks apart when the ripple reaches it,
         and (if it's needed for the portrait) crawls to its cell. */
      type L = {
        x0: number; y: number; vx: number; ch: string; col: string; rowA: number;
        breakAt: number; bvx: number; bvy: number; glyph: string;
        // portrait target (absent for leftovers, which fade out)
        tx?: number; ty?: number; c?: string; a?: number; lag?: number; dur?: number; wob?: number;
      };
      let letters: L[] = [];
      const cxs = W / 2;
      const cys = (f.top + f.height / 2) * dpr;
      const maxD = Math.hypot(W, H) / 2;
      const prepare = () => {
        for (const row of rows) {
          const x0 = rowX(row, SHATTER_START);
          for (let k = 0; k < row.text.length; k++) {
            const x = x0 + k * charW;
            if (x < -charW * 2 || x > W + charW) continue;
            const chr = row.text[k];
            if (chr === ' ' || chr === '·') continue;
            const dist = Math.hypot(x - cxs, row.y - cys) / maxD;
            const ang = Math.random() * Math.PI * 2;
            const sp = (0.02 + Math.random() * 0.05) * dpr;
            letters.push({
              x0: x, y: row.y, vx: row.speed, ch: chr,
              col: row.accent ? accent : muted, rowA: row.accent ? 0.85 : 0.5,
              breakAt: SHATTER_START + Math.min(1, dist) * SHATTER_SPREAD + Math.random() * 90,
              bvx: Math.cos(ang) * sp, bvy: Math.sin(ang) * sp, glyph: rnd(),
            });
          }
        }
        // hand each portrait cell a letter (shuffled), so the image is built from the words
        letters.sort(() => Math.random() - 0.5);
        let j = 0;
        for (let i = 0; i < grid.lums.length; i++) {
          const c = charFor(grid.lums[i], light, grid.focus[i]);
          if (c === ' ') continue;
          let Lr = letters[j++];
          if (!Lr) {
            // more cells than letters (small screens): clone a random letter
            const src = letters[(Math.random() * letters.length) | 0];
            Lr = { ...src, glyph: rnd() };
            letters.push(Lr);
          }
          const w = light ? (1 - grid.lums[i]) * grid.focus[i] : grid.lums[i];
          Lr.tx = f.left * dpr + (i % grid.cols) * cw;
          Lr.ty = f.top * dpr + Math.floor(i / grid.cols) * ch;
          Lr.c = c;
          Lr.a = 0.25 + w * 0.75;
          Lr.lag = Math.random() * 180;
          Lr.wob = (Math.random() - 0.5) * 90 * dpr;
          // finish in time: whatever's left after it breaks, minus a little slack
          Lr.dur = Math.max(700, CRAWL_END - 60 - (Lr.breakAt + Lr.lag));
        }
      };

      boot.classList.add('go');
      const t0 = performance.now();
      const easeIn = (x: number) => x * x * x;
      const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const TAU = 380; // how long a letter keeps its line's momentum after breaking (ms)
      const endScale = fontPx / rowPx;
      let prepared = false;

      const step = (now: number) => {
        if (lifted) return;
        const t = now - t0;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, W, H);
        ctx.font = `${rowPx}px ${mono}`;
        ctx.textBaseline = 'top';

        if (t < SHATTER_START) {
          // the word stream fades in and flows
          const fade = Math.min(1, t / 250);
          for (const row of rows) {
            ctx.globalAlpha = (row.accent ? 0.85 : 0.5) * fade;
            ctx.fillStyle = row.accent ? accent : muted;
            ctx.fillText(row.text, rowX(row, t), row.y);
          }
        } else {
          if (!prepared) {
            prepare();
            prepared = true;
            status.textContent = 'assembling kalash-jain.com';
          }
          for (const p of letters) {
            const sinceStart = t - SHATTER_START;
            if (t < p.breakAt) {
              // still part of its word: keep flowing with the line
              ctx.globalAlpha = p.rowA;
              ctx.fillStyle = p.col;
              ctx.setTransform(1, 0, 0, 1, p.x0 + p.vx * sinceStart, p.y);
              ctx.fillText(p.ch, 0, 0);
              continue;
            }
            // broken off: momentum from the line decays smoothly (no stop, no jump)
            const u = t - p.breakAt;
            const bx = p.x0 + p.vx * (p.breakAt - SHATTER_START);
            const mom = TAU * (1 - Math.exp(-u / TAU));
            const sx = bx + (p.vx + p.bvx) * mom;
            const sy = p.y + p.bvy * mom;
            if (Math.random() < 0.25) p.glyph = rnd(); // a shimmer, not static noise

            if (p.tx === undefined) {
              // not needed for the portrait: drift and fade away
              const fadeOut = Math.max(0, 1 - u / 450);
              if (!fadeOut) continue;
              ctx.globalAlpha = 0.5 * fadeOut;
              ctx.fillStyle = muted;
              ctx.setTransform(1, 0, 0, 1, sx, sy);
              ctx.fillText(p.glyph, 0, 0);
              continue;
            }
            const k = Math.max(0, Math.min(1, (u - p.lag!) / p.dur!));
            // ease-in at the start keeps the hand-off from momentum seamless
            const e = k < 0.5 ? easeIn(k * 2) / 2 : easeInOut(k);
            const dx = p.tx - sx;
            const dy = p.ty! - sy;
            const len = Math.hypot(dx, dy) || 1;
            const wob = Math.sin(k * Math.PI * 2) * p.wob! * (1 - k);
            const x = sx + dx * e + (-dy / len) * wob;
            const y = sy + dy * e + (dx / len) * wob;
            const sc = 1 + (endScale - 1) * e; // shrink from word size to portrait size
            ctx.globalAlpha = k < 1 ? 0.55 + 0.25 * e : p.a!;
            ctx.fillStyle = accent;
            ctx.setTransform(sc, 0, 0, sc, x, y);
            ctx.fillText(k < 1 ? p.glyph : p.c!, 0, 0);
          }
        }
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.globalAlpha = 1;
        if (t < CRAWL_END + 120) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);

      // the beats after everything has landed
      setTimeout(() => (status.textContent = 'ready'), CRAWL_END - 150);
      setTimeout(() => boot.classList.add('resolve'), CRAWL_END + HOLD);
      setTimeout(lift, CRAWL_END + HOLD + RESOLVE);
    };

    const start = () => document.fonts.ready.then(run);
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }
</script>
