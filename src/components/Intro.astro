---
// ASCII splash intro, on every load:
// product words stream across the screen, shatter into characters that crawl in and
// assemble the portrait, then the curtain lifts. ~5s, click or any key to skip, skipped entirely for reduced motion.
// It opens on an enter screen: browsers only allow sound after a click or key press, and that
// press is what starts the show (with sound, or quietly).
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait-dark.webp';

const img = await getImage({ src: portrait, width: 640, format: 'webp' });

let wave = '';
for (let i = 0; i <= 120; i++) {
  const x = i / 120;
  const env = Math.pow(Math.sin(Math.PI * x), 1.4);
  const s = Math.sin(x * 38 + 1.2) * 0.5 + Math.sin(x * 91 - 0.7) * 0.3 + Math.sin(x * 17 + 2) * 0.2;
  wave += `${i ? 'L' : 'M'}${(x * 1000).toFixed(1)} ${(30 - s * env * 22).toFixed(1)}`;
}
---

<div class="boot" data-boot-overlay>
  <div class="gate" data-boot-gate>
    <p class="gate-kicker">Kalash Jain · a portfolio in one take</p>
    <p class="gate-title">Press anything<br />to begin.</p>
    <div class="gate-actions">
      <button type="button" class="gate-btn" data-enter="sound">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        Enter with sound
      </button>
      <button type="button" class="gate-quiet" data-enter="quiet">enter quietly</button>
    </div>
    <p class="gate-note">best with headphones · about five seconds</p>
  </div>
  <canvas class="splash" data-boot-canvas aria-hidden="true"></canvas>
  <div class="stage" aria-hidden="true">
    <div class="frame" data-boot-frame>
      <img src={img.src} alt="" data-boot-img decoding="async" />
    </div>
    <svg class="wave" viewBox="0 0 1000 60" preserveAspectRatio="none"><path d={wave}></path></svg>
    <p class="status" data-boot-status>thinking in products</p>
  </div>
  <p class="skip" aria-hidden="true">click anywhere to skip</p>
</div>

<!-- Runs immediately so the overlay is decided before first paint. The enter screen is
     handled here too (not in the bundled script), so it can never get stuck: one press always
     starts the show, and the page's own safety nets count from that press. -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.dataset.boot = 'skipped';
      return;
    }
    root.dataset.boot = 'gate';
    var gate = document.querySelector('[data-boot-gate]');
    var first = gate && gate.querySelector('[data-enter="sound"]');
    if (first) first.focus({ preventScroll: true });
    var go = function (withSound) {
      if (root.dataset.boot !== 'gate') return;
      if (withSound) {
        // the AudioContext has to be created inside the gesture to be allowed to play
        try {
          var AC = window.AudioContext || window.webkitAudioContext;
          if (AC) {
            window.__ac = window.__ac || new AC();
            window.__ac.resume();
          }
        } catch (e) {}
      }
      try {
        localStorage.setItem('sound', withSound ? 'on' : 'off');
      } catch (e) {}
      dispatchEvent(new Event('sound:change'));
      root.dataset.boot = 'running';
      removeEventListener('click', onClick, true);
      removeEventListener('keydown', onKey, true);
      dispatchEvent(new Event('boot:start'));
    };
    var onClick = function (e) {
      var b = e.target.closest && e.target.closest('[data-enter]');
      go(!(b && b.dataset.enter === 'quiet'));
    };
    var onKey = function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.key === 'Tab' || e.key === 'Shift') return;
      // Enter/Space on the focused "quietly" button means quietly; Escape too
      var quiet = e.key === 'Escape' || (document.activeElement && document.activeElement.dataset && document.activeElement.dataset.enter === 'quiet');
      e.preventDefault();
      go(!quiet);
    };
    addEventListener('click', onClick, true);
    addEventListener('keydown', onKey, true);
  })();
</script>

<style>
  .boot {
    display: none;
  }
  :global(html.js[data-boot='gate']) .boot,
  :global(html.js[data-boot='running']) .boot {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: var(--bg);
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.8s cubic-bezier(0.76, 0, 0.24, 1);
  }
  /* safety net: never block the page for more than 7s after the show starts */
  :global(html.js[data-boot='running']) .boot {
    animation: boot-away 0.01s 7s forwards;
  }
  :global(html.js[data-boot='running']) .boot.lift {
    clip-path: inset(0 0 100% 0);
  }
  @keyframes boot-away {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* ---- Enter screen ---- */
  .gate {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
  }
  :global(html[data-boot='gate']) .gate {
    display: flex;
  }
  :global(html[data-boot='gate']) .splash,
  :global(html[data-boot='gate']) .stage,
  :global(html[data-boot='gate']) .skip {
    visibility: hidden;
  }
  .gate-kicker,
  .gate-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gate-note {
    font-size: 0.62rem;
    opacity: 0.75;
  }
  .gate-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(2.6rem, 8vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--ink);
    animation: gate-in 0.9s var(--ease-out) both;
  }
  @keyframes gate-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  .gate-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 20px;
  }
  .gate-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 500 0.95rem/1 var(--font-body);
    cursor: pointer;
    transition: translate 0.25s var(--ease-out);
  }
  .gate-btn:hover {
    translate: 0 -2px;
  }
  .gate-quiet {
    padding: 8px 4px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 0.85rem/1 var(--font-body);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .gate-quiet:hover {
    color: var(--ink);
  }
  /* a tiny equaliser, the only thing moving on the enter screen */
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.4s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.75s;
  }
  .eq i:nth-child(4) {
    animation-delay: -0.2s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .splash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 16px;
    translate: 0 -2vh;
  }
  .frame {
    position: relative;
    width: min(60vw, 42vh, 340px);
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
  }
  /* the photo is only the pixel source; the moving characters are the final image */
  .frame img {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .wave {
    width: min(72vw, 360px);
    height: 40px;
    overflow: visible;
  }
  .wave path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    transition: stroke-dashoffset 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.4s;
  }
  .boot.go .wave path {
    stroke-dashoffset: 0;
  }
  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .status::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: caret 0.8s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .skip {
    position: absolute;
    bottom: 22px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--muted);
    opacity: 0.7;
  }
</style>

<script>
  import { buildGrid, charFor, RAMP } from '../scripts/ascii';
  import * as sfx from '../scripts/sound';

  const root = document.documentElement;
  const boot = document.querySelector<HTMLElement>('[data-boot-overlay]');

  const finish = () => {
    root.dataset.boot = 'done';
    dispatchEvent(new Event('boot:done'));
    boot?.remove();
  };

  if (!boot || (root.dataset.boot !== 'gate' && root.dataset.boot !== 'running')) {
    boot?.remove();
    dispatchEvent(new Event('boot:done'));
  } else {
    const canvas = boot.querySelector<HTMLCanvasElement>('[data-boot-canvas]')!;
    const frame = boot.querySelector<HTMLElement>('[data-boot-frame]')!;
    const img = boot.querySelector<HTMLImageElement>('[data-boot-img]')!;
    const status = boot.querySelector<HTMLElement>('[data-boot-status]')!;
    const css = getComputedStyle(root);
    const accent = css.getPropertyValue('--accent').trim() || '#9f8cff';
    const muted = css.getPropertyValue('--muted').trim() || '#999';
    const light = root.dataset.theme === 'light';
    let lifted = false;
    let raf = 0;
    let stopDrone: (fade?: number) => void = () => {};

    const lift = () => {
      if (lifted) return;
      lifted = true;
      cancelAnimationFrame(raf);
      stopDrone(0.3); // no sound of its own: the hit's tail carries the reveal
      boot.classList.add('lift');
      setTimeout(finish, 820);
    };

    // The show starts on the enter-screen press (handled by the inline script above)
    const started = new Promise<void>((res) => {
      if (root.dataset.boot === 'running') return res();
      addEventListener('boot:start', () => res(), { once: true });
    });
    started.then(() => {
      // from here a click or key skips; listen on the next tick so the starting press doesn't count
      setTimeout(() => {
        addEventListener('pointerdown', lift, { once: true });
        addEventListener('keydown', lift, { once: true });
      }, 0);
      setTimeout(lift, 7000); // hard cap even if the image is slow
    });

    // Timeline (ms): one continuous take, nothing holds until the portrait is complete
    const SHATTER_START = 850; // words stream across the screen until here...
    const SHATTER_SPREAD = 560; // ...then break apart as a ripple out from the centre...
    const LAND_FROM = 2700; // ...crawl in, and settle into the portrait in a wave
    const LAND_TO = 3700; //    between these two times
    const HOLD = 550; // the finished ASCII portrait, a beat, then the curtain lifts

    const WORD_BANK = [
      'roadmap', 'user research', 'PRD', 'north star', 'OKRs', 'A/B test', 'prioritize', 'ship it',
      'stakeholders', 'MVP', 'retention', 'discovery', 'jobs to be done', 'trade-offs', 'sprint',
      'metrics', 'launch', 'iterate', 'customer', 'why?', 'scope', 'backlog', 'insight', 'go-to-market',
    ];

    // Everything heavy is prepared while the enter screen is up, so the first frame is instant
    const run = async () => {
      if (lifted) return;
      // a page opened in a background tab may have no layout yet: prepare once it's on screen
      if (!frame.getBoundingClientRect().width) await started;
      if (lifted) return;
      const dpr = Math.min(2, devicePixelRatio || 1);
      const W = (canvas.width = innerWidth * dpr);
      const H = (canvas.height = innerHeight * dpr);
      const ctx = canvas.getContext('2d')!;
      const f = frame.getBoundingClientRect();
      const bitmap = await createImageBitmap(img).catch(() => null);
      const cols = innerWidth < 600 ? 36 : 46;
      const grid = buildGrid(bitmap ?? img, f.width, f.height, cols);
      const cw = (f.width / grid.cols) * dpr;
      const ch = (f.height / grid.rows) * dpr;
      const fontPx = Math.min(ch, cw * 1.7) * 0.92;
      const glyphs = RAMP.slice(1) + '/\\<>{}[]01';
      const mono = '"Geist Mono Variable", ui-monospace, monospace';

      /* ---- Glyph atlas: every character pre-rendered once, in both colours.
         Drawing sprites is far cheaper than fillText, and the cost is the same
         every frame, so there is no hitch when the words break apart. ---- */
      const rowPx = Math.max(13, Math.min(19, innerWidth / 70)) * dpr;
      const atlasPx = Math.max(rowPx, fontPx);
      const chars = [...new Set((WORD_BANK.join('') + glyphs + RAMP).split(''))].filter((c) => c !== ' ');
      const aCtx0 = document.createElement('canvas').getContext('2d')!;
      aCtx0.font = `${atlasPx}px ${mono}`;
      const cellW = Math.ceil(aCtx0.measureText('M').width) + 2;
      const cellH = Math.ceil(atlasPx * 1.3);
      const atlas = document.createElement('canvas');
      atlas.width = cellW * chars.length;
      atlas.height = cellH * 2;
      const a = atlas.getContext('2d')!;
      a.font = `${atlasPx}px ${mono}`;
      a.textBaseline = 'top';
      const idx = new Map<string, number>();
      chars.forEach((c, i) => {
        idx.set(c, i);
        a.fillStyle = muted;
        a.fillText(c, i * cellW + 1, 2);
        a.fillStyle = accent;
        a.fillText(c, i * cellW + 1, cellH + 2);
      });
      const sprite = (c: string, row: 0 | 1, x: number, y: number, scale: number, alpha: number) => {
        const i = idx.get(c);
        if (i === undefined || alpha <= 0.01) return;
        ctx.globalAlpha = alpha;
        ctx.drawImage(atlas, i * cellW, row * cellH, cellW, cellH, x, y, cellW * scale, cellH * scale);
      };
      const rowScale = rowPx / atlasPx;
      const endScale = fontPx / atlasPx;
      const charW = (cellW - 2) * rowScale;
      const rnd = () => glyphs[(Math.random() * glyphs.length) | 0];

      /* ---- The word stream ---- */
      const rowGap = rowPx * 2.1;
      const nRows = Math.ceil(H / rowGap) + 1;
      const rows = Array.from({ length: nRows }, (_, r) => {
        const words = [...WORD_BANK].sort(() => Math.random() - 0.5);
        const text = (words.join('  ·  ') + '  ·  ').repeat(3);
        return {
          y: r * rowGap + rowGap * 0.3,
          text,
          width: (text.length * charW) / 3,
          speed: (0.06 + Math.random() * 0.1) * dpr * (r % 2 ? 1 : -1), // px per ms
          phase: Math.random() * 2000,
          colour: (Math.random() < 0.3 ? 1 : 0) as 0 | 1,
        };
      });
      const rowX = (row: (typeof rows)[number], t: number) => {
        const off = ((row.phase + t) * row.speed) % row.width;
        return off > 0 ? off - row.width : off;
      };
      const rowAlpha = (c: 0 | 1) => (c ? 0.85 : 0.5);

      /* ---- Every visible letter at the shatter moment becomes a particle.
         All of this is worked out now, before the first frame. ---- */
      type L = {
        x0: number; y: number; vx: number; ch: string; colour: 0 | 1;
        breakAt: number; bvx: number; bvy: number; glyph: string;
        tx?: number; ty?: number; c?: string; a?: number; lag?: number; dur?: number; wob?: number;
      };
      const letters: L[] = [];
      const cxs = W / 2;
      const cys = (f.top + f.height / 2) * dpr;
      const maxD = Math.hypot(W, H) / 2;
      for (const row of rows) {
        const x0 = rowX(row, SHATTER_START);
        for (let k = 0; k < row.text.length; k++) {
          // allow for the distance the row travels before its letters break
          const x = x0 + k * charW;
          if (x < -W * 0.15 || x > W * 1.15) continue;
          const c = row.text[k];
          if (c === ' ' || c === '·') continue;
          const dist = Math.min(1, Math.hypot(x - cxs, row.y - cys) / maxD);
          const ang = Math.random() * Math.PI * 2;
          const sp = (0.015 + Math.random() * 0.04) * dpr;
          letters.push({
            x0: x, y: row.y, vx: row.speed, ch: c, colour: row.colour,
            breakAt: SHATTER_START + dist * SHATTER_SPREAD + Math.random() * 80,
            bvx: Math.cos(ang) * sp, bvy: Math.sin(ang) * sp, glyph: rnd(),
          });
        }
      }
      // hand each portrait cell a letter, so the image is literally built from the words
      const pool = [...letters].sort(() => Math.random() - 0.5);
      let j = 0;
      for (let i = 0; i < grid.lums.length; i++) {
        const c = charFor(grid.lums[i], light, grid.focus[i]);
        if (c === ' ') continue;
        let p = pool[j++];
        if (!p) {
          const src = pool[(Math.random() * pool.length) | 0];
          p = { ...src, glyph: rnd() };
          letters.push(p);
        }
        const w = light ? (1 - grid.lums[i]) * grid.focus[i] : grid.lums[i];
        p.tx = f.left * dpr + (i % grid.cols) * cw;
        p.ty = f.top * dpr + Math.floor(i / grid.cols) * ch;
        p.c = c;
        p.a = 0.25 + w * 0.75;
        p.lag = Math.random() * 160;
        p.wob = (Math.random() - 0.5) * 90 * dpr;
        // landings are staggered across a window, so the face builds up rather than popping in
        const landAt = LAND_FROM + Math.random() * (LAND_TO - LAND_FROM);
        p.dur = Math.max(900, landAt - (p.breakAt + p.lag));
      }

      await started;
      if (lifted) return;
      boot.classList.add('go');
      stopDrone = sfx.drone();
      const t0 = performance.now();
      const cue = { shatter: false, rise: false, hit: false };
      const easeIn = (x: number) => x * x * x;
      const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const TAU = 380; // how long a letter keeps its line's momentum after breaking (ms)
      let statusSet = false;

      const step = (now: number) => {
        if (lifted) return;
        const t = now - t0;
        ctx.clearRect(0, 0, W, H);

        // sound cues ride the same clock as the picture
        if (!cue.shatter && t >= SHATTER_START) {
          cue.shatter = true;
          stopDrone(0.6);
          sfx.whoosh({ dur: 1.3, from: 260, to: 3200, gain: 0.55 });
        }
        if (!cue.rise && t >= LAND_FROM - 150) {
          cue.rise = true;
          sfx.riser({ dur: (LAND_TO - LAND_FROM + 150) / 1000 });
        }
        if (t > LAND_FROM && t < LAND_TO && Math.random() < 0.7) sfx.tick((t - LAND_FROM) / (LAND_TO - LAND_FROM));
        if (!cue.hit && t >= LAND_TO) {
          cue.hit = true;
          sfx.hit();
        }

        if (t < SHATTER_START) {
          // the word stream, drawn letter by letter (same cost as everything after)
          const fade = Math.min(1, t / 250);
          for (const row of rows) {
            const x0 = rowX(row, t);
            const kStart = Math.max(0, Math.floor(-x0 / charW) - 1);
            const kEnd = Math.min(row.text.length, Math.ceil((W - x0) / charW) + 1);
            for (let k = kStart; k < kEnd; k++) {
              const c = row.text[k];
              if (c === ' ' || c === '·') continue;
              sprite(c, row.colour, x0 + k * charW, row.y, rowScale, rowAlpha(row.colour) * fade);
            }
          }
        } else {
          if (!statusSet) {
            statusSet = true;
            status.textContent = 'assembling kalash-jain.com';
          }
          for (const p of letters) {
            if (t < p.breakAt) {
              // still part of its word: keep flowing with the line
              sprite(p.ch, p.colour, p.x0 + p.vx * (t - SHATTER_START), p.y, rowScale, rowAlpha(p.colour));
              continue;
            }
            // broken off: the line's momentum decays smoothly into the crawl (no stop, no jump)
            const u = t - p.breakAt;
            const bx = p.x0 + p.vx * (p.breakAt - SHATTER_START);
            const mom = TAU * (1 - Math.exp(-u / TAU));
            const sx = bx + (p.vx + p.bvx) * mom;
            const sy = p.y + p.bvy * mom;
            if (u > 90 && Math.random() < 0.2) p.glyph = rnd(); // a shimmer, not static noise
            const flying = u > 90 ? p.glyph : p.ch; // keeps its own letter for a split second

            if (p.tx === undefined) {
              // not needed for the portrait: drift and fade where it broke
              const fadeOut = 1 - u / 520;
              if (fadeOut > 0) sprite(flying, p.colour, sx, sy, rowScale, rowAlpha(p.colour) * fadeOut);
              continue;
            }
            const k = Math.max(0, Math.min(1, (u - p.lag!) / p.dur!));
            const e = k < 0.5 ? easeIn(k * 2) / 2 : easeInOut(k);
            const dx = p.tx - sx;
            const dy = p.ty! - sy;
            const len = Math.hypot(dx, dy) || 1;
            const wob = Math.sin(k * Math.PI * 2) * p.wob! * (1 - k);
            const x = sx + dx * e + (-dy / len) * wob;
            const y = sy + dy * e + (dx / len) * wob;
            const scale = rowScale + (endScale - rowScale) * e; // word size → portrait size
            // settle gradually: its final character appears near the end, and colour and
            // brightness blend toward the portrait's, so nothing changes at the finish
            const glyph = k > 0.8 ? p.c! : flying;
            const alpha = rowAlpha(p.colour) + (p.a! - rowAlpha(p.colour)) * e;
            if (p.colour === 1) sprite(glyph, 1, x, y, scale, alpha);
            else {
              sprite(glyph, 0, x, y, scale, alpha * (1 - e));
              sprite(glyph, 1, x, y, scale, alpha * e);
            }
          }
          if (!lifted && t > LAND_TO - 250) status.textContent = 'ready';
        }
        ctx.globalAlpha = 1;
        // keep drawing until everything has landed; the last frame stays as the portrait
        if (t < LAND_TO + 80) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
      setTimeout(lift, LAND_TO + HOLD);
    };

    const start = () => document.fonts.ready.then(run);
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }
</script>
