---
import { hits } from '../data/site';
---

<section class="hits" aria-labelledby="hits-h">
  <h2 id="hits-h" class="mono">Greatest hits</h2>
  <ol class="grid" data-reveal="stagger">
    {
      hits.map((h, i) => (
        <li class="hit">
          <span class="track mono" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="eq" aria-hidden="true">
            <i />
            <i />
            <i />
            <i />
          </span>
          <p class="num">
            {h.prefix && <span class="pre">{h.prefix}</span>}
            <span data-count={h.value}>{h.value.toLocaleString('en-US')}</span>
            {h.suffix}
          </p>
          <p class="label">{h.label}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hits {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(72px, 9vw, 120px);
  }
  .hits > h2 {
    margin: 0 0 20px;
    font-weight: 400;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .hit {
    position: relative;
    padding: 22px 20px 6px 0;
  }
  .hit + .hit {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .track {
    font-size: 0.68rem;
  }
  .num {
    margin: 14px 0 8px;
    font-family: var(--font-display);
    font-weight: 650;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .pre {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.6em;
    letter-spacing: -0.02em;
  }
  .label {
    margin: 0;
    max-width: 28ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  /* Tiny equalizer that bounces next to each track number */
  .eq {
    position: absolute;
    top: 24px;
    right: 20px;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite alternate;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.4s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.8s;
  }
  .eq i:nth-child(4) {
    animation-delay: -0.2s;
  }
  @keyframes eq {
    0% {
      transform: scaleY(0.25);
    }
    100% {
      transform: scaleY(1);
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* extra .grid keeps these above `.hit + .hit` once Astro scopes them */
    .grid .hit:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .grid .hit:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid .hit + .hit {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq i {
      animation: none;
      transform: scaleY(0.6);
    }
  }
</style>
