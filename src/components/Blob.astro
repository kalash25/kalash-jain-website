<!--
  A small violet orb that peeks in from a different edge of the screen (left, right
  or bottom) when you reach a new section, watches your cursor, and says something
  when clicked. Decorative only: hidden from screen readers, absent with reduced motion.
-->
<div class="anchor" data-blob-anchor aria-hidden="true">
  <div class="blob" data-blob>
    <div class="body">
      <span class="eye l"><span class="pupil"></span></span>
      <span class="eye r"><span class="pupil"></span></span>
    </div>
  </div>
</div>

<style>
  /* The anchor is a point on a screen edge, rotated so "up" points into the page */
  .anchor {
    --rot: 0deg;
    position: fixed;
    left: 85%;
    top: 100%;
    z-index: 40;
    width: 0;
    height: 0;
    rotate: var(--rot);
    pointer-events: none;
  }
  .blob {
    --size: 70px;
    --px: 0px;
    --py: 0px;
    position: absolute;
    left: calc(var(--size) / -2);
    bottom: 0;
    width: var(--size);
    height: var(--size);
    translate: 0 120%;
    cursor: pointer;
    pointer-events: auto;
    transition: translate 0.75s cubic-bezier(0.34, 1.5, 0.64, 1);
  }
  .blob.peek {
    translate: 0 50%;
  }
  .blob.peek:hover {
    translate: 0 26%;
  }

  .body {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50% 50% 46% 54% / 56% 52% 48% 44%;
    background:
      radial-gradient(circle at 32% 26%, oklch(1 0 0 / 0.55), transparent 22%),
      conic-gradient(
        from 200deg at 60% 60%,
        oklch(0.62 0.22 285),
        oklch(0.5 0.24 295),
        oklch(0.72 0.15 270),
        oklch(0.62 0.22 285)
      );
    box-shadow:
      0 0 0 1px oklch(1 0 0 / 0.12) inset,
      0 0 36px -6px oklch(0.6 0.24 285 / 0.75);
    animation: breathe 6s ease-in-out infinite;
  }
  .blob.boop .body {
    animation:
      breathe 6s ease-in-out infinite,
      boop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes breathe {
    50% {
      border-radius: 54% 46% 52% 48% / 50% 56% 44% 50%;
    }
  }
  @keyframes boop {
    40% {
      scale: 1.12 0.88;
    }
    70% {
      scale: 0.95 1.06;
    }
  }

  /* Minimal pill eyes; they squint into a smile on hover */
  .eye {
    position: absolute;
    top: 34%;
    width: 11%;
    height: 22%;
    border-radius: 999px;
    background: oklch(0.99 0 0);
    overflow: hidden;
    box-shadow: 0 0 8px oklch(1 0 0 / 0.5);
    animation: blink 5.5s infinite;
    transition:
      height 0.25s var(--ease-out),
      border-radius 0.25s var(--ease-out);
  }
  .eye.l {
    left: 33%;
  }
  .eye.r {
    right: 33%;
  }
  .pupil {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 70%;
    height: 45%;
    margin: -22.5% 0 0 -35%;
    border-radius: 999px;
    background: oklch(0.2 0.05 285);
    translate: var(--px) var(--py);
    transition: translate 0.15s linear;
  }
  .blob:hover .eye {
    height: 10%;
    border-radius: 999px 999px 4px 4px;
  }
  @keyframes blink {
    0%,
    93%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.12);
    }
  }

  @media (max-width: 760px) {
    .blob {
      --size: 52px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .anchor {
      display: none;
    }
  }
</style>

<script>
  const anchor = document.querySelector<HTMLElement>('[data-blob-anchor]');
  const blob = document.querySelector<HTMLElement>('[data-blob]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (anchor && blob && !reduce) {
    const quips = [
      "Hi. I'm the unpaid intern.",
      "I've read the resume. Twice. Strong hire.",
      'Not a feature request. Just saying hi.',
      'Psst: the stickers up top are draggable.',
      "Kalash calls me scope creep. I'm staying.",
      'The email button copies itself. Very efficient.',
      'Fun fact: kalash-jain.com/anything has a 404 page.',
    ];
    let q = 0;
    let rot = 0;
    let hideTimer = 0;
    let hovering = false;
    let stay = false;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // Pick a fresh spot on the left, right or bottom edge (never the top: that's the nav)
    let lastEdge = '';
    function moveAnchor(edge?: 'left' | 'right' | 'bottom') {
      const edges = (['left', 'right', 'bottom'] as const).filter((e) => e !== lastEdge);
      const e = edge ?? edges[Math.floor(Math.random() * edges.length)];
      lastEdge = e;
      if (e === 'bottom') {
        // keep clear of the toast in the middle
        // settle in the far corner at Contact; elsewhere keep clear of the toast in the middle
        const x = stay ? 92 : Math.random() < 0.5 ? rand(10, 32) : rand(68, 90);
        anchor!.style.left = `${x}%`;
        anchor!.style.top = '100%';
        rot = 0;
      } else {
        anchor!.style.left = e === 'left' ? '0%' : '100%';
        anchor!.style.top = `${rand(28, 78)}%`;
        rot = e === 'left' ? 90 : -90;
      }
      anchor!.style.setProperty('--rot', `${rot}deg`);
    }

    function peek(ms: number, edge?: 'left' | 'right' | 'bottom') {
      clearTimeout(hideTimer);
      const show = () => {
        moveAnchor(edge);
        void blob!.offsetWidth; // place it before it slides in
        blob!.classList.add('peek');
        if (ms > 0)
          hideTimer = window.setTimeout(() => {
            if (!hovering) hide();
          }, ms);
      };
      // Already out? Duck first, then pop up somewhere new
      if (blob!.classList.contains('peek')) {
        blob!.classList.remove('peek');
        setTimeout(show, 650);
      } else show();
    }
    const hide = () => {
      stay = false;
      blob!.classList.remove('peek');
    };

    // Peek once per section as it arrives; settle in at Contact
    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting || seen.has(e.target.id)) continue;
          seen.add(e.target.id);
          if (e.target.id === 'contact') {
            stay = true;
            peek(0, 'bottom');
          } else peek(2600);
        }
      },
      { rootMargin: '0px 0px -55% 0px' },
    );
    ['experience', 'education', 'projects', 'about', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
    const top = document.getElementById('top');
    if (top) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) {
          hide();
          seen.delete('contact');
        }
      }).observe(top);
    }

    blob.addEventListener('pointerenter', () => {
      hovering = true;
      clearTimeout(hideTimer);
    });
    blob.addEventListener('pointerleave', () => {
      hovering = false;
      if (!stay) hideTimer = window.setTimeout(hide, 1400);
    });
    blob.addEventListener('click', () => {
      if (!blob.classList.contains('peek')) return;
      blob.classList.remove('boop');
      void blob.offsetWidth; // restart the squish
      blob.classList.add('boop');
      dispatchEvent(new CustomEvent('toast', { detail: quips[q++ % quips.length] }));
    });

    // Eyes follow the cursor (converted into the orb's rotated frame)
    let raf = 0;
    addEventListener(
      'pointermove',
      (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = blob.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const t = (rot * Math.PI) / 180;
          const lx = dx * Math.cos(t) + dy * Math.sin(t);
          const ly = -dx * Math.sin(t) + dy * Math.cos(t);
          const len = Math.hypot(lx, ly) || 1;
          const reach = r.width * 0.03;
          blob.style.setProperty('--px', `${(lx / len) * reach}px`);
          blob.style.setProperty('--py', `${(ly / len) * reach * 1.4}px`);
        });
      },
      { passive: true },
    );
  }
</script>
