---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import photo from '../assets/portrait-ucla.jpg';
import { skills } from '../data/site';

// Two rows drifting in opposite directions; each list is doubled so the loop never shows a gap
const rows = [
  { label: 'Product & AI', items: [...skills.product, ...skills.product], kind: 'product' },
  { label: 'Technical', items: [...skills.technical, ...skills.technical], kind: 'tech' },
];
---

<section id="about" class="section" aria-labelledby="about-h">
  <SectionHead
    n="04"
    label="About"
    wide
    id="about-h"
    title="Not just building things right, but building <em>the right things.</em>"
  />

  <div class="grid">
    <figure class="photo" data-reveal>
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 92vw, 440px"
        alt="Kalash Jain at UCLA Anderson"
        loading="lazy"
      />
    </figure>

    <div class="text" data-reveal="stagger">
      <p class="big">
        I spent my first years out of college as a software engineer at JPMorgan Chase, learning to
        build for scale, explain technical trade-offs to people who don't write code, and ship under
        regulatory constraints.
      </p>
      <p>
        Somewhere along the way I realised the part I loved most wasn't the code. It was figuring
        out what was worth building, and getting a room full of teams to agree on it. That's what
        brought me to UCLA Anderson and into product management.
      </p>
      <p>
        Outside work I'm a published poet and a musician, which is a big part of why I'm drawn to
        product roles in tech, media and creative tools: places where technical depth and taste
        both matter.
      </p>
      <p>
        Always happy to talk with fellow builders, writers, or anyone figuring out their own pivot.
      </p>
    </div>
  </div>

  <!-- Toolkit ticker: two rows in opposite directions; static for reduced motion -->
  <div class="toolkit">
    <p class="mono kit-label">Toolkit</p>
    {
      rows.map((row) => (
        <div class:list={['marquee', row.kind]} aria-label={row.label}>
          <div class="track">
            {[0, 1].map((copy) => (
              <ul aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.items.map((item) => (
                  <li>
                    {item}
                    <span class="sep" aria-hidden="true">
                      ✦
                    </span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .section {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 140px) var(--gutter) clamp(60px, 7vw, 100px);
    border-top: 1px solid var(--line);
    overflow-x: clip;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  /* Full-colour photo; a soft violet edge ties the warm brick into the palette */
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 30%;
    transition: transform 1.2s var(--ease-out);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--accent) 30%, transparent),
      transparent 40%
    );
    pointer-events: none;
  }
  .photo:hover :global(img) {
    transform: scale(1.03);
  }

  .text p {
    max-width: 60ch;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .text .big {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 450;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .toolkit {
    margin-top: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--line);
  }
  .kit-label {
    margin: 18px 0 4px;
    color: var(--accent);
  }
  .marquee {
    padding: 12px 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee.tech {
    padding-bottom: 4px;
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 46s linear infinite;
  }
  .tech .track {
    animation-duration: 56s;
    animation-direction: reverse;
  }
  .track ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .track li {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
  }
  .tech .track li {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sep {
    margin: 0 28px;
    color: var(--accent);
    font-size: 0.7em;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
    .track ul + ul {
      display: none;
    }
    .track ul {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .marquee {
      mask-image: none;
    }
  }
</style>
