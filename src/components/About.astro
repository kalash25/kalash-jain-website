---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import photo from '../assets/portrait-ucla.jpg';
import { skills } from '../data/site';

const allSkills = [...skills.product, ...skills.technical];
---

<section id="about" class="section" aria-labelledby="about-h">
  <SectionHead
    n="04"
    label="About"
    wide
    id="about-h"
    title="Not just building things right, but building <em>the right things.</em>"
  />

  <div class="grid">
    <figure class="photo" data-reveal>
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 92vw, 440px"
        alt="Kalash Jain at UCLA Anderson"
        loading="lazy"
      />
    </figure>

    <div class="text" data-reveal="stagger">
      <p class="big">
        I spent my first years out of college as a software engineer at JPMorgan Chase, learning to
        build for scale, explain technical trade-offs to people who don't write code, and ship under
        regulatory constraints.
      </p>
      <p>
        Somewhere along the way I realised the part I loved most wasn't the code. It was figuring
        out what was worth building, and getting a room full of teams to agree on it. That's what
        brought me to UCLA Anderson and into product management.
      </p>
      <p>
        Outside work I'm a published poet and a musician, which is a big part of why I'm drawn to
        product roles in tech, media and creative tools: places where technical depth and taste
        both matter.
      </p>
      <p>
        Always happy to talk with fellow builders, writers, or anyone figuring out their own pivot.
      </p>
    </div>
  </div>

  <!-- Toolkit: one sentence that cycles through skills, plus a scannable list.
       Hover a skill in the list and the sentence jumps to it. -->
  <div class="toolkit" data-toolkit>
    <p class="kit-label">Toolkit</p>
    <p class="fluent">
      <span class="lead">Fluent in</span>{' '}
      <span class="skill" data-skill>{allSkills[0]}</span><span class="caret" aria-hidden="true"></span>
    </p>
    <div class="lists">
      <div>
        <p class="list-h">Product &amp; AI</p>
        <ul>{skills.product.map((k) => <li data-skill-item={k}>{k}</li>)}</ul>
      </div>
      <div>
        <p class="list-h">Technical</p>
        <ul>{skills.technical.map((k) => <li data-skill-item={k}>{k}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 140px) var(--gutter) clamp(60px, 7vw, 100px);
    border-top: 1px solid var(--line);
    overflow-x: clip;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  /* Full-colour photo; a soft violet edge ties the warm brick into the palette */
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 30%;
    transition: transform 1.2s var(--ease-out);
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--accent) 30%, transparent),
      transparent 40%
    );
    pointer-events: none;
  }
  .photo:hover :global(img) {
    transform: scale(1.03);
  }

  .text p {
    max-width: 60ch;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .text .big {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 450;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .toolkit {
    margin-top: clamp(64px, 8vw, 110px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .kit-label,
  .list-h {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .fluent {
    margin: 14px 0 30px;
    font-family: var(--font-display);
    font-weight: 600;
    font-variation-settings: 'opsz' 72;
    font-size: clamp(2rem, 5.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .lead {
    color: var(--muted);
    font-weight: 500;
  }
  .skill {
    color: var(--accent);
  }
  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.8em;
    margin-left: 0.08em;
    vertical-align: -0.04em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 48px;
  }
  .lists ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .lists li {
    color: var(--muted);
    cursor: default;
    transition: color 0.2s var(--ease-out);
  }
  .lists li:not(:last-child)::after {
    content: '/';
    margin: 0 10px;
    color: var(--line);
  }
  .lists li.on,
  .lists li:hover {
    color: var(--ink);
  }
  .lists li.on {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .lists {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-toolkit]');
  const out = wrap?.querySelector<HTMLElement>('[data-skill]');
  const items = [...(wrap?.querySelectorAll<HTMLElement>('[data-skill-item]') ?? [])];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && out && items.length) {
    const glyphs = '.:-=+*#%@/<>{}';
    let idx = 0;
    let scramble = 0;
    let cycle = 0;
    let hovering = false;

    // Swap the word with a quick character scramble (same motif as the ASCII intro)
    const show = (i: number) => {
      idx = i;
      const target = items[i].dataset.skillItem!;
      items.forEach((el, j) => el.classList.toggle('on', j === i));
      clearInterval(scramble);
      if (reduce) {
        out.textContent = target;
        return;
      }
      let f = 0;
      const frames = 10;
      scramble = window.setInterval(() => {
        f++;
        out.textContent = [...target]
          .map((ch, k) => (ch === ' ' || f > (k / target.length) * frames + 2 ? ch : glyphs[(Math.random() * glyphs.length) | 0]))
          .join('');
        if (f > frames + 2) {
          clearInterval(scramble);
          out.textContent = target;
        }
      }, 38);
    };
    const start = () => {
      clearInterval(cycle);
      if (reduce) return;
      cycle = window.setInterval(() => !hovering && show((idx + 1) % items.length), 1900);
    };

    items.forEach((el, i) =>
      el.addEventListener('pointerenter', () => {
        hovering = true;
        show(i);
      }),
    );
    wrap.querySelector('.lists')?.addEventListener('pointerleave', () => (hovering = false));

    // only cycle while it's on screen
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(cycle))).observe(wrap);
    show(0);
  }
</script>
