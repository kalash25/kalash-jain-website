---
// "The story so far": a dotted world map with the route from the US to India and back to LA.
// drive="scroll": a sticky stage that the page scroll flies through (Skim mode).
// drive="manual": back/next buttons, arrow keys and drag (on the Roam board).
// drive="auto" (default): follows the page mode.
import SectionHead from './SectionHead.astro';
import { MAP, project } from '../data/worldmap';
import { story, storyNext } from '../data/site';

interface Props {
  drive?: 'auto' | 'scroll' | 'manual';
  n?: string;
  head?: boolean;
}
const { drive = 'auto', n = '01', head = true } = Astro.props;

const pts = story.map((s) => project(...s.at));

// Each leg is a gentle arc, bowed upward (long flights arc higher)
const segs = pts.slice(1).map((b, i) => {
  const a = pts[i];
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const dist = Math.hypot(dx, dy) || 1;
  let nx = dy / dist;
  let ny = -dx / dist;
  if (ny > 0 || (Math.abs(ny) < 0.2 && nx > 0)) {
    nx = -nx;
    ny = -ny;
  }
  const lift = Math.min(22, dist * 0.32);
  const cx = (a.x + b.x) / 2 + nx * lift;
  const cy = (a.y + b.y) / 2 + ny * lift;
  return `M${a.x.toFixed(2)} ${a.y.toFixed(2)}Q${cx.toFixed(2)} ${cy.toFixed(2)} ${b.x.toFixed(2)} ${b.y.toFixed(2)}`;
});

// How far the camera zooms in at each stop: further when the neighbours are close
const zooms = pts.map((p, i) => {
  const near = [pts[i - 1], pts[i + 1]].filter(Boolean).map((q) => Math.hypot(q.x - p.x, q.y - p.y));
  const d = Math.min(...near);
  return Math.max(1.05, Math.min(3.4, 46 / Math.max(6, d * 2.4))).toFixed(2);
});

const chapters = [...story, { ...storyNext, place: '', at: story[story.length - 1].at }];
---

<section id="story" class="story" aria-labelledby="story-h" data-story data-drive={drive} data-mode={drive === 'manual' ? 'manual' : 'scroll'}>
  {head && (
    <div class="head-wrap">
      <SectionHead n={n} label="Story" id="story-h" title="The story <em>so far.</em>" />
      <p class="intro" data-reveal>
        Born in the US, raised in India, and back in the States for round two.{' '}
        <span class="how-scroll">Scroll to fly the route.</span>
        <span class="how-manual">Press next, or drag across the map, to fly the route.</span>
      </p>
    </div>
  )}

  <div class="track">
    <div class="stage">
      <svg
        class="map"
        data-story-map
        viewBox={`0 0 ${MAP.cols} ${MAP.rows}`}
        data-cols={MAP.cols}
        data-rows={MAP.rows}
        data-zooms={zooms.join(',')}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <path class="land" d={MAP.dots}></path>
        <g class="route-base">{segs.map((d) => <path d={d} />)}</g>
        <g class="route">{segs.map((d) => <path d={d} data-seg />)}</g>
        {
          pts.map((p, i) => (
            <g class:list={['stop', { final: i === pts.length - 1 }]} data-stop-mark data-x={p.x.toFixed(2)} data-y={p.y.toFixed(2)}>
              <circle class="ring" cx={p.x} cy={p.y} r="1.1" />
              <circle class="pin" cx={p.x} cy={p.y} r="0.42" />
            </g>
          ))
        }
        <g class="plane" data-plane>
          <path d="M1.3 0 L-0.9 -0.85 L-0.45 0 L-0.9 0.85 Z" />
        </g>
      </svg>

      <div class="panel">
        <div class="rail" role="group" aria-label="Chapters">
          {
            chapters.map((c, i) => (
              <button type="button" class="dot" data-goto={i} aria-label={`Chapter ${i + 1}: ${c.title}`}>
                <span />
              </button>
            ))
          }
          <span class="mono count" data-count>01 / {String(chapters.length).padStart(2, '0')}</span>
        </div>
        <ol class="cards">
          {
            chapters.map((c, i) => (
              <li class:list={['card', { next: i === chapters.length - 1 }]} data-card>
                <p class="year">{c.year}</p>
                <h3>{c.title}</h3>
                {c.place && <p class="mono place">{c.place}</p>}
                <p class="line">{c.line}</p>
              </li>
            ))
          }
        </ol>
        <div class="ctrl">
          <button type="button" class="btn btn-small" data-prev>← Back</button>
          <button type="button" class="btn btn-small btn-primary" data-next>Next stop →</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 140px) var(--gutter) 0;
    border-top: 1px solid var(--line);
  }
  .intro {
    max-width: 56ch;
    margin: -24px 0 24px;
    color: var(--muted);
    font-size: 1.05rem;
  }

  /* ---- Default (no JS, reduced motion): the whole route, every chapter listed ---- */
  .stage {
    display: grid;
    gap: 28px;
    padding-bottom: clamp(60px, 8vw, 110px);
  }
  .map {
    width: 100%;
    height: auto;
    aspect-ratio: 180 / 45;
    overflow: visible;
  }
  .land {
    fill: none;
    stroke: var(--muted);
    stroke-width: 0.42;
    stroke-linecap: round;
    opacity: 0.35;
  }
  /* route lines keep the same on-screen weight however far the camera zooms in
     (--u is map units per screen pixel, set by the camera) */
  .route-base path {
    fill: none;
    stroke: var(--muted);
    stroke-width: calc(var(--u, 0.14) * 1.2);
    stroke-dasharray: calc(var(--u, 0.14) * 3) calc(var(--u, 0.14) * 5);
    opacity: 0.6;
  }
  .route path {
    fill: none;
    stroke: var(--accent);
    stroke-width: calc(var(--u, 0.14) * 2.25);
    stroke-linecap: round;
  }
  .pin {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 0.22;
    transition: fill 0.4s var(--ease-out), stroke 0.4s var(--ease-out);
  }
  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.12;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .stop.reached .pin {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .plane path {
    fill: var(--ink);
  }
  .rail,
  .ctrl {
    display: none;
  }
  .how-manual,
  [data-mode='manual'] .how-scroll {
    display: none;
  }
  [data-mode='manual'] .how-manual {
    display: inline;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .year {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .card h3 {
    margin: 2px 0 4px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .place {
    margin: 0 0 8px;
    font-size: 0.66rem;
  }
  .line {
    margin: 0;
    color: var(--muted);
  }
  .card.next .year::after {
    content: '';
    display: inline-block;
    width: 0.45em;
    height: 0.9em;
    margin-left: 6px;
    vertical-align: -0.08em;
    background: var(--accent);
    animation: story-caret 0.9s steps(1) infinite;
  }
  @keyframes story-caret {
    50% {
      opacity: 0;
    }
  }

  /* ---- With JS and motion: a stage you fly through ---- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stage {
      position: relative;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 0;
      height: min(86svh, 820px);
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: color-mix(in oklch, var(--surface) 60%, transparent);
    }
    /* scroll mode: the track is tall and the stage sticks while you scroll through it */
    :global(html.js) [data-mode='scroll'] .track {
      height: calc(var(--units, 7) * 62svh + 86svh);
      margin-bottom: clamp(60px, 8vw, 110px);
    }
    :global(html.js) [data-mode='scroll'] .stage {
      position: sticky;
      top: max(72px, calc((100svh - min(86svh, 820px)) / 2 + 30px));
    }
    :global(html.js) [data-mode='manual'] .stage {
      margin-bottom: clamp(60px, 8vw, 110px);
    }
    :global(html.js) .map {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
    }
    :global(html.js) .route-base path {
      opacity: 0.35;
    }
    :global(html.js) .stop:not(.reached) .pin {
      opacity: 0.7;
    }
    :global(html.js) .story.ended .stop.final .ring {
      animation: story-ping 1.8s var(--ease-out) infinite;
    }

    :global(html.js) .panel {
      position: absolute;
      left: clamp(16px, 3vw, 32px);
      bottom: clamp(16px, 3vw, 32px);
      width: min(380px, calc(100% - 32px));
      padding: 20px 22px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: color-mix(in oklch, var(--bg) 82%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    :global(html.js) .rail {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
    }
    :global(html.js) .count {
      margin-left: auto;
      font-size: 0.64rem;
    }
    .dot {
      display: grid;
      place-items: center;
      width: 18px;
      height: 18px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .dot span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--line);
      transition:
        background-color 0.3s var(--ease-out),
        scale 0.3s var(--ease-out);
    }
    .dot.seen span {
      background: color-mix(in oklch, var(--accent) 55%, var(--line));
    }
    .dot.on span {
      background: var(--accent);
      scale: 1.6;
    }
    .dot:hover span {
      scale: 1.6;
    }
    :global(html.js) .cards {
      display: grid;
      grid-template-columns: 1fr;
    }
    :global(html.js) .card {
      grid-area: 1 / 1;
      opacity: 0;
      translate: 0 10px;
      visibility: hidden;
      transition:
        opacity 0.45s var(--ease-out),
        translate 0.45s var(--ease-out),
        visibility 0s 0.45s;
    }
    :global(html.js) .card.on {
      opacity: 1;
      translate: 0 0;
      visibility: visible;
      transition:
        opacity 0.45s var(--ease-out) 0.1s,
        translate 0.45s var(--ease-out) 0.1s,
        visibility 0s;
    }
    /* nothing to go back to on the first chapter, and no next stop after "to be continued" */
    .story.first [data-prev],
    .story.ended [data-next] {
      display: none;
    }
    :global(html.js) [data-mode='manual'] .ctrl {
      display: flex;
      gap: 8px;
      margin-top: 16px;
    }
  }
  @keyframes story-ping {
    from {
      opacity: 0.9;
      scale: 0.6;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }

  @media (max-width: 640px) {
    :global(html.js) .stage {
      height: min(80svh, 680px);
    }
    /* phones: the card sits under the map instead of over it */
    :global(html.js) .panel {
      position: static;
      width: auto;
      margin: 0 10px 10px;
      padding: 16px;
    }
    .year {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  import { mountStory } from '../scripts/story';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((el) => {
    if (reduce) return; // the static map and the full list of chapters already tell the story
    const story = mountStory(el);
    const N = story.count;
    el.style.setProperty('--units', String(N));
    const unit = (i: number) => (i + 0.2) / N; // a chapter's "parked" position
    let p = 0; // current progress, shared by both ways of driving

    // drive="auto" follows the page mode: scroll in Skim mode, buttons and drag on the board
    const auto = el.dataset.drive === 'auto';
    const setDrive = () => {
      if (auto) el.dataset.mode = root.classList.contains('roam') ? 'manual' : 'scroll';
      else el.dataset.mode = el.dataset.drive;
    };
    setDrive();
    const scrolling = () => el.dataset.mode === 'scroll';

    /* ---- scroll ---- */
    const track = el.querySelector<HTMLElement>('.track')!;
    const stageEl = el.querySelector<HTMLElement>('.stage')!;
    const travel = () => track.getBoundingClientRect().height - stageEl.getBoundingClientRect().height;
    const progress = () => {
      const r = track.getBoundingClientRect();
      const st = stageEl.getBoundingClientRect();
      return Math.min(1, Math.max(0, (st.top - r.top) / Math.max(1, travel())));
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking || !scrolling()) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        p = progress();
        story.set(p);
      });
    };
    let live = false;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !live) addEventListener('scroll', onScroll, { passive: true });
      if (!e.isIntersecting && live) removeEventListener('scroll', onScroll);
      live = e.isIntersecting;
      if (live) onScroll();
    }).observe(track);

    /* ---- manual: buttons, arrow keys and dragging across the map ---- */
    let anim = 0;
    const go = (to: number) => {
      cancelAnimationFrame(anim);
      const from = p;
      const t0 = performance.now();
      const dur = Math.min(2200, 500 + Math.abs(to - from) * N * 1400);
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        p = from + (to - from) * k;
        story.set(p);
        if (k < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    };
    const current = () => Math.max(0, Math.min(N - 1, Math.round(p * N - 0.2)));
    const jump = (i: number) => {
      if (scrolling()) {
        // in the scroll, a chapter is a position on the page
        const r = track.getBoundingClientRect();
        scrollTo({ top: scrollY + r.top + unit(i) * travel() + 1, behavior: 'smooth' });
      } else go(unit(i));
    };
    el.querySelector('[data-next]')?.addEventListener('click', () => jump(Math.min(N - 1, current() + 1)));
    el.querySelector('[data-prev]')?.addEventListener('click', () => jump(Math.max(0, current() - 1)));
    el.querySelectorAll<HTMLElement>('[data-goto]').forEach((d) => d.addEventListener('click', () => jump(Number(d.dataset.goto))));
    el.addEventListener('keydown', (e) => {
      if (scrolling()) return;
      if (e.key === 'ArrowRight') jump(Math.min(N - 1, current() + 1));
      if (e.key === 'ArrowLeft') jump(Math.max(0, current() - 1));
    });
    const map = el.querySelector<SVGSVGElement>('[data-story-map]')!;
    let dragX: number | null = null;
    map.addEventListener('pointerdown', (e) => {
      if (scrolling()) return;
      dragX = e.clientX;
      cancelAnimationFrame(anim);
      try {
        map.setPointerCapture(e.pointerId);
      } catch {}
    });
    map.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      p = Math.min(1, Math.max(0, p + (e.clientX - dragX) / (map.getBoundingClientRect().width * 1.6)));
      dragX = e.clientX;
      story.set(p);
    });
    map.addEventListener('pointerup', () => {
      if (dragX === null) return;
      dragX = null;
      go(unit(current()));
    });

    addEventListener('mode:change', () => {
      setDrive();
      // land on a chapter rather than mid-flight
      p = unit(current());
      story.set(p);
      dispatchEvent(new Event('resize'));
    });
  });
</script>
