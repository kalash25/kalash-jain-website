---
// Bare layout for the redesign prototypes in /lab. Each page brings its own fonts and styles.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Never leave content hidden if a script fails
      setTimeout(function () {
        document.documentElement.classList.add('ready');
      }, 3500);
    </script>
  </head>
  <body>
    <slot />
    <p class="lab-toast" role="status" aria-live="polite" data-toast></p>
    <script>
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      let t = 0;
      addEventListener('toast', (e) => {
        if (!toast) return;
        toast.textContent = (e as CustomEvent<string>).detail;
        toast.classList.add('show');
        clearTimeout(t);
        t = window.setTimeout(() => toast.classList.remove('show'), 2600);
      });
    </script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }
      .lab-toast {
        position: fixed;
        left: 50%;
        bottom: 26px;
        z-index: 100;
        margin: 0;
        padding: 11px 18px;
        border-radius: 10px;
        background: #f4f1ea;
        color: #111;
        font: 500 0.8rem/1.3 ui-monospace, Menlo, monospace;
        translate: -50% 16px;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.3s,
          translate 0.4s;
        max-width: calc(100vw - 32px);
      }
      .lab-toast.show {
        opacity: 1;
        translate: -50% 0;
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
