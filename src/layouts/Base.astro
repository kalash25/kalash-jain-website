---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import bodyFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kalash Jain · Product thinker with an engineer's toolkit",
  description = "UCLA Anderson MBA '28 and former JPMorgan Chase software engineer, recruiting for Summer 2027 product management internships in tech, media and creative tools.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Share image for LinkedIn, Slack, iMessage, X etc. (regenerate with `npm run og`)
const shareImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0d0c12" />

    <!-- Share previews (LinkedIn, Slack, iMessage, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kalash Jain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kalash Jain, UCLA Anderson MBA '28 and ex-JPMorgan Chase: product thinker with an engineer's toolkit." />
    <meta name="author" content="Kalash Jain" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <!-- Apply saved theme before first paint so there is no flash -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Safety net: if the intro script never runs (failed load, blocked, stale page
        // across a deploy), reveal the content anyway instead of leaving it hidden.
        setTimeout(function () {
          root.classList.add('intro-done');
        }, 3500);
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <p class="toast" role="status" aria-live="polite" data-toast></p>

    <script>
      /* Site-wide toast: window.dispatchEvent(new CustomEvent('toast', { detail: 'Hi' })) */
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      let timer = 0;
      addEventListener('toast', (e) => {
        if (!toast) return;
        toast.textContent = (e as CustomEvent<string>).detail;
        toast.classList.add('show');
        clearTimeout(timer);
        timer = window.setTimeout(() => toast.classList.remove('show'), 2400);
      });

      /* Tab title nudge when someone switches away */
      const title = document.title;
      document.addEventListener('visibilitychange', () => {
        document.title = document.hidden ? '← Your next PM intern is in this tab' : title;
      });

      /* A note for anyone who opens DevTools */
      console.log(
        '%cHey, you opened the console.%c\nThat kind of curiosity is exactly what I look for in a team. Say hi: kalashjain@g.ucla.edu',
        'font: 600 14px system-ui; color: #9f8cff',
        'font: 12px system-ui',
      );
    </script>
  </body>
</html>
